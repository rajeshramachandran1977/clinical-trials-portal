<style>
    @page Section1 {
        size:29.7cm 21cm;
        margin:1cm 1cm 1cm 1cm;
        mso-page-orientation: landscape;
        mso-header-margin: .5in;
        mso-footer-margin: .5in;
        mso-paper-source: 0;
        mso-footer:url("document_files/footer.htm") f1;
    }

    div.Section1 {
        page: Section1;
    }

    @page TPSForm {
        margin:1in 1in 1in 1in;
        mso-footer:url("document_files/footer.htm") f1;
    }

    div.TPSForm {
        page: TPSForm;
    }

    pre {
        white-space: pre-wrap;
        white-space: -moz-pre-wrap;
        white-space: -pre-wrap;
        white-space: -o-pre-wrap;
        word-wrap: break-word;
    }

    body {
        font-size: 10pt;
        font-family: Arial;
        font-weight: 100;
    }

    p.MsoFooter, li.MsoFooter, div.MsoFooter{
        text-align: center;
        font-size: 8pt;
        font-family: Arial;
    }
    
    table.with-border, table.with-border td {
        border-collapse: collapse;
        border: 1px solid #000;
    }
    
    table.with-border td {
        padding: 0 5px;
    }

    #tps-header{
        text-align: center;
        text-decoration: underline;
        font-size: 14pt;
    }

    p.tps-field {
        font-size: 11pt;
    }

    .underlined, .tps-explanation {
        text-decoration: underline;
    }

    .tps-explanation {
        color: #0000FF;
    }

    .tps-mark {
        margin-top: 0px;
        font-size: 9pt;
    }
</style>

<script>
function executeCmd(cmd)
{
if("Print" == cmd){
	 document.getElementById('print').style.visibility='visible';
	document.getElementById('download').style.visibility='visible';
	document.getElementById('print').style.visibility='hidden';
	document.getElementById('download').style.visibility='hidden';
 
 	document.execCommand(cmd);
	 
	 
	document.getElementById('print').style.visibility='visible';
	document.getElementById('download').style.visibility='visible';
	document.getElementById('print').style.display='block';
	document.getElementById('download').style.display='block';
	}
else{

var path =document.URL+'&documentformat=worddocument'
window.open(path,'Notificationletter','width=100,height=100,resizable=yes,toolbar=no,location=no,directories=no,status=no,menubar=no,scrollbars=yes');

         
//document.execCommand(cmd);
}
}


function hideButton(){	
try{
		var openerLocation;	
		if(opener != null && opener.document.location != null){
	    	openerLocation = opener.document.location.href;
		}else if(window.document != null){
			openerLocation = window.document.location.href;
		}
		 
	    if(openerLocation !=null){    	 
			document.getElementById('print').style.visibility='hidden';
			document.getElementById('download').style.visibility='hidden';
	    }
	    }catch(e){}
	}
</script>
</head><body>
