@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
<link rel="stylesheet" href="~/css/navigateStyles.css" />

@(Html.Kendo().Dialog().Visible(false)
   .Name("ui_dlgYesNoDelete")
   .Title("Delete")
   .Content("<p>Current submission and all entered data will be completely removed. Are you sure you want to delete the submission?<p>")
   .HtmlAttributes(new { @class = "ui_label" })
   .Width(400)
   .Modal(true)
   .Actions(actions =>
   {
    actions.Add().Text("Yes").Primary(true)
    .Action("onOK");
    actions.Add().Text("No");
})
   .Events(ev => ev.Close("onCloseDelete"))
)
<script>
    function onCloseDelete() { 
        $("#ui_btnCancel").fadeIn();
    }

    function onOpen() {
        $("#ui_btnCancel").fadeOut();
    }

    function deleteNewStudyDialog() {        
        $('#ui_dlgYesNoDelete').data("kendoDialog").open();
        return true;
    }

    $(document).ready(function () {
        $('#ui_btnCancel').on('click', function (e) {
            e.preventDefault();
            validate.resetForm();
        });
    });
    function onOK(e) {
        onCancelDelete();
    }

</script>
