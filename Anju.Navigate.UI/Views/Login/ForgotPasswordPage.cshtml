@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Site.cshtml";
}

<link rel="stylesheet" href="~/css/login.css" />

<div id="changePasswordDiv"></div>
<div id="notValid">
    <table align="center">
        <tr>
        <tr>
            <td></td>
            <td align="center"><p id="infoMsg" class="infoMsg">Your Reset password link has Expired.Please <a id="forgotRedirect" href="#"><u>Click Here</u></a> to be redirected back to the Forget Password page to recreate a new link</p></td>
        </tr>
    </table>
</div>
<script>
    $(document).ready(function () {
        $.urlParam = function (name) {
            var results = new RegExp('[\?&]' + name + '=([^&#]*)').exec(window.location.href);
            if (results == null) {
                return null;
            }
            else {
                return decodeURI(results[1]) || 0;
            }
        }
        var str = $.urlParam('param');
        $('#changePasswordDiv').show();
        $('#notValid').hide();

        $('#forgotRedirect').click(function () {
            location.href = '/Login/ForgetPassword';
        });

        $.ajax({
            type: "POST",
            url: "/Login/CheckValidUrl",
            data: { url: str },
            success: function (results) {
                if (results.data == "true") {
                    $('#changePasswordDiv').show();
                    $('#infoMsg').hide();
                }
                else {
                    $('#changePasswordDiv').hide();
                    $('#notValid').show();

                }
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
            }
        });
        $.ajax({
            type: "GET",
            url: "/Login/ChangePasswordPartial",
            data: {},
            success: function (results) {
                $("#changePasswordDiv").empty().append(results);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
            }
        });
    })
</script>

