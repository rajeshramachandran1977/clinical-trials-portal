  <div>     
        <div id="resetPasswordDiv">
        </div>
    </div>

<script>
    $(document).ready(function () {
        $.ajax({
            type: "GET",
            url: "/Login/ChangePasswordPartial",
            data: {},
            success: function (results) {
                $("#resetPasswordDiv").empty().append(results);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
            }
        });
    })
</script>

