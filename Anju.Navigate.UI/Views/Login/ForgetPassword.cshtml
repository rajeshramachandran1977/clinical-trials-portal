@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
@{
    ViewData["Title"] = @Messages.FORGOTPASSWORDPAGETITLE;
}
<link rel="stylesheet" href="~/css/login.css" />

<form id="ui_frmForgotPassword" class="frmcontainer col-4 shadow-lg">
    <h3>@Messages.FORGOTPASSWORDHEADER</h3>
    <span id="popupNotification"></span>
    <label class="ui_label">@Messages.FORGOTPASSWORDINFO</label>
    <ul id="fieldlist">
        <li>
            <label for="username" class="login_label">User Name</label>
            <div id="fieldusername">
                @(Html.Kendo().TextBox()
                  .Name("ui_txtUsername")
                  .HtmlAttributes(new { id = "userName", @class = "wid_100" })
                )
            </div>
        </li>
        <li>
            <label for="password" class="login_label">Email Address</label>
            <div id="fieldemailaddr">
                @(Html.Kendo().TextBox()
                  .Name("ui_txtEmail")
                  .HtmlAttributes(new { id = "email", @class = "wid_100" })
                )
            </div>
        </li>
    </ul>
    <input class="btn btn-primary" id="cancel" type="button" onclick="showDialog();" value="Cancel" />
    <input class="btn btn-primary" id="Submit" type="submit" value="Reset Password" />
    <div id="YesNoDialog">
        <partial name="~/Views/Common/CancelDialogBox.cshtml" />
    </div>
</form>
<script>

    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var systemerror = '@Messages.SOMETHNGWENTWRONG';
    var invalidemail = '@Messages.INVALIDEMAILADDRESS';
    var usernamerequired = '@Messages.USERNAMEREQUIRED';
    var emailaddressrequired = '@Messages.EMAILADDRESSEREQUIRED';
</script>
<script src="~/scripts/Login/ForgetPassword.js"></script>
<script src="~/scripts/Common/Common.js"></script>