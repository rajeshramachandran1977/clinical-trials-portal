@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Anju.Navigate.Utilities;
@using Kendo.Mvc.UI
@{
    ViewData["Title"] = "Change Password";
}

<link href="~/lib/twitter-bootstrap/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/lib/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/login.css" />
<script src="~/lib/twitter-bootstrap/js/bootstrap.min.js"></script>

<div oncontextmenu="return false;">
    <form id="ui_frmChangePassword" class="frmcontainer col-4 shadow-lg">
        <h3>Change Password</h3>
        <span id="popupNotification"></span>
        <div id="resetPassword" class="form-group row">
            <label for="password" class="col-md-12 login_label pl-2">Old Password</label>
            @(Html.Kendo().TextBox()
            .Name("ui_txtOldPassword")
            .HtmlAttributes(new { id = "oldPassword", type = "password", @class = "ml-2 wid_95" })
            )
            <span class="fa fa-eye toggle-passwordOld password_icon pt-2"></span>
        </div>
        <div id="anewPassword" class="form-group row">
            <label for="password" class="col-md-12 login_label pl-2">New Password</label>
            @(Html.Kendo().TextBox()
            .Name("ui_txtNewPassword")
            .HtmlAttributes(new { id = "newPassword", type = "password", @class = "ml-2 wid_95" })
            )
            <span class="fa fa-eye toggle-passwordNew password_icon pt-2"></span>
        </div>
        <div id="confirmmnewPassword" class="form-group row">
            <label for="password" class="col-md-12 login_label pl-2">Confirm Password</label>
            @(Html.Kendo().TextBox()
            .Name("ui_txtCrfmNewPassword")
            .HtmlAttributes(new { id = "crfmNewPassword", type = "password", @class = "ml-2 wid_95" })
            )
            <span class="fa fa-eye toggle-passwordCrfm password_icon pt-2"></span>
        </div>
        <div class="row float-right mr-1"> <input class="btn btn-primary" id="btnSubmit" type="submit" value="Change Password" /></div>
        <div class="row mt-5">
            <div id="panelPolicy" class="panel panel-default">
                <img src="~/Images/Lock_Icon_1.png" class="wid_15px" />
                <div class="panel-body">
                    <div id="getPwdPolicyheader" class="login_label"></div>
                    <div id="getPwdPolicydetails" class="login_label">
                        <img id="imggetPwdPolicydetails" src="~/Images/Warning.jpg" class="wid_15px" />
                    </div>
                    <div id="OneUpperandOneLowerCase1" class="login_label">
                        <img id="imgOneUpperandOneLowerCase1" src="~/Images/Warning.jpg" class="wid_15px" />
                    </div>
                    <div id="EnforceOneNumber" class="login_label">
                        <img id="imgEnforceOneNumber" src="~/Images/Warning.jpg" class="wid_15px" />
                    </div>
                    <div id="EnforceSpecialChar" class="login_label">
                        <img id="imgEnforceSpecialChar" src="~/Images/Warning.jpg" class="wid_15px" />
                    </div>
                </div>
            </div>
        </div>
        <p id="errorMsg" class="errorMsg"></p><p id="infoMsg" class="infoMsg"></p>
    </form>

    <script src="~/scripts/Common/Common.js"></script>
    <script>
        var validator = $("#ui_frmChangePassword").kendoValidator().data("kendoValidator");
        var status = $(".status");

        //toggle password
        $(document).on('click', '.toggle-passwordNew', function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $('#newPassword');
            input.attr('type') === 'password' ? input.attr('type', 'text') : input.attr('type', 'password');
        });
        $(document).on('click', '.toggle-passwordCrfm', function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $('#crfmNewPassword');
            input.attr('type') === 'password' ? input.attr('type', 'text') : input.attr('type', 'password');
        });
        $(document).on('click', '.toggle-passwordOld', function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $('#oldPassword');
            input.attr('type') === 'password' ? input.attr('type', 'text') : input.attr('type', 'password');
        });

        // show and hide checkicon when user name is filled
        $('#newPassword', '#crfmNewPassword', '#oldPassword').keyup(function () {
            $(this).val().length === 0 ?
                $('.show_hide_icon').hide() : $('.show_hide_icon').show();
        }).keyup();

        $(document).ready(function () {
            var pageURL = window.location.pathname.split("/");
            var pageType = pageURL[2];

            $.urlParam = function (name) {
                var results = new RegExp('[\?&]' + name + '=([^&#]*)').exec(window.location.href);
                if (results == null) {
                    return null;
                }
                else {
                    return decodeURI(results[1]) || 0;
                }
            }
            var str = $.urlParam('param');

            //if (pageType != "ResetPassword")
            //    $("#resetPassword").hide();

            //disable cut,copy,paste
            $('#newPassword').bind('copy paste cut', function (e) {
                e.preventDefault();
            });
            $('#crfmNewPassword').bind('copy paste cut', function (e) {
                e.preventDefault();
            });

            //$('#btnSubmit').attr('disabled', 'disabled');
            var isLinkclicked = false;
            var pageURL = window.location.pathname.split("/");
            var pageType = pageURL[2];
            var pwdLength;
            var pwdIncUpperandLowerCase;
            var pwdEnforceOneNumber;
            var pwdSpecialChar;
            var isCheckPasswordLength = false;
            var isIncUpperandLowerCase = false;
            var isEnforceOneNumber = false;
            var isSpecialChar = false;
            var count = 0;
            $('#panelPolicy').show();
            $.ajax
                ({
                    type: "GET",
                    url: "/Login/GetPwdPolicydetails",
                    success: function (results) {
                    $.each(results, function (index, item) {
                        if (item.GlobalKey.toUpperCase() === "EnforcePasswordLength".toUpperCase() && parseInt(item.GlobalValue) > 0) {
                            isCheckPasswordLength = true;
                            pwdLength = item.GlobalValue;
                        }
                        if (item.GlobalKey.toUpperCase() === "EnforceOneUpperandOneLowerCaseCharacter".toUpperCase() && item.GlobalValue === "True") {
                            isIncUpperandLowerCase = true;
                            pwdIncUpperandLowerCase = true;

                        }
                        if (item.GlobalKey.toUpperCase() === "EnforceOneNumber".toUpperCase() && item.GlobalValue === "True") {
                            isEnforceOneNumber = true;
                            pwdEnforceOneNumber = true;
                        }
                        if (item.GlobalKey.toUpperCase() === "EnforceSpecialChar".toUpperCase() && item.GlobalValue === "True") {
                            isSpecialChar = true;
                            pwdSpecialChar = true;
                        }

                    });

                    if (parseInt(pwdLength) > 0) {
                        $("#getPwdPolicyheader").append("Your New Password Needs To:");
                        $("#getPwdPolicydetails").append("Be At least " + pwdLength + " Characters Long.");
                        isPwdlengthsatisified = false;
                    }
                    else
                        isPwdlengthsatisified = true;

                    if (pwdIncUpperandLowerCase == true) {
                        $("#OneUpperandOneLowerCase1").append("Include Atleast 1 Upper Case And 1 Lower Case Character.");
                        isIncUpperandLowerCasesatisfied = false;
                    }
                    else {
                        $('#imgOneUpperandOneLowerCase1').hide();
                        isIncUpperandLowerCasesatisfied = true;
                    }

                    if (pwdEnforceOneNumber == true) {
                        $("#EnforceOneNumber").append("Include Atleast 1 Number.");
                        isEnforceOneNumbersatisfied = false;
                    }
                    else {
                        $('#imgEnforceOneNumber').hide();
                        isEnforceOneNumbersatisfied = true;
                    }

                    if (pwdSpecialChar == true) {
                        $("#EnforceSpecialChar").append("Include Atleast 1 Special Character.");
                        isSpecialCharsatisfied = false;
                    }
                    else {
                        $('#imgEnforceSpecialChar').hide();
                        isSpecialCharsatisfied = true;
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                }
            });

            $('#crfmNewPassword').keyup(function () {
                $("#errorMsg").empty();
            });

            var policyParamCount = 0;
            $('#newPassword').keyup(function () {
                var pswd = $(this).val();
                $("#errorMsg").empty();
                if (isCheckPasswordLength) {
                    if (parseInt(pswd.length) >= pwdLength) {
                        $('#imggetPwdPolicydetails').attr('src', '/Images/CheckGreen.jpg');
                        policyParamCount += 1;
                        isPwdlengthsatisified = true;
                    } else {
                        $('#imggetPwdPolicydetails').attr('src', '/Images/Warning.jpg');
                        policyParamCount -= 1;
                        isPwdlengthsatisified = false;
                    }
                }
                if (isIncUpperandLowerCase) {
                    if (pswd.match(/[A-Z]/) && pswd.match(/[a-z]/)) {
                        $('#imgOneUpperandOneLowerCase1').attr('src', '/Images/CheckGreen.jpg');
                        policyParamCount += 1;
                        isIncUpperandLowerCasesatisfied = true;
                    } else {
                        $('#imgOneUpperandOneLowerCase1').attr('src', '/Images/Warning.jpg');
                        policyParamCount -= 1;
                        isIncUpperandLowerCasesatisfied = false;
                    }
                }
                if (isEnforceOneNumber) {
                    if (pswd.match(/\d/)) {
                        $('#imgEnforceOneNumber').attr('src', '/Images/CheckGreen.jpg');
                        policyParamCount += 1;
                        isEnforceOneNumbersatisfied = true;
                    } else {
                        $('#imgEnforceOneNumber').attr('src', '/Images/Warning.jpg');
                        policyParamCount -= 1;
                        isEnforceOneNumbersatisfied = false;
                    }
                }
                if (isSpecialChar) {
                    if (pswd.match(/[!"#$%&'()*+,-./:;<=>?@@[\]^_`{|}~]/)) {
                        $('#imgEnforceSpecialChar').attr('src', '/Images/CheckGreen.jpg');
                        policyParamCount += 1;
                        isSpecialCharsatisfied = true;
                    } else {
                        $('#imgEnforceSpecialChar').attr('src', '/Images/Warning.jpg');
                        policyParamCount -= 1;
                        isSpecialCharsatisfied = false;
                    }
                }
            });


            $.urlParam = function (name) {
                var results = new RegExp('[\?&]' + name + '=([^&#]*)').exec(window.location.href);
                if (results == null) {
                    return null;
                }
                else {
                    return decodeURI(results[1]) || 0;
                }
            }

            var str = $.urlParam('param');

            $("#btnSubmit").click(function (event) {
                event.preventDefault();
                $("#errorMsg").empty();
                $("#infoMsg").empty();
                if (ValidateMandatoryFields())
                {
                    var oldPassword = $("#oldPassword").val();
                    var newPassword = $("#newPassword").val();
                    var confirmPassword = $("#crfmNewPassword").val();
                    if (newPassword != confirmPassword) {
                        popupNotification.show("@Messages.PASSWORDMISMATCH", "error");
                        return false;
                    }
                    if (oldPassword == newPassword) {
                        popupNotification.show("@Messages.NEWPASSWORDCANNOTBESAMEASOLDPASSWORD", "error");
                        return false;
                    }
                    if(isPwdlengthsatisified == false || isIncUpperandLowerCasesatisfied == false
                       || isEnforceOneNumbersatisfied == false || isSpecialCharsatisfied == false)
                    {
                        popupNotification.show("@Messages.PASSWORDFORMATIONCRITERIA", "error");
                        return false;
                    }
                    if (pageType == "ResetPassword") {
                            $("#errorMsg").empty();
                            $.ajax({
                                type: "POST",
                                url: "/Login/ChangePassword",
                                data: { urlString: str, password: newPassword, oldPassword: oldPassword },
                                success: function (results) {
                                    if (results.msgType == "Success") {
                                        popupNotification.show(results.data + "@Messages.PASSWORDCHANGESUCCESSFULL", "success");
                                        setTimeout(redirectToLogin, 4000);
                                    }
                                    else
                                        popupNotification.show(results.data, "error");
                                    //if (pageType != "ResetPassword")
                                    //    location.href = "/account/login"
                                },
                                error: function (XMLHttpRequest, textStatus, errorThrown) {
                                }
                            });
                    }
                    else {
                        $("#errorMsg").empty();
                        $.ajax({
                            type: "POST",
                            url: "/Login/ChangePassword",
                            data: { urlString: str, password: newPassword, oldPassword: oldPassword },
                            success: function (results) {
                                if (results.msgType == "Success") {
                                    popupNotification.show(results.data + "@Messages.PASSWORDCHANGESUCCESSFULL", "success");
                                    setTimeout(redirectToLogin, 4000);
                                }
                                else
                                    popupNotification.show(results.data, "error");
                                //if (pageType != "ResetPassword")
                                //    location.href = "/account/login"
                            },
                            error: function (XMLHttpRequest, textStatus, errorThrown) {
                            }
                        });
                    }
                }
            });

            function redirectToLogin() {
                window.location.href = "/Login/Login";
            }
        });

        function ValidateMandatoryFields() {
        $('.error').remove();
        retVal = true;
        if ($('#oldPassword').val() === "") {
            $('#resetPassword').after('<div class="error errorBackground"><span class="k-icon k-i-warning"></span>Old Password is required</div>');
            retVal = false;
        }
        if ($('#newPassword').val() === "") {
            $('#anewPassword').after('<div class="error errorBackground"><span class="k-icon k-i-warning"></span>New Password is required</div>');
            retVal = false;
        }
        if ($('#crfmNewPassword').val() === "") {
            $('#confirmmnewPassword').after('<div class="error errorBackground"><span class="k-icon k-i-warning"></span>Confirm Password is required</div>');
            retVal = false;
            }
        return retVal;
    }

    </script>
</div>