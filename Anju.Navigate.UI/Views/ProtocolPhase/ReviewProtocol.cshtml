@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Anju.Navigate.Utilities;
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Site.cshtml";
    ViewData["Title"] = "ReviewProtocol";
}
<link rel="stylesheet" href="~/css/navigateStyles.css" />
<div class="p-md-4 shadow-lg newWindowMargin">
    <span id="popupNotification"></span>
    <label class="task_heading m-md-0">Review Protocol</label>
    <hr />
    <div class="panel">
        <div class="panel-body study_panel ui_panel" id="piPanel">Review this submission for completeness and quality. If the resubmission requires re-work, you have the option of returning it to the Investigator. Please select "Approved to submit to IRB" when the protocol meets @ConfigValues.appName requirements</div>
    </div>
    <div>
        <input type="hidden" value="@ViewBag.StudyId" id="StudyId" />
        <input type="hidden" id="txtUserName" value=@ViewBag.AssignedUsername>
        <input type="hidden" id="LogedinUserName" value=@ViewBag.LogedinUserName>
        <input type="hidden" id="TaskName" value="@ViewBag.TaskName" />
        <input type="hidden" id="StudyNumber" value="@ViewBag.StudyNumber" />
        <input type="hidden" id="TitleofTrial" value="@ViewBag.TitleofTrial" />
        <input type="hidden" id="Institution" value="@ViewBag.Institution" />
    </div>
    <div class="pt-3">
        <ul>
            <li class="list_item">@ViewBag.StudyNumber: @ViewBag.TitleofTrial</li>
            <li class="list_item">Submitted By @ViewBag.AssignedUsername: @ViewBag.Institution</li>
            <li class="list_item"><a href="" class="ui_link">Submission Summary</a></li>
            <li class="list_item"><a href='@Url.Action("EditStudy", "NewStudy")' class="ui_link" target="_blank">Study Profile</a></li>
        </ul>
    </div>
    <hr />
    <div class="col-md-12 pl-md-2">
        <label class="mandatory ui_label">Draft Protocol for review</label>
        @(Html.Kendo().Grid<Anju.Navigate.Data.Documents>
             ()
             .Name("ui_dtg_reviewProtocolDocuments")
             .Columns(columns =>
             {
                 columns.Bound(c => c.DocumentId).Hidden(true);
                 columns.Command(command => command.Custom("Tag").Text("Tag").Click("showDetails")).Width("8%");
                 columns.Bound(c => c.DocumentName).Width("20%").Title("Document Name").ClientTemplate(" <a onclick='Show(this);' href=\\#>#= DocumentName#</a> ");
                 columns.Bound(c => c.DocumentStatus).Width("20%").Title("Document Status");
                 columns.Bound(c => c.DocumentType).Width("15%").Title("Document Type");
                 columns.Bound(c => c.DocumentSubType).Width("15%").Title("Document Sub-Type");
                 columns.Bound(c => c.DocumentVersion).Width("22%").Title("Original / Amendment Version");
                 columns.Bound(c => c.SubModuleName).Hidden(true);
                 columns.Bound(c => c.StudyId).Hidden(true);
                 columns.Bound(c => c.OriginalDate).Hidden(true);
                 columns.Bound(c => c.ExpirationDate).Hidden(true);
                 columns.Bound(c => c.DocumentName).Hidden(true);
             })

             .HtmlAttributes(new { style = "height:250px;", @class = "ui_label" })
             .Scrollable()
             .Groupable(false)
             .Sortable()
             .Pageable(pageable => pageable
             .Refresh(true)
             .PageSizes(true)
             .ButtonCount(5))
             .DataSource(dataSource => dataSource
             .Ajax()
             .Model(model => model.Id(p => p.DocumentId))
             .Read(read => read.Action("GetDocumentsByStudyID", "NewStudy").Data("additionalInfo"))
             )
        )
        @(Html.Kendo().Window()
        .Name("Details")
        .Title("Review Document")
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(800)
        )
    </div>

    <div class="row pt-md-2" id="trialLeadDecision">
        <label class="col-form-label col-md-3 mandatory">Trial Lead Decision</label>
        <div class="col-md-6">
            @(Html.Kendo().DropDownList()
            .Name("ui_ddl_trialLeadDecision")
            .DataTextField("Code")
            .DataValueField("Code")
            .OptionLabel("Select")
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.REVIEWPROTOCOLDECISION });
                })
                .ServerFiltering(true);
            })
            )
        </div>
    </div>
    <div class="row" id="uploadReviewProtocol">
        <label class="col-form-label col-md-3 mandatory">Upload redlined version of protocol for review / resubmit by Investigator or a PDF of the document that is approved to go to the IRB for review</label>
        <div class="col-md-8 mt-md-2">
            <button type="button" id="ui_modal_RedLinedForm" data-target="#RedlinedProtocolModal" data-toggle="modal"><span class="k-icon k-i-plus"></span>Add Document</button>
            <a href="javascript:void(0);" class="ui_link col-md-7" id="reviewProtocolDocumentDownload">DOWNLOAD</a>
            <button type="button" id="ui_btn_removeProtocolDocument"><span class="k-icon k-i-delete"></span>Remove</button>
        </div>
    </div>
    <div class="row">
            <label class="col-md-3 col-form-label">Protocol Review Comment</label>
            <textarea class="k-textbox col-md-8 wid_100 ml-md-3" rows="4" id="ui_txt_comments" maxlength="300"></textarea>
            <span class="generic_text_small col-md-11 ml-md-4 text-right count">300 Characters left to enter</span>
        </div>
    </div>
    <div class="row pt-3">
        <div class="col-md-12 text-right">
            <button type="button" class="btn btn-primary" id="ui_btn_submit">Submit</button>
            <button type="button" class="btn btn-primary" id="ui_btn_cancel" onclick="showDialog();">Cancel</button>
        </div>
    </div>

    <div>
        @Html.Partial("~/Views/Common/CancelDialogBox.cshtml")
    </div>
    <div class="modal fade" id="RedlinedProtocolModal">
        <div class="modal-dialog" id="modal_dialog">
            <div class="modal-content">
                <form method="post" id="frm_RedLinedDocumentDetails">

                    <div class="modal-header modal_header">Upload Reviewed Protocol Document</div>
                    <div class="modal-body">
                        <div class="row ml-md-2 mr-0" id="fileUpload">
                            @(Html.Kendo().Upload()
                            .Name("uploadfiles")
                            .Multiple(false)
                            .Async(a => a
                            .Save("SaveRedLinedProtocolDocuments", "ProtocolPhase")
                            .Remove("RemoveRedLinedProtocolDocuments", "ProtocolPhase")
                            .AutoUpload(false)
                            )
                            .Events(events => events
                            .Select("onSelect")
                            .Upload("onUpload")
                            .Remove("onremove")
                            .Success("onsuccess")
                            )
                            .HtmlAttributes(new { aria_label = "files" })

                            )
                        </div>
                        <hr />
                        <div class="form-group row" id="documentName">
                            <label class="col-md-4 col-form-label mandatory">Document Name</label>
                            <div class="col-md-8">
                                @(Html.Kendo().TextBox()
                                .Name("ui_txt_documentName")
                                .HtmlAttributes(new { @class = "wid_100" })
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="documentStatus">
                            <label class="col-md-4 col-form-label mandatory">Document Status</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_documentStatus")
                                .HtmlAttributes(new { @class = "wid_60" }).DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTSTATUS });
                                })
                                .ServerFiltering(true);
                                })
                                )
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-4 col-form-label">Document Type</label>
                            <div class="col-md-8">
                                <label class="ui_label font-weight-light" id="ui_lbl_documentType">Regulatory</label>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-4 col-form-label">Document Sub-Type</label>
                            <div class="col-md-8">
                                <label class="ui_label font-weight-light" id="ui_lbl_documentSubType">Protocol</label>
                            </div>
                        </div>
                        <div class="form-group row" id="version">
                            <label class="col-md-4 col-form-label mandatory">Original / Amendment Version</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_version")
                                .HtmlAttributes(new { @class = "wid_60" }).DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTVERSION });
                                })
                                .ServerFiltering(true);
                                })
                                )
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-4 col-form-label">Original Date</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DatePicker()
                                .Name("ui_dt_originalDate")
                                .HtmlAttributes(new { })
                                .Format("MMM dd, yyyy")
                                )
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-4 col-form-label">Expiration Date</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DatePicker()
                                .Name("ui_dt_expiryDate")
                                .HtmlAttributes(new { })
                                .Format("MMM dd, yyyy")
                                )
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer p-1">
                        <button type="button" id="btn-DocumentSubmit" value="Submit" class="btn btn-primary">Submit</button>
                        <input type="button" id="btn-DocumentCancel" value="Cancel" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script type="text/x-kendo-template" id="template">
    <div id="details-container">
        <form id="ui_frm_tagForm">
            <div class="form-group row">
                <label class="col-form-label col-md-3">Download</label>
                <div class="col-md-9">
                    <a href="javascript:void(0);" class="fileDownload" filename="#= DocumentName #" subModuleFolderName="#= SubModuleName #" studyId="#=StudyId #">#= DocumentName #</a>
                </div>
            </div>
            <div class="form-group row">
                <label class="col-form-label col-md-3">Uploaded By</label>
                <div class="col-md-9">
                    @(Html.Kendo().TextBox()
                    .Name("ui_txt_uploadedBy")
                    .HtmlAttributes(new { @class = "wid_100", disabled = "disabled" })
                    )
                </div>
            </div>

            <div class="form-group row" id="editDocumentName">
                <label class="col-form-label col-md-3 mandatory">Document Name</label>
                <div class="col-md-9">
                    @(Html.Kendo().TextBox()
                    .Name("ui_txt_editDocumentName")
                    .HtmlAttributes(new { @class = "wid_100" })
                    .Value("#= DocumentName #")
                    )
                </div>
            </div>
            <div class="form-group row" id="editDocumentStatus">
                <label class="col-form-label col-md-3 mandatory">Document Status</label>
                <div class="col-md-9">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_editDocumentStatus")
                    .HtmlAttributes(new { @class = "wid_50" })
                    .DataTextField("Code")
                    .DataValueField("Code")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                    source.Read(read =>
                    {
                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTSTATUS });
                    })
                    .ServerFiltering(true);
                    })
                    .ToClientTemplate()
                    )
                </div>
            </div>
            <div class="form-group row" id="editDocumentType">
                <label class="col-form-label col-md-3 mandatory">Document Type</label>
                <div class="col-md-9">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_editDocumentType")
                    .HtmlAttributes(new { @class = "wid_50" })
                    .DataTextField("Code")
                    .DataValueField("CodeId")
                    .OptionLabel("Select")
                    .Events(events => events.Change("onEditDocumentTypeChange"))
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTTYPE });
                        })
                        .ServerFiltering(true);
                    })
                    .ToClientTemplate()
                    )
                </div>
            </div>
            <div class="form-group row" id="editDocumentSubType">
                <label class="col-form-label col-md-3" id="editDocumentSubTypeLabel">Document Sub-Type</label>
                <div class="col-md-9">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_editDocumentSubType")
                    .HtmlAttributes(new { @class = "wid_50" })
                    .DataTextField("Code")
                    .DataValueField("Code")
                    .OptionLabel("Select")
                    .Events(events => events.DataBound("onEditSubTypeDataBound"))
                    .DataSource(source =>
                    {
                    source.Read(read =>
                    {
                    read.Action("GetDocumentSubTypeByDocumentTypeID", "TaskWorkFlow").Data("filterDocumentSubType");
                    })
                    .ServerFiltering(true);
                    })
                    .CascadeFrom("ui_ddl_editDocumentType")
                    .ToClientTemplate()
                    )
                </div>
            </div>
            <div class="form-group row" id="editAmendmentVersion">
                <label class="col-form-label col-md-3 mandatory">Original / Amendment Version</label>
                <div class="col-md-9">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_editAmendmentVersion")
                    .HtmlAttributes(new { @class = "wid_50" })
                    .DataTextField("Code")
                    .DataValueField("Code")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                    source.Read(read =>
                    {
                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTVERSION });
                    })
                    .ServerFiltering(true);
                    })
                    .ToClientTemplate()
                    )
                </div>
            </div>
            <div class="form-group row">
                <label class="col-form-label col-md-3">Original Date</label>
                <div class="col-md-9">
                    @(Html.Kendo().DatePicker()
                    .Name("ui_dt_editOriginalDate")
                    .HtmlAttributes(new { title = "monthpicker" })
                    .Start(CalendarView.Month)
                    .Depth(CalendarView.Month)
                    .Format("MMM dd, yyyy")
                    .DateInput()
                    .ToClientTemplate()
                    )

                </div>
            </div>
            <div class="form-group row">
                <label class="col-form-label col-md-3">Expiration Date</label>
                <div class="col-md-9">
                    @(Html.Kendo().DatePicker()
                    .Name("ui_dt_editExpirationDate")
                    .Start(CalendarView.Month)
                    .Depth(CalendarView.Month)
                    .Format("MMM dd, yyyy")
                    .DateInput()
                    .HtmlAttributes(new { title = "monthpicker" })
                    .ToClientTemplate()
                    )
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 text-right">
                    <button type="button" class="btn btn-primary" id="btn-EditDocumentSubmit">Submit</button>
                    <button type="button" class="btn btn-primary" id="btn-EditDocumentCancel">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</script>
<script src="~/scripts/ReviewProtocol.js"></script>
<script src="~/scripts/Common/Common.js"></script>