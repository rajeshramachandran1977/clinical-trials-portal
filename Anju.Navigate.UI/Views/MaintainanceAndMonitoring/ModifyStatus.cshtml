@*@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
    @addTagHelper *, Kendo.Mvc
    @using Anju.Navigate.Utilities;
    @using Kendo.Mvc.UI
    @{
        Layout = "~/Views/Shared/_Site.cshtml";
        ViewData["Title"] = "ModifyStatus";
    }
    <link rel="stylesheet" href="~/css/navigateStyles.css" />

    <div class="p-md-4 shadow-lg newWindowMargin">
    <span id="popupNotification"></span>
        <label class="task_heading m-md-0">Modify Status</label>
        <hr />
        <div class="panel">
            <div class="panel-body study_panel ui_panel" id="piPanel">Please select the appropriate Status and the reason for this change from the dropdowns below. Submitting this form will change the <b>Status</b> of the study and affect the <b>workflow</b> of the study.</div>
        </div>
        <div class="pt-3">
            <div>
                <input type="hidden" id="StudyId" value="@ViewBag.StudyId" />
                <input type="hidden" id="txtUserName" value=@ViewBag.AssignedUsername>
            </div>
            <ul>
                <li class="list_item" id="studyIdAndTitleOfTrial">@ViewBag.StudyId</li>
                <li class="list_item" id="instituteSubmitted">Submitted By @ViewBag.AssignedUsername</li>
                <li class="list_item"><a href="" class="ui_link">Submission Summary</a></li>
                <li class="list_item"><a href='@Url.Action("EditStudy", "NewStudy")' class="ui_link" target="_blank">Study Profile</a></li>
            </ul>
        </div>
        <hr />

        <div class="row" id="studyStatus">
            <label class="col-form-label mandatory">Study Status</label>
            @(Html.Kendo().DropDownList()
            .Name("ui_ddl_studyStatus")
            .OptionLabel("Select")
            .DataTextField("Code")
            .DataValueField("Code")
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.STUDYSTATUS });
                })
                .ServerFiltering(true);
            })
            )
        </div>
        <div class="row" id="reasonForStatusChange">
            <label class="col-form-label mandatory">Reason for Status Change</label>
            @(Html.Kendo().DropDownList()
            .Name("ui_ddl_reasonForStatusChange")
            .OptionLabel("Select")
            .DataTextField("Code")
            .DataValueField("Code")
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.STATUSCHANGEREASON });
                })
                .ServerFiltering(true);
            })
            )
        </div>
        <div class="row">
            <label class="col-form-label">Supporting Document (optional)</label>
            <div class="col-md-3 p-md-1">
                <button type="button" id="ui_modal_supportDoc" data-target="#docModal" data-toggle="modal"><span class="k-icon k-i-plus"></span>Add Document</button>
            </div>
        </div>
        <form id="ui_frm_documentForm">
            <div class="row mt-md-2">
                @(Html.Kendo().Grid<Anju.Navigate.Data.Documents>
                    ()
                    .Name("ui_dtg_modifyStatusDocuments")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.DocumentId).Hidden(true);
                        columns.Command(command => command.Custom("Tag").Text("Tag").Click("showDetails")).Width("8%");
                        columns.Bound(c => c.DocumentName).Width("19%").Title("Document Name").ClientTemplate(" <a onclick='Show(this);' href=\\#>#= DocumentName#</a> ");
                        columns.Bound(c => c.DocumentStatus).Width("15%").Title("Document Status");
                        columns.Bound(c => c.DocumentType).Width("15%").Title("Document Type");
                        columns.Bound(c => c.DocumentSubType).Width("15%").Title("Document Sub-Type");
                        columns.Bound(c => c.DocumentVersion).Width("20%").Title("Original / Amendment Version");
                        columns.Bound(c => c.SubModuleName).Hidden(true);
                        columns.Bound(c => c.StudyId).Hidden(true);
                        columns.Bound(c => c.OriginalDate).Hidden(true);
                        columns.Bound(c => c.ExpirationDate).Hidden(true);
                        columns.Bound(c => c.DocumentName).Hidden(true);
                        columns.Command(command => { command.Destroy(); }).Width("8%");
                    })
                    .HtmlAttributes(new { style = "height:250px;", @class = "ui_label wid_100" })
                        .Scrollable()
                        .AutoBind(false)
                        .Groupable(false)
                        .Sortable()
                        .Pageable(pageable => pageable
                        .PageSizes(true)
                        .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                        .Ajax()
                        .Model(model => model.Id(p => p.DocumentId))
                        .Read(read => read.Action("GetDocumentsByStudyID", "NewStudy").Data("additionalInfo"))
                        .Destroy(update => update.Action("DeleteDocuments", "NewStudy"))
                        )
                )

                @(Html.Kendo().Window()
                .Name("Details")
                .Title("Review Document")
                .Visible(false)
                .Modal(true)
                .Draggable(true)
                .Width(800)
                )
            </div>
        </form>

        <div class="col-md-12 text-right pt-md-2">
            <button type="button" class="btn btn-primary" id="ui_btn_submit">Submit</button>
            <button type="button" class="btn btn-primary" id="ui_btn_cancel" onclick="showDialog();">Cancel</button>
        </div>
        <div>
            <partial name="~/Views/Common/CancelDialogBox.cshtml" />
        </div>

        <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header modal_header height_40px backgnd_color">
                        <h4 class="modal-title ui_modal_header pt-md-1">Warning</h4>
                        <a href="javascript:void[0]" class="close pt-md-4" data-dismiss="modal"><img class="window_close" src="~/Images/WindowClose.jpg" /></a>
                    </div>
                    <div class="modal-body">
                        <div class="ui_label font-weight-normal">
                            <img src="/Images/AlertOutlineIcon.jpg">This study is being CANCELLED. ALL workflow will be cancelled. No further actions will be possible. Are you sure you want to CANCEL this study? Click <b>YES</b> to cancel this study; Click <b>NO</b> to go back to the previous screen.
                        </div>
                        <div class="pt-md-3">
                            <label class="ui_modal_checkbox checkbox-inline">
                                <input class="mt-1" type="checkbox" id="modalCheckBox"  />
                                I CERTIFY THAT I HAVE HAD A CONVERSATION WITH THE INVESTIGATOR AND COMMUNICATED THIS CHANGE IN STUDY STATUS
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer p-2 float-right">
                        <button type="button" class="btn btn-default" data-dismiss="modal">NO</button>
                        <button type="button" class="btn btn-primary" data-dismiss="modal" id="ui_btn_newStudy">YES</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="docModal">
            <div class="modal-dialog" id="modal_dialog">
                <div class="modal-content">
                    <form method="post" id="frm_documentDetails">

                        <div class="modal-header modal_header">Upload</div>
                        <div class="modal-body">
                            <div class="row ml-md-2" id="fileUpload">
                                @(Html.Kendo().Upload()
                                .Name("uploadfiles")
                                .Multiple(false)
                                .Async(a => a
                                .Save("SaveModifyStatusDocuments", "MaintainanceAndMonitoring")
                                .Remove("RemoveModifyStatusDocuments", "MaintainanceAndMonitoring")
                                .AutoUpload(false)
                                )
                                .Events(events => events
                                .Select("onSelect")
                                .Upload("onUpload")
                                .Remove("onremove")
                                .Success("onsuccess"))
                                .HtmlAttributes(new { aria_label = "files" })
                                )
                            </div>
                            <hr />
                            <div class="form-group row" id="documentName">
                                <label class="col-md-4 col-form-label mandatory">Document Name</label>
                                <div class="col-md-8">
                                    @(Html.Kendo().TextBox()
                                    .Name("ui_txt_documentName")
                                    .HtmlAttributes(new { @class = "wid_100" })
                                    )
                                </div>
                            </div>
                            <div class="form-group row" id="documentStatus">
                                <label class="col-md-4 col-form-label mandatory">Document Status</label>
                                <div class="col-md-8">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_documentStatus")
                                    .HtmlAttributes(new { @class = "wid_60" })
                                    .DataTextField("Code")
                                    .DataValueField("Code")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTSTATUS });
                                    })
                                    .ServerFiltering(true);
                                    })
                                    )
                                </div>
                            </div>
                            <div class="form-group row" id="documentType">
                                <label class="col-md-4 col-form-label mandatory">Document Type</label>
                                <div class="col-md-8">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_documentType")
                                    .HtmlAttributes(new { @class = "wid_60" })
                                    .DataTextField("Code")
                                    .DataValueField("CodeId")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTTYPE });
                                    })
                                    .ServerFiltering(true);
                                    })
                                    )
                                </div>
                            </div>
                            <div class="form-group row" id="documentSubType">
                                <label class="col-md-4 col-form-label mandatory">Document Sub-Type</label>
                                <div class="col-md-8">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_documentSubType")
                                    .HtmlAttributes(new { @class = "wid_60" })
                                    .DataTextField("Code")
                                    .DataValueField("Code")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetDocumentSubTypeByDocumentTypeID", "TaskWorkFlow").Data("filterDocumentSubType");
                                    })
                                    .ServerFiltering(true);
                                    })
                                    .CascadeFrom("ui_ddl_documentType")
                                    )
                                </div>
                            </div>
                            <div class="form-group row" id="version">
                                <label class="col-md-4 col-form-label mandatory">Original / Amendment Version</label>
                                <div class="col-md-8">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_version")
                                    .HtmlAttributes(new { @class = "wid_60" })
                                    .DataTextField("Code")
                                    .DataValueField("Code")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTVERSION });
                                    })
                                    .ServerFiltering(true);
                                    })
                                    )
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-md-4 col-form-label">Original Date</label>
                                <div class="col-md-8">
                                    @(Html.Kendo().DatePicker()
                                    .Name("ui_dt_originalDate")
                                    .HtmlAttributes(new { })
                                    .Format("MMM dd, yyyy")
                                    )
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-md-4 col-form-label">Expiration Date</label>
                                <div class="col-md-8">
                                    @(Html.Kendo().DatePicker()
                                    .Name("ui_dt_expiryDate")
                                    .HtmlAttributes(new { })
                                    .Format("MMM dd, yyyy")
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer p-2 float-right">
                            <button type="button" id="ui_btn_documentSubmit" value="Submit" class="btn btn-primary">Submit</button>
                            <input type="button" id="ui_btn_documentCancel" value="Cancel" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script type="text/x-kendo-template" id="template">
        <div id="details-container">
            <form id="ui_frm_tagForm">
                <div class="form-group row">
                    <label class="col-form-label col-md-3">Download</label>
                    <div class="col-md-8">
                        <a href="javascript:void(0);" class="fileDownload" filename="#= DocumentNameWithOutExtension ##=DocumentExtension#" subModuleFolderName="#= SubModuleName #" studyId="#=StudyId #">#=DocumentNameWithOutExtension##=DocumentExtension#</a>
                    </div>
                </div>

                <div class="form-group row" id="editDocumentName">
                    <label class="col-form-label col-md-3 mandatory">Document Name</label>
                    <div class="col-md-8">
                        @(Html.Kendo().TextBox()
                        .Name("ui_txt_editdocumentName")
                        .HtmlAttributes(new { @class = "wid_100" })
                        .Value("#= DocumentName #")
                        )
                    </div>
                </div>
                <div class="form-group row" id="editDocumentStatus">
                    <label class="col-form-label col-md-3 mandatory">Document Status</label>
                    <div class="col-md-8">
                        @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_editdocumentStatus")
                        .HtmlAttributes(new { @class = "wid_50" })
                        .DataTextField("Code")
                        .DataValueField("Code")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTSTATUS });
                        })
                        .ServerFiltering(true);
                        })
                        .ToClientTemplate()
                        )
                    </div>
                </div>
                <div class="form-group row" id="editDocumentType">
                    <label class="col-form-label col-md-3 mandatory">Document Type</label>
                    <div class="col-md-8">
                        @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_editdocumentType")
                        .HtmlAttributes(new { @class = "wid_50" })
                        .DataTextField("Code")
                        .DataValueField("CodeId")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTTYPE });
                        })
                        .ServerFiltering(true);
                        })
                        .ToClientTemplate()
                        )
                    </div>
                </div>
                <div class="form-group row" id="editDocumentSubType">
                    <label class="col-form-label col-md-3 mandatory">Document Sub-Type</label>
                    <div class="col-md-8">
                        @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_editdocumentSubType")
                        .HtmlAttributes(new { @class = "wid_50" })
                        .DataTextField("Code")
                        .DataValueField("Code")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetDocumentSubTypeByDocumentTypeID", "TaskWorkFlow").Data("filterEditDocumentSubType");
                        })
                        .ServerFiltering(true);
                        })
                        .CascadeFrom("ui_ddl_editdocumentType")
                        .ToClientTemplate()
                        )
                    </div>
                </div>
                <div class="form-group row" id="amendmentVersion">
                    <label class="col-form-label col-md-3 mandatory">Original / Amendment Version</label>
                    <div class="col-md-8">
                        @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_amendmentVersion")
                        .HtmlAttributes(new { @class = "wid_50" })
                        .DataTextField("Code")
                        .DataValueField("Code")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTVERSION });
                        })
                        .ServerFiltering(true);
                        })
                        .ToClientTemplate()
                        )
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-form-label col-md-3">Original Date</label>
                    <div class="col-md-8">
                        @(Html.Kendo().DatePicker()
                        .Name("ui_dt_editoriginalDate")
                        .HtmlAttributes(new { title = "monthpicker" })
                        .Start(CalendarView.Month)
                        .Depth(CalendarView.Month)
                        .Format("MMM dd, yyyy")
                        .DateInput()
                        .ToClientTemplate()
                        )
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-form-label col-md-3">Expiration Date</label>
                    <div class="col-md-8">
                        @(Html.Kendo().DatePicker()
                        .Name("ui_dt_editexpirationDate")
                        .Start(CalendarView.Month)
                        .Depth(CalendarView.Month)
                        .Format("MMM dd, yyyy")
                        .DateInput()
                        .HtmlAttributes(new { title = "monthpicker" })
                        .ToClientTemplate()
                        )
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-11 text-right">
                        <button type="button" class="btn btn-primary" id="btn-editDocumentSubmit">Submit</button>
                        <button type="button" class="btn btn-primary" id="btn-editDocumentCancel">Cancel</button>
                    </div>
                </div>
            </form>
        </div>
    </script>
    <script src="~/scripts/ModifyStatus.js"></script>
<script src="~/scripts/Common/Common.js"></script>*@
