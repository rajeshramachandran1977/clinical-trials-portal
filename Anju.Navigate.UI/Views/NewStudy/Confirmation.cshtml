@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@model Anju.Navigate.Data.ListOfDocuments
@using Anju.Navigate.Utilities;
@using Kendo.Mvc.UI
@{
    ViewData["Title"] = "Confirmation";
    Layout = "~/Views/Shared/_Site.cshtml";
}
<link rel="stylesheet" href="~/css/navigateStyles.css" />

<form id="ui_frmConfirmation" class="newWindowMargin p-md-4 shadow-lg" method="post">

    <div class="row">
        <div class="col-md-4 pb-2">
            <img src="~/Images/Research_ICON2.png" class="register_img" />
            @if (@ViewBag.pITaskStatus?.ToUpper() == @ConstDefaultValue.SUBMITPROTOCOL.ToUpper())
            {
                <label class="task_heading" id="taskHeading">Submit Protocol</label>
            }
            else if (@ViewBag.TaskName?.ToUpper() == @ConstDefaultValue.RESUBMITPROTOCOL.ToUpper())
            {
                <label class="task_heading" id="taskHeading">Resubmit Protocol</label>
            }
            else
            {
                <label class="task_heading" id="taskHeading">New Proposal Submission</label>
            }
        </div>
        <div class="col-md-8 text-right">
            <label class="ui_label">Welcome @ViewBag.Username</label>
        </div>
    </div>

    <div class="card col-md-12 p-md-2">
        <div class="padding_left_100px">
            <div class="row">
                <div>
                    <input type="button" class="btn btn-submission no-click" id="scientificRationale" value="Scientific Rationale" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click wid_250px" id="personnelResearchSites" value="Personnel & Research Sites" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click" id="requestedSupport" value="Requested Support" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click" id="confirmation" value="Confirmation" />
                </div>
            </div>
            <div class="row">
                <button type="button" class="btn btn-submission no-click height_30px width_5" id="1">1</button>
                <button type="button" class="btn btn-submission no-click height_30px width_5 ml-1" id="2">2</button>
            </div>
        </div>
        <div class="row mt-md-2">
            <div class="col-md-9 border-right">
                <div class="btn-group">
                    <button class="btn btn-primary ml-md-4" id="ui_btnPreviousSection" type="submit">Previous Section</button>
                </div>
                <div class="btn-group float-right">
                    <button type="button" class="btn btn-primary" onclick="deleteNewStudyDialog();" id="deleteBtn">Delete Current Submission</button>
                </div>
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-primary" onclick="showDialog();">Cancel</button>
                <button type="submit" class="btn btn-primary" id="ui_btnSubmit">Confirm and Submit</button>
            </div>
        </div>
    </div>
    <hr />
    <div class="d-block" id="step-5">
        <h5>Science</h5>
        <hr />
        <div class="card">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Title of Trial
                </div>
                <div class="col-md-10 pl-0">
                    <textarea id="ui_txt_titleOfTrial" readonly class="k-textbox wid_99"></textarea>
                </div>
            </div>
        </div>

        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Clinical Phase
                </div>
                <div class="col-md-10 pl-0">
                    <div class="col-md-12 form-check-inline">
                        <div class="col-md-6 pl-2">
                            <label class="ui_label">Intervention Status</label>
                        </div>
                        <div class="col-md-6">
                            <input type="text" class="wid_100" id="ui_txt_interventionStatus" readonly />
                        </div>
                    </div>
                    @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
                    {
                        <div id="ui_interventionStatus" class="col-md-12 form-check-inline">
                            <div class="col-md-4 pl-2">
                                <label class="ui_label">Trial Phase</label>
                            </div>
                            <div class="custom-control custom-checkbox custom-control-inline col-md-2 pl-5 text-left">
                                <input type="checkbox" class="custom-control-input" onclick="return false;" id="PhaseI">
                                <label class="custom-control-label ui_label" for="PhaseI">Phase I</label>
                            </div>
                            <div class="custom-control custom-checkbox custom-control-inline col-md-2 pl-5 text-left">
                                <input type="checkbox" class="custom-control-input" onclick="return false;" id="PhaseII">
                                <label class="custom-control-label ui_label" for="PhaseII">Phase II</label>
                            </div>
                            <div class="custom-control custom-checkbox custom-control-inline col-md-2 pl-5 text-left">
                                <input type="checkbox" class="custom-control-input" onclick="return false;" id="PhaseIII">
                                <label class="custom-control-label ui_label" for="PhaseIII">Phase III</label>
                            </div>
                            <div class="custom-control custom-checkbox custom-control-inline col-md-2 pl-5 text-left">
                                <input type="checkbox" class="custom-control-input" onclick="return false;" id="PhaseIV">
                                <label class="custom-control-label ui_label" for="PhaseIV">Phase IV</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card mt-md-2">
            <div class="card">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Drug/Compound Details
                    </div>
                    <div class="col-md-10 pl-0">

                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-4 pl-2">
                                <label class="ui_label">Primary @ConfigValues.appName Compound</label>
                            </div>
                            <div class="col-md-6 offset-2">
                                <input type="text" class="wid_100" readonly id="ui_txt_primaryDrug" />
                            </div>
                        </div>
                        <div id="ui_secondaryDrug" class="col-md-12 form-check-inline">
                            <div class="col-md-4 pl-2">
                                <label class="ui_label">Secondary @ConfigValues.appName Compound</label>
                            </div>
                            <div class="col-md-4">
                                <input type="text" class="wid_100" readonly id="ui_txt_secondaryDrug" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" class="wid_100" readonly id="ui_txt_drugOrCompoundTypeForSecondary" />
                            </div>
                        </div>
                        <div id="ui_tertiaryDrug" class="col-md-12 form-check-inline">
                            <div class="col-md-4 pl-2">
                                <label class="ui_label">Tertiary @ConfigValues.appName Compound</label>
                            </div>
                            <div class="col-md-4">
                                <input type="text" class="wid_100" readonly id="ui_txt_tertiaryDrug" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" class="wid_100" readonly id="ui_txt_drugOrCompoundTypeForTertiary" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Concept Design and Rationale
                    </div>
                    <div class="col-md-10 pl-0">
                        <div class="panel mb-0">
                            <div class="panel-body study_panel ui_panel">Indication</div>
                        </div>
                        <textarea id="ui_txt_indication" readonly class="k-textbox wid_99"></textarea>

                        <div class="panel mb-0">
                            <div class="panel-body study_panel ui_panel">Rationale for Trial</div>
                        </div>
                        <textarea id="ui_txt_rationaleForTrial" readonly class="k-textbox wid_99"></textarea>

                        <div class="panel mb-0">
                            <div class="panel-body study_panel ui_panel">Trial Design</div>
                        </div>
                        <textarea id="ui_txt_trialDesign" readonly class="k-textbox wid_99"></textarea>
                        @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
                        {
                            <div id="ui_grid_coherent_lbl" class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Cohort levels for Dose Escalation Trials Only</div>
                            </div>
                            <div id="ui_grid_coherent" class="col-md-12 pl-2">
                                @(Html.Kendo().Grid<Anju.Navigate.Data.CohortLevels>
                                    ()
                                    .Name("ui_dtg_gridCohortLevels")
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.CohortId).Hidden(true);
                                        columns.Bound(c => c.NoofPatients).Width("15%").Title("No. of Patients").EditorTemplateName("IntegerTextBox");
                                        columns.Bound(c => c.Cohortlevel).Width("15%").Title("Cohort level");
                                        columns.Bound(c => c.DoseandFrequencyDrugA).Width("30%").Title("Drug A (dose & Frequency)");
                                        columns.Bound(c => c.DoseandFrequencyDrugB).Width("40%").Title("Drug B (dose & Frequency) (if applicable)");
                                    })
                                    .HtmlAttributes(new { style = "height: 200px;" })
                                    .Groupable(false)
                                    .Sortable()
                                    .Pageable(pageable => pageable
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                                    .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model => model.Id(p => p.CohortId))
                                    .Read(read => read.Action("GetCohortLevels", "NewStudy"))
                                    )
                                )
                            </div>
                        }
                            <div id="ui_blinding" class="col-md-12 form-check-inline">
                                <div class="col-md-6 pl-2">
                                    <label class="ui_label">Blinding</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="wid_100" id="ui_txt_blinding" readonly />
                                </div>
                            </div>
                            <div id="ui_structure" class="col-md-12 form-check-inline">
                                <div class="col-md-6 pl-2">
                                    <label class="ui_label">Structure</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="wid_100" id="ui_txt_structure" readonly />
                                </div>
                            </div>
                            <div id="ui_randomized" class="col-md-12 form-check-inline">
                                <div class="col-md-6 pl-2">
                                    <label class="ui_label">Randomized</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="wid_100" id="ui_txt_randomized" readonly />
                                </div>
                            </div>
                            <div class="col-md-12 form-check-inline">
                                <div class="col-md-6 pl-2">
                                    <label class="ui_label">Gender</label>
                                </div>
                                <div class="custom-control-inline col-md-6">
                                    <select id="ui_multiselectGender" name="ui_multiselectGender" disabled class="wid_46"></select>
                                </div>
                            </div>
                            <div class="col-md-12 form-check-inline">
                                <div class="col-md-6 pl-2">
                                    <label class="ui_label">Minimum Age</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="wid_100" id="ui_txt_minAge" readonly />
                                </div>
                            </div>
                            <div class="col-md-12 form-check-inline">
                                <div class="col-md-6 pl-2">
                                    <label class="ui_label">Maximum Age</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="wid_100" id="ui_txt_maxAge" readonly />
                                </div>
                            </div>
                            <div class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Patient Population</div>
                            </div>
                            <textarea id="ui_txt_patientPopulation" class="k-textbox wid_99" readonly></textarea>
                            <div class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Key Inclusion Criteria</div>
                            </div>
                            <textarea id="ui_txt_keyInclusionCriteria" class="k-textbox wid_99" readonly></textarea>
                            <div class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Key Exclusion Criteria</div>
                            </div>
                            <textarea id="ui_txt_exclusionCriteria" class="k-textbox wid_99" readonly></textarea>
                        </div>
                </div>
            </div>
            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Objectives and Endpoints
                    </div>
                    <div class="col-md-10 pl-0">
                        <div class="col-md-12 pl-2">
                            @(Html.Kendo().Grid<Anju.Navigate.Data.ObjectivesandEndpoints>
                                ()
                                .Name("ui_dtg_gridObjectivesandEndpoints")
                                .Columns(columns =>
                                {
                                columns.Bound(c => c.ObjandEndPointsId).Hidden(true);
                                columns.Bound(c => c.ObjectiveType).Width("25%").Title("Objective Type").EditorTemplateName("ObjectiveType");
                                columns.Bound(c => c.ObjectiveName).Width("25%").Title("Objective Name").EditorTemplateName("ObjectiveName");
                                columns.Bound(c => c.ObjectiveDescription).Width("20%").Title("Objective Description");
                                columns.Bound(c => c.EndpointDescription).Width("30%").Title("End Point Description");
                                })
                                .HtmlAttributes(new { style = "height: 200px;" })
                                .Scrollable()
                                .Groupable(false)
                                .Sortable()
                                .Pageable(pageable => pageable
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model => model.Id(p => p.ObjandEndPointsId))
                                .Read(read => read.Action("GetObjectivesandEndpoints", "NewStudy"))
                                )
                            )
                        </div>
                    </div>
                </div>
            </div>

            <div id="ui_treatmentArms" class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Treatment Information (includes co-therapy)
                    </div>
                    <div class="col-md-10 pl-0">
                        <div class="panel mb-0">
                            <div class="panel-body study_panel ui_panel">How many treatment arms apply to this trial?</div>
                        </div>
                        <textarea id="ui_txt_treatmentArms" readonly class="k-textbox wid_99"></textarea>
                        @(Html.Kendo().Grid<Anju.Navigate.Data.TreatmentInformation>
                            ()
                            .Name("ui_dtg_gridTreatmentInformation")
                            .Columns(columns =>
                            {
                            columns.Bound(c => c.TreatmentArm).Width("10%").Title("Treatment Arm");
                            columns.Bound(c => c.NoofPatientsPlanned).Width("10%").Title("Number of Patients Planne");
                            columns.Bound(c => c.TypeofTrialDrug).Width("10%").Title("Type of Trial Drug").EditorTemplateName("TypeofTrialDrug");
                            columns.Bound(c => c.Compound).Width("10%").Title("Compound (specify brand or generic)");
                            columns.Bound(c => c.Mindosage).Width("10%").Title("Min Dose and unit");
                            columns.Bound(c => c.Maxdosage).Width("10%").Title("Max Dose and unit");
                            columns.Bound(c => c.Frequency).Width("10%").Title("Frequency");
                            columns.Bound(c => c.AdminRoute).Width("10%").Title("Admin Route");
                            columns.Bound(c => c.GenericAcceptable).Width("20%").Title("Generic Acceptable (applies only for comparable)").EditorTemplateName("YesNoDropDown");
                            })
                            .HtmlAttributes(new { style = "height: 200px;", @class = "ui_label" })
                            .Scrollable()
                            .Groupable(false)
                            .Sortable()
                            .Pageable(pageable => pageable
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                            .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(model => model.Id(p => p.TreatmentInfoId))
                            .Read(read => read.Action("GetTreatmentInformation", "NewStudy"))
                            )
                        )
                    </div>
                </div>
            </div>

            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Sample Size Justification and Statistical Analyis
                    </div>
                    <div class="col-md-10 pl-0">
                        <textarea id="ui_txt_sampleSizeJustification" readonly class="k-textbox wid_99"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Clinical Pharmacology
                    </div>
                    <div class="col-md-10 pl-0">
                        <textarea id="ui_txt_clinicalPharmacology" readonly class="k-textbox wid_99"></textarea>
                    </div>
                </div>
            </div>
            @if (@ViewBag.pITaskStatus?.ToUpper() == @ConstDefaultValue.SUBMITPROTOCOL.ToUpper() || (@ViewBag.TaskName?.ToUpper() == @ConstDefaultValue.RESUBMITPROTOCOL.ToUpper()))
            {
                <div id="ui_siteprotocol" class="card mt-md-2">
                    <div class="row pl-md-3">
                        <div class="col-md-2 editer-title submitprotocol align-items-center d-flex justify-content-center">
                            Investigational Site Protocol Number
                        </div>
                        <div class="col-md-10 pl-0">
                            <textarea id="ui_txt_siteprotocol" readonly class="k-textbox wid_99"></textarea>
                        </div>
                    </div>
                </div>
            }

            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Correlative science Studies
                    </div>
                    <div class="col-md-10 pl-0">
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Will this study include Correlative Science?</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_correlativeScience" />
                            </div>
                        </div>
                        <div id="ifCorrelativeScienceYes" class="wid_100">
                            <div class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Biomarker / Correlative Science Studies performed at Study Site(s)</div>
                            </div>
                            <textarea id="ui_txt_correlativescienceAtStudySite" readonly class="k-textbox wid_99"></textarea>
                            <div class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Biomarker / Correlative Science Studies performed at @ConfigValues.appName Site</div>
                            </div>
                            <textarea id="ui_txt_correlativescienceAtCompanySite" readonly class="k-textbox wid_99"></textarea>
                            <div class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Biomarker / Correlative Science Sampling Details</div>
                            </div>
                            <textarea id="ui_txt_correlativeScienceSamplingDet" readonly class="k-textbox wid_99"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Planned Trial MilestoneDates and Enrollment
                    </div>
                    <div class="col-md-10 pl-0">
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Trial Start (First Patient First Visit)</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_trialStart" readonly />
                            </div>
                        </div>
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Recruitment End (Last Patient First Visit)</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_recruitmentEnd" readonly />
                            </div>
                        </div>
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Trial End (Last Patient Last Visit)</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_trialEnd" readonly />
                            </div>
                        </div>
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Total Planned Number of Patients</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_noOfPatients" readonly />
                            </div>
                        </div>
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Completion of Trial Report</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_completionOfTrialReport" readonly />
                            </div>
                        </div>
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Primary Publication Date</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_primaryPublication" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="ui_proposedcenter" class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Proposed Centers
                    </div>
                    <div class="col-md-10 pl-0">
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Planned Number of Centers</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_plannedNoOfCenters" readonly />
                            </div>
                        </div>
                        <div id="ui_dtg_Center_grid" class="col-md-12 pl-2">
                            @(Html.Kendo().Grid<Anju.Navigate.Data.Center>
                                ()
                                .Name("ui_dtg_Center")
                                .Columns(columns =>
                                {
                                columns.Bound(c => c.CenterId).Hidden(true);
                                columns.Bound(c => c).Width("90%").Title("Center");
                                columns.Bound(c => c.Institution).Width("10%").Title("Center Institution");
                                })
                                .HtmlAttributes(new { style = "height: 200px;" })
                                .Scrollable()
                                .Groupable(false)
                                .Sortable()
                                .Pageable(pageable => pageable
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model => model.Id(p => p.CenterId))
                                .Read(read => read.Action("GetCenter", "NewStudy"))
                                )
                            )
                        </div>
                    </div>
                </div>
            </div>

            <div id="ui_enrollmentHistory" class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Enrollment History for Other Related Studies
                    </div>
                    <div class="col-md-10 pl-0">
                        <textarea id="ui_txt_enrollmentHistory" readonly class="k-textbox wid_99"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Competing Studies
                    </div>
                    <div class="col-md-10 pl-0">
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Are there competing studies at your institution?</label>
                            </div>
                            <div class="col-md-6">
