                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Will Government Support be Provided?</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_isGovernmentSupportProvided" readonly />
                            </div>
                        </div>
                        <div class="col-md-12 form-check-inline">
                            <div class="col-md-6 pl-2">
                                <label class="ui_label">Will support be provided from other sources?</label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="wid_100" id="ui_txt_issupportbeprovidedfromothersource" readonly />
                            </div>
                        </div>
                        <div id="govtSupportDesc">
                            <div class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Government Support Description</div>
                            </div>
                            <textarea id="ui_txt_GovernmentSupportDescription" readonly class="k-textbox wid_99"></textarea>
                        </div>
                        <div id="nonCompanySupportSources">
                            <div class="panel mb-0">
                                <div class="panel-body study_panel ui_panel">Non-@ConfigValues.appName Support Sources</div>
                            </div>
                            <textarea id="ui_txt_nonCompanySupportSources" readonly class="k-textbox wid_99"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            @*Page 4*@
            <h5 class="pt-3">Requested Support</h5>
            <hr />
            <div class="card">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Request for @ConfigValues.appName Support
                    </div>
                    <div class="col-md-10 pl-0">
                        @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
                        {
                            <div class="col-md-12 form-check-inline">
                                <div class="col-md-6 pl-2">
                                    <label class="ui_label">Request for drug supply</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="wid_100" id="ui_txt_reqDrugSupply" readonly />
                                </div>
                            </div>
                        }
                            <div class="col-md-12 form-check-inline">
                                <div class="col-md-6 pl-2">
                                    <label class="ui_label">Request for financial support</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="wid_100" id="ui_txt_reqFinancialSupport" readonly />
                                </div>
                            </div>
                            <div id="ifReqFinancialSupportYes">
                                <div class="col-md-12 form-check-inline">
                                    <div class="col-md-6 pl-2">
                                        <label class="ui_label">Budget (USD) requested for the trial</label>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="text" class="wid_100" id="ui_txt_currency" readonly />
                                    </div>
                                </div>
                                <div class="col-md-12 form-check-inline">
                                    <div class="col-md-6 pl-2">
                                        <label class="ui_label">Completed detailed trial budget</label>
                                    </div>
                                    <div class="col-md-6">
                                        @*<input type="text" class="wid_100" id="ui_txt_Document" />*@
                                        @foreach (var item in Model.TrialBudgetDocuments)
                                        {
                                            <a asp-action="DownloadFiles"
                                               asp-controller="NewStudy"
                                               asp-route-filename="@item.DocumentName"
                                               asp-route-subModuleFolderName="@item.SubModuleName">
                                                @item.DocumentName

                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            @if (@ViewBag.pITaskStatus?.ToUpper() == @ConstDefaultValue.SUBMITPROTOCOL.ToUpper() || (@ViewBag.TaskName?.ToUpper() == @ConstDefaultValue.RESUBMITPROTOCOL.ToUpper()))
            {
                <div class="card mt-md-2">
                    <div class="row pl-md-3">
                        <div class="col-md-2 editer-title submitprotocol align-items-center d-flex justify-content-center">
                            Protocol
                        </div>
                        <div class="col-md-10 pl-0">
                            <ul>
                                @foreach (var item in Model.ProtocolDocuments)
                                {
                                    <li>
                                        <a asp-action="DownloadFiles"
                                           asp-controller="NewStudy"
                                           asp-route-filename="@item.DocumentName"
                                           asp-route-subModuleFolderName="@item.SubModuleName"
                                           asp-route-path="@item.Path">
                                            @item.DocumentName

                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
            <div class="card mt-md-2">
                @if (Model.AdditionalDocuments.Count>0)
                {
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        Additional Documents
                    </div>
                    <div class="col-md-10 pl-0">
                        <ul>
                            @foreach (var item in Model.AdditionalDocuments)
                            {
                                <li>
                                    <a asp-action="DownloadFiles"
                                       asp-controller="NewStudy"
                                       asp-route-filename="@item.DocumentName"
                                       asp-route-subModuleFolderName="@item.SubModuleName">
                                        @item.DocumentName

                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                }
            </div>
        </div>
        <div>
            <input type="hidden" id="txtUserName" value=@ViewBag.Username>
            <input type="hidden" value="@ViewBag.StudyId" id="StudyId" />
            <input type="hidden" value="@ViewBag.mode" id="mode" />
            <input type="hidden" value="@ViewBag.studyType" id="studyType" />
            <input type="hidden" value="@ViewBag.TaskName" id="TaskName" />
            <input type="hidden" value="@ViewBag.pITaskStatus" id="pITaskStatus" />
            <input type="hidden" value="@ConstDefaultValue.SUBMITPROTOCOL" id="pISubmitProtocol" />
        </div>
        <div class="card p-md-2 mt-md-2">
            <div class="row">
                <div class="col-md-9 border-right">
                    <div class="btn-group">
                        <button class="btn btn-primary ml-md-4" id="ui_btnPreviousSectionEnd" type="submit">Previous Section</button>
                    </div>
                    <div class="btn-group float-right">
                        <button type="button" class="btn btn-primary" onclick="deleteNewStudyDialog();" id="deleteBtnEnd">Delete Current Submission</button>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-primary" onclick="showDialog();">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="ui_btnSubmitEnd">Confirm and Submit</button>
                </div>
            </div>
        </div>
        <div>
            <partial name="~/Views/Common/CancelNewStudy.cshtml" />
            <partial name="~/Views/Common/DeleteNewStudy.cshtml" />
        </div>
    </div>
</form>
<script>
    var RESUBMITPROPOSAL="@Messages.RESUBMITPROPOSAL" ;
    var RESUBMITPROTOCOL="@ConstDefaultValue.RESUBMITPROTOCOL";
    var SUBMITPROTOCOL= "@ConstDefaultValue.SUBMITPROTOCOL";
    var MSL = "@Messages.MSL";
    var GMRCREQUESTEDRESUBMISSION="@Messages.GMRCREQUESTEDRESUBMISSION";
    var RESUBMITPROPOSALCOMPLETE="@Messages.RESUBMITPROPOSALCOMPLETE";
    var GMRCMSLREVIEW="@Messages.GMRCMSLREVIEW";
    var CONCEPTRESUBMITTED="@Messages.CONCEPTRESUBMITTED";
    var GMRCPENDINGMSLCONCEPTREVIEW="@Messages.GMRCPENDINGMSLCONCEPTREVIEW";
    var NEWSUBMISSION="@Messages.NEWSUBMISSION";
    var CONCEPTSUBMITTED="@Messages.CONCEPTSUBMITTED";
    var ASSIGNMSLANDPL= "@Messages.ASSIGNMSLANDPL";
    var PENDINGMANUALMSLANDPLASSIGNMENT = "@Messages.PENDINGMANUALMSLANDPLASSIGNMENT";
    var MSLLOIREVIEW="@Messages.MSLLOIREVIEW";
    var CONCEPTRESUBMITTED="@Messages.CONCEPTRESUBMITTED";
    var PENDINGMSLCONCEPTREVIEW="@Messages.PENDINGMSLCONCEPTREVIEW";
    var PROTOCOLSUBMISSIONCOMPLETED="@Messages.PROTOCOLSUBMISSIONCOMPLETED";
    var DECISIONAPPROVED= "@Messages.DECISIONAPPROVED";
    var GMRCPREACTIVITIESINPROGRESS = "@Messages.GMRCPREACTIVITIESINPROGRESS";
    var appName = "@ConfigValues.appName";
    var IISADMIN = "@ConstDefaultValue.IISADMIN";
    var PENDINGRESUBMISSIONBYPI="@Messages.PENDINGRESUBMISSIONBYPI";
</script>
<script src="~/scripts/Confirmation.js"></script>