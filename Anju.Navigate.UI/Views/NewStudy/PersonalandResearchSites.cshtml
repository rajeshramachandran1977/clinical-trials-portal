                                )
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <label for="ui_lblFax" class="text-right wid_25 ui_label">Fax</label>
                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_payee_fax")
                                    .HtmlAttributes(new { @class = "wid_72" })
                                )
                            </div>
                            <div class="col-md-6">
