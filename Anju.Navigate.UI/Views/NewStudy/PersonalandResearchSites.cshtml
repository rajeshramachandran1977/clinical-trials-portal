@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@model Anju.Navigate.Data.ListOfDocuments
@using Anju.Navigate.Utilities;
@using Kendo.Mvc.UI
@{
    ViewData["Title"] = "Personal and Research Sites";
    Layout = "~/Views/Shared/_Site.cshtml";
}
<link rel="stylesheet" href="~/css/navigateStyles.css" />

<form role="form" id="ui_frmPersonalandResearchSite" class="newWindowMargin p-md-4 shadow-lg" method="post">

    <div class="row">
        <div class="col-md-4 pb-2">
            <img src="~/Images/Research_ICON2.png" class="register_img" />
            @if (@ViewBag.pITaskStatus?.ToUpper() == @ConstDefaultValue.SUBMITPROTOCOL.ToUpper())
            {
                <label class="task_heading" id="taskHeading">Submit Protocol</label>
            }
            else if (@ViewBag.TaskName?.ToUpper() == @ConstDefaultValue.RESUBMITPROTOCOL.ToUpper())
            {
                <label class="task_heading" id="taskHeading">Resubmit Protocol</label>
            }
            else
            {
                <label class="task_heading" id="taskHeading">New Proposal Submission</label>
            }
        </div>
        <div class="col-md-8 text-right">
            <label class="ui_label">Welcome @ViewBag.Username</label>
        </div>
    </div>
    <div class="card col-md-12 p-md-2">
        <div class="padding_left_100px">
            <div class="row">
                <div>
                    <input type="button" class="btn btn-submission no-click" id="scientificRationale" value="Scientific Rationale" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click wid_250px" id="personnelResearchSites" value="Personnel & Research Sites" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click" id="requestedSupport" value="Requested Support" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click" id="confirmation" value="Confirmation" />
                </div>
            </div>
            <div class="row">
                <button type="button" class="btn btn-submission no-click height_30px width_5" id="1">1</button>
                <button type="button" class="btn btn-submission no-click height_30px width_5 ml-1" id="2">2</button>
            </div>
        </div>
        <div class="row mt-md-2">
            <div class="col-md-8 border-right">
                <div class="btn-group">
                    <button class="btn btn-primary ml-md-4" id="ui_btnPreviousSection" type="submit">Previous Section</button>
                </div>
                <div class="btn-group float-right">
                    <button type="button" class="btn btn-primary" onclick="deleteNewStudyDialog();" id="deleteBtn">Delete Current Submission</button>
                </div>
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-primary" onclick="showDialog();">Cancel</button>
                <button type="button" class="btn btn-primary" id="ui_btnSaveandExit">Save & Exit</button>
                <button type="button" id="ui_btnSaveandContinue" class="btn btn-primary">Save & Continue...</button>
            </div>
        </div>

    </div>
    <hr />
    <div class="setup-content d-none" id="step-3">
        <span id="popupNotification"></span>
        <div class="card">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Principal Investigator
                </div>
                <div class="col-md-10">
                    <div class="row">

                        <div class="col-md-6">
                            <div id="firstName">
                                <label for="ui_lblFirstName" class="text-right mandatory wid_25 ui_label">First Name</label>
                                @(Html.Kendo().TextBox()
                                .Name("ui_txt_firstName")
                                .HtmlAttributes(new { @class = "wid_72" })
                                )
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div id="lastName">
                                <label for="ui_lblLastName" class="text-right mandatory wid_23 ui_label">Last Name</label>
                                @(Html.Kendo().TextBox()
                                .Name("ui_txt_lastName")
                                .HtmlAttributes(new { @class = "wid_74" })
                                )
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="text-right wid_25 ui_label">Salutation</label>

                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_salutation")
                            .HtmlAttributes(new { @class = "wid_73" })
                            .DataTextField("Code")
                            .DataValueField("Code")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                            source.Read(read =>
                            {
                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.SALUTATION });
                            })
                            .ServerFiltering(true);
                            })
                            )
                        </div>
                        <div class="col-md-6">
                            <label class="text-right wid_23 ui_label">Suffix</label>
                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_suffix")
                            .DataTextField("Code")
                            .DataValueField("Code")
                            .OptionLabel("Select")
                            .HtmlAttributes(new { @class = "wid_75" })
                            .DataSource(source =>
                            {
                            source.Read(read =>
                            {
                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.SUFFIX });
                            })
                            .ServerFiltering(true);
                            })
                            )
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="ui_lblTitle" class="text-right wid_25 ui_label">Title</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_title")
                            .HtmlAttributes(new { @class = "wid_72" })
                            )
                        </div>
                        <div class="col-md-6">
                            <div id="multiselectCredentials">
                                <label for="ui_lblDegree" class="text-right mandatory wid_23 ui_label">Degree</label>
                                <select id="ui_multiselect_credentials" name="ui_multiselect_credentials" class="wid_74"></select>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label for="ui_lblNPI" class="text-right wid_12 ui_label">NPI #</label>
                        @(Html.Kendo().TextBox()
                        .Name("ui_txt_npi")
                        .HtmlAttributes(new { @class = "wid_35" })
                        )
                    </div>
                    <div id="institution">
                        <label for="ui_lblInstitution" class="text-right mandatory wid_12 ui_label">Institution</label>
                        @(Html.Kendo().TextBox()
                        .Name("ui_txt_Institution")
                        .HtmlAttributes(new { @class = "wid_35" })
                        )
                    </div>
                    <div id="country">
                        <label class="text-right mandatory wid_12 ui_label">Country</label>
                        @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_country")
                        .HtmlAttributes(new { @class = "wid_35" })
                        .DataTextField("Code")
                        .DataValueField("CountryId")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetCountries", "Register");
                        })
                        .ServerFiltering(true);
                        })
                        )
                    </div>
                    <div id="state">
                        <label for="ui_lblStateprovince" class="text-right mandatory wid_12 ui_label">State/Province</label>

                        @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_state")
                        .HtmlAttributes(new { @class = "wid_35" })
                        .DataTextField("Code")
                        .DataValueField("StateId")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetStatesByCountryID", "Register").Data("filterStates");
                        })
                        .ServerFiltering(true);
                        })
                        .Enable(false)
                        .AutoBind(false)
                        .CascadeFrom("ui_ddl_country")
                        )
                    </div>

                    <div id="city">
                        <label for="ui_lblCity" class="text-right mandatory wid_12 ui_label">City</label>

                        @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_city")
                        .HtmlAttributes(new { @class = "wid_35" })
                        .DataTextField("Name")
                        .DataValueField("CityId")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetCitiesByStateID", "Register").Data("filterCities");
                        })
                        .ServerFiltering(true);
                        })
                        .Enable(false)
                        .AutoBind(false)
                        .CascadeFrom("ui_ddl_state")
                        )
                    </div>

                    <div class="row" id="uploadFile">
                        <div class="col-md-6 form-check-inline">
                            <label for="ui_lblLatestsignedCurriculumVitae" class="text-right mandatory wid_35 ml-3 pr-1 ui_label">Latest, signed Curriculum Vitae</label>
                            @(Html.Kendo().Upload()
                            .Name("files")
                            .Files(
                            files =>
                                    {
                                        foreach (var f in Model.LatestCV)
                            {
                            files.Add().Name(f.DocumentName).Extension(f.DocumentExtension).Size(f.DocumentSize);
                            }
                            })
                            .HtmlAttributes(new { @class = "wid_70" })
                            .Multiple(false)
                            .Async(a => a
                            .Save("SaveAsyncPersonalandResearchDocuments", "NewStudy")
                            .Remove("RemovePersonalandResearchDocuments", "NewStudy")
                            .AutoUpload(true)
                            )
                            .Events(events => events
                            .Upload("onUpload"))
                            )
                        </div>
                    </div>


                    <div id="addressLine1">
                        <label for="ui_lblAddressline1" class="text-right mandatory wid_12 ui_label">Address Line 1</label>
                        @(Html.Kendo().TextBox()
                        .Name("ui_txt_addressLine1")
                        .HtmlAttributes(new { @class = "wid_50" })

                        )
                    </div>
                    <div>
                        <label for="ui_lblAddressline2" class="text-right wid_12 ui_label">Address Line 2</label>
                        @(Html.Kendo().TextBox()
                        .Name("ui_txt_addressLine2")
                        .HtmlAttributes(new { @class = "wid_50" })
                        )
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div id="postalCode">
                                <label for="ui_lblPostalCode" class="text-right mandatory wid_25 ui_label">Postal Code</label>
                                @(Html.Kendo().TextBox()
                                .Name("ui_txt_postalCode")
                                .HtmlAttributes(new { @class = "wid_72" })
                                )
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div id="phonePI">
                                <label for="ui_lblPhone" class="text-right mandatory wid_25 ui_label">Phone</label>
                                @(Html.Kendo().MaskedTextBox()
                                .Name("ui_txt_phone")
                                .Mask("(999) 999-9999")
                                .HtmlAttributes(new { @class = "wid_72" })
                                )
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="ui_lblFax" class="text-right wid_25 ui_label">Fax</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_fax")
                            .HtmlAttributes(new { @class = "wid_72" })
                            )
                        </div>
                        <div class="col-md-6">
                            <div id="email">
                                <label for="ui_lblEmail" class="text-right mandatory wid_25 ui_label">Email</label>
                                @(Html.Kendo().TextBox()
                                .Name("ui_txt_email")
                                .HtmlAttributes(new { @class = "wid_72" })
                                )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Email List
                </div>
                <div class="col-md-10 pl-2">
                    <label class="ui_label ">System-generated emails related to this study may be sent to more than one recipient at your discretion. For each desired recipient, please provide the relevant email address below.</label>
                    @(Html.Kendo().Grid<Anju.Navigate.Data.EmailList>
                        ()
                        .Name("ui_dtg_emailList")
                        .Columns(columns =>
                        {
                        columns.Bound(c => c.Email).Width("75%").Title("Email");
                        columns.Command(command => { command.Edit(); command.Destroy(); }).Width("25%");
                        })
                        .ToolBar(tools =>
                        {
                        tools.Create();
                        })
                        .HtmlAttributes(new { style = "height: 280px;" })
                        .Scrollable()
                        .Groupable(false)
                        .Sortable()
                        .Events(events => { events.Save("OnCreateUpdateModal"); })
                        .Editable(editable => editable.Mode(GridEditMode.InLine).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you would like to delete"))
                        .Pageable(pageable => pageable
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(e => e.RequestEnd("OnsaveChanges"))
                        .Events(events => events.Error("error_handler")) // Handle the "error" event
                        .Model(model => model.Id(p => p.Id))
                        .Create(update => update.Action("CreateUpdateEmailList", "NewStudy", new { Mode = "Create" }).Data("StudyDetailsID"))
                        .Update(update => update.Action("CreateUpdateEmailList", "NewStudy", new { Mode = "Update" }).Data("StudyDetailsID"))
                        .Read(read => read.Action("GetEmailList", "NewStudy").Data("StudyDetailsID"))
                        .Destroy(update => update.Action("DeleteEmailList", "NewStudy", new { Mode = "Delete" }).Data("StudyDetailsID"))
                        )
                    )
                </div>
            </div>
        </div>

        @if (@ViewBag.pITaskStatus?.ToUpper() == @ConstDefaultValue.SUBMITPROTOCOL.ToUpper() || (@ViewBag.TaskName?.ToUpper() == @ConstDefaultValue.RESUBMITPROTOCOL.ToUpper()))
        {
            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center submitprotocol d-flex justify-content-center">
                        Payee Information
                    </div>
                    <div class="col-md-10">
                        <div class="row">

                            <div class="col-md-6">
                                <label for="ui_lblFirstName" class="text-right  wid_25 ui_label">First Name</label>
                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_payee_firstName")
                                    .HtmlAttributes(new { @class = "wid_72" })
                                )

                            </div>
                            <div class="col-md-6">
                                <label for="ui_lblLastName" class="text-right  wid_23 ui_label">Last Name</label>
                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_payee_lastName")
                                    .HtmlAttributes(new { @class = "wid_74" })
                                )
                            </div>

                        </div>
                        <div class="row">
