                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.SALUTATION });
                                        })
                                                        .ServerFiltering(true);
                                    })
                                )
                            </div>
                            <div class="col-md-6">
                                <label class="text-right wid_23 ui_label">Suffix</label>
                                @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_payee_suffix")
                                    .DataTextField("Code")
                                    .DataValueField("Code")
                                    .OptionLabel("Select")
                                    .HtmlAttributes(new { @class = "wid_75" })
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.SUFFIX });
