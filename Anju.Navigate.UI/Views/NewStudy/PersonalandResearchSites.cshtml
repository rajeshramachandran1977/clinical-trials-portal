                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_payee_institutiontax")
                                    .HtmlAttributes(new { @class = "wid_74" })
                                )
                            </div>

                        </div>
                        <div>
                            <label class="text-right  wid_12 ui_label">Country</label>

                            @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_payee_country")
                                .HtmlAttributes(new { @class = "wid_35" })
                                .DataTextField("Code")
                                .DataValueField("CountryId")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetCountries", "Register");
                                    })
                                                .ServerFiltering(true);
                                })
