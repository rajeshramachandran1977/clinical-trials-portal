                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_payee_email")
                                    .HtmlAttributes(new { @class = "wid_72" })
                                )
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center submitprotocol d-flex justify-content-center">
                        Pharmacist / Drug Shipment Information
                    </div>
                    <div class="col-md-10">
                        <div class="row">

                            <div class="col-md-6">
                                <label for="ui_lblFirstName" class="text-right  wid_25 ui_label">First Name</label>
                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_shipment_firstName")
                                    .HtmlAttributes(new { @class = "wid_72" })
                                )

                            </div>
                            <div class="col-md-6">
                                <label for="ui_lblLastName" class="text-right  wid_23 ui_label">Last Name</label>
                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_shipment_lastName")
                                    .HtmlAttributes(new { @class = "wid_74" })
                                )
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <label class="text-right wid_25 ui_label">Salutation</label>

                                @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_shipment_salutation")
                                    .HtmlAttributes(new { @class = "wid_73" })
                                    .DataTextField("Code")
                                    .DataValueField("Code")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.SALUTATION });
                                        })
                                                        .ServerFiltering(true);
                                    })
