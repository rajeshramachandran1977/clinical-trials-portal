                        <div>
                            <label for="ui_lblAddressline2" class="text-right wid_12 ui_label">Address Line 2</label>
                            @(Html.Kendo().TextBox()
                                .Name("ui_txt_payee_addressLine2")
                                .HtmlAttributes(new { @class = "wid_50" })
                            )
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <label for="ui_lblPostalCode" class="text-right  wid_25 ui_label">Postal Code</label>

                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_payee_postalCode")
                                    .HtmlAttributes(new { @class = "wid_72" })
