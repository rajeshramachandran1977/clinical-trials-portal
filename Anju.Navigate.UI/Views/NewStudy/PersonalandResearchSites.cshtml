                                @(Html.Kendo().TextBox()
                                    .Name("ui_txt_shipment_title")
                                    .HtmlAttributes(new { @class = "wid_72" })
                                )
                            </div>
                            <div class="col-md-6">
                                <label for="ui_lblDegree" class="text-right  wid_23 ui_label">Degree</label>
