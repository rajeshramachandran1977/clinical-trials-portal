                                        read.Action("GetCitiesByStateID", "Register").Data("filterPayeeCities");
                                    })
                                                .ServerFiltering(true);
                                })
                                .Enable(false)
                                .AutoBind(false)
                                .CascadeFrom("ui_ddl_payee_state")
