                            <partial name="~/Views/NewStudy/EditStudy/ResearchGroupDescription.cshtml" />
                        </div>
                        <div>
                            @*Original Financial Request*@
                            <partial name="~/Views/NewStudy/EditStudy/OriginalFinancialRequest.cshtml" />
                        </div>
                        <div>
                            @*Email list*@
                            <partial name="~/Views/NewStudy/EditStudy/Emaillist.cshtml" />
                        </div>
                    </div>
                </div>
                <div>
                    <div id="tabstripChild3">
                        <ul>
                            <li id="milestones">
                                Milestones
                            </li>
                            <li id="patientaccrual">
                                Patient Accrual
                            </li>
                            <li id="invoices">
                                Invoices
                            </li>
                            <li id="contractstimeline">
                                Contracts Timeline
                            </li>
                            <li id="status">
                                Status
                            </li>
                        </ul>
                        <div>
                            @*Milestones*@
                            <partial name="~/Views/NewStudy/EditStudy/Milestones.cshtml" />
                        </div>
                        <div>
                            @*Patient Accrual*@
                            <partial name="~/Views/NewStudy/EditStudy/PatientAccrual.cshtml" />
                        </div>
                        <div>
                            @*Invoices*@
                            <partial name="~/Views/NewStudy/EditStudy/Invoices.cshtml" />
                        </div>
                        <div>
                            @*Contracts Timeline*@
                            <partial name="~/Views/NewStudy/EditStudy/ContractsTimeline.cshtml" />
                        </div>
                        <div>
                            @*Status*@
                            <partial name="~/Views/NewStudy/EditStudy/Status.cshtml" />
                        </div>
                    </div>
                </div>
                <div>
                    <div id="tabstripChild4">
                        <ul>
                            <li id="reviewsandnotes">
                                Reviews and Notes
                            </li>
                            <li id="documents">
                                Documents
                            </li>
                            <li id="submissions">
                                Submissions
                            </li>
                            <li id="otherattributes">
                                Other Attributes
                            </li>
                            <li id="relatedusers">
                                Related Users
                            </li>
                        </ul>
                        <div>
                            @*Reviews and Notes*@
                            <partial name="~/Views/NewStudy/EditStudy/ReviewsandNotes.cshtml" />
                        </div>
                        @*Documents*@
                        <div id="testId"></div>
                        <div id="SubmissionsforEditStudy"></div>
                        <div>
                            @*Other Attributes*@
                            <partial name="~/Views/NewStudy/EditStudy/OtherAttributes.cshtml" />
                        </div>
                        <div>
                            @*Related Users*@
                            <partial name="~/Views/NewStudy/EditStudy/RelatedUsers.cshtml" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div>
        <partial name="~/Views/Common/CancelDialogBox.cshtml" />
        <partial name="~/Views/Common/DeleteRecordDialogBox.cshtml" />
    </div>
</form>
@*</div>*@
<script>


    var deleteMsg = '@Messages.DELETEMESSAGETITLEBOX';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';

    //#region Common functionalities
    function Print() {
        window.print();
    }

    $("textarea[maxlength]").keyup(function() {
            var charLength = $(this).val().length;
            var charLimit = $(this).attr("maxlength");
            $(this).nextAll("span.count").html(charLimit - charLength + " Characters left to enter");
        });
    $("input[maxlength]").keyup(function() {
            var charLength = $(this).val().length;
            var charLimit = $(this).attr("maxlength");
            $(this).nextAll("span.count").html(charLimit - charLength + " Characters left to enter");
        });

    function InputBoxTextdetails(response, section, label, image, sessionstorageid, textid, charsleft, regexval, validationmsg)
    {
        if (response[i].IsViewable == '' || response[i].IsViewable == null)
            $('#'+section).hide();
        else {
            if ($('#UserType').val() == "@ConstDefaultValue.IISADMIN" || $('#UserType').val() == "@ConstDefaultValue.TRIALLEADER")
            {
                if (response[i].RestrictViewUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictViewUser == "@ConstDefaultValue.TRIALLEADER")
                     $('#'+section).hide();
                else {
                    $('#' + section).show();
                    if(response[i].DisplayOrder != null)
                        document.getElementById(section).style.order = response[i].DisplayOrder;
                    $('#' + label).html(response[i].Name);
                    if (response[i].HelpText == '' || response[i].HelpText == null)
                        $('#' + image).hide();
                    else
                        $('#' + image).show().attr('title', response[i].HelpText);
                    if (response[i].Size == 'Small')
                        $('#' + textid).show().attr('maxlength', response[i].ColumnWidth);
                     else
                        $('#' + textid).hide();
                    if (response[i].RestrictEditUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictEditUser == "@ConstDefaultValue.TRIALLEADER")
                        $('#'+section).css({pointerEvents:'none'});
                    else
                    {
                        if (response[i].IsMandatory == '' || response[i].IsMandatory == null) {
                            $('#' + label).removeClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, false);
                        } else {
                            $('#' + label).addClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, true);
                        }
                        $('#' + regexval).val(response[i].RegexExpression);
                        $('#' + validationmsg).val(response[i].ValidationMessage);
                    }
                    $('#' + charsleft).html(response[i].ColumnWidth + '@ConstDefaultValue.CHARACTERSLEFTTOENTER');
                }
            }
        }
    }

    function Textdetails(response, section, label, image, sessionstorageid, textid, textareaid, charsleft, regexval, validationmsg)
    {
        if (response[i].IsViewable == '' || response[i].IsViewable == null)
            $('#'+section).hide();
        else {
            if ($('#UserType').val() == "@ConstDefaultValue.IISADMIN" || $('#UserType').val() == "@ConstDefaultValue.TRIALLEADER")
            {
                if (response[i].RestrictViewUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictViewUser == "@ConstDefaultValue.TRIALLEADER")
                     $('#'+section).hide();
                else {
                    $('#' + section).show();
                    if(response[i].DisplayOrder != null)
                        document.getElementById(section).style.order = response[i].DisplayOrder;
                    $('#' + label).html(response[i].Name);
                    if (response[i].HelpText == '' || response[i].HelpText == null)
                        $('#' + image).hide();
                    else
                        $('#' + image).show().attr('title', response[i].HelpText);
                    if (response[i].Size == 'Small') {
                        $('#' + textid).show().attr('maxlength', response[i].ColumnWidth);
                        $('#' + textareaid).hide();
                    } else {
                        $('#' + textid).hide();
                        $('#' + textareaid).show().attr('maxlength', response[i].ColumnWidth);
                    }
                    if (response[i].RestrictEditUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictEditUser == "@ConstDefaultValue.TRIALLEADER")
                        $('#'+section).css({pointerEvents:'none'});
                    else
                    {
                        if (response[i].IsMandatory == '' || response[i].IsMandatory == null) {
                            $('#' + label).removeClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, false);
                        } else {
                            $('#' + label).addClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, true);
                        }
                        $('#' + regexval).val(response[i].RegexExpression);
                        $('#' + validationmsg).val(response[i].ValidationMessage);
                    }
                    $('#' + charsleft).html(response[i].ColumnWidth + '@ConstDefaultValue.CHARACTERSLEFTTOENTER');
                }
            }
        }
    }

    function NumberFielddetails(response, section, label, image, sessionstorageid, textid)
    {
        if (response[i].IsViewable == '' || response[i].IsViewable == null)
            $('#'+section).hide();
        else {
            if ($('#UserType').val() == "@ConstDefaultValue.IISADMIN" || $('#UserType').val() == "@ConstDefaultValue.TRIALLEADER" )
            {
                if (response[i].RestrictViewUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictViewUser == "@ConstDefaultValue.TRIALLEADER")
                     $('#'+section).hide();
                else {
                    $('#' + section).show();
                    if(response[i].DisplayOrder != null && document.getElementById(section) != null)
                        document.getElementById(section).style.order = response[i].DisplayOrder;
                    $('#' + label).html(response[i].Name);
                    if (response[i].HelpText == '' || response[i].HelpText == null)
                        $('#' + image).hide();
                    else
                        $('#' + image).show().attr('title', response[i].HelpText);
                    if (response[i].Size == 'Small')
                        $('#' + textid).show().attr('maxlength', response[i].ColumnWidth);
                     else
                        $('#' + textid).hide();
                    if (response[i].RestrictEditUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictEditUser == "@ConstDefaultValue.TRIALLEADER")
                        $('#'+section).css({pointerEvents:'none'});
                    else
                    {
                        if (response[i].IsMandatory == '' || response[i].IsMandatory == null) {
                            $('#' + label).removeClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, false);
                        } else {
                            $('#' + label).addClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, true);
                        }
                    }
                }
            }
        }
    }

    function DropDowndetails(response, section, label, image, sessionstorageid)
    {
        if (response[i].IsViewable == '' || response[i].IsViewable == null)
            $('#'+section).hide();
        else {
            if ($('#UserType').val() == "@ConstDefaultValue.IISADMIN" || $('#UserType').val() == "@ConstDefaultValue.TRIALLEADER")
            {
                if (response[i].RestrictViewUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictViewUser == "@ConstDefaultValue.TRIALLEADER")
                    $('#' + section).hide();
                else {
                    $('#' + section).show();
                    if(response[i].DisplayOrder != null && document.getElementById(section) != null)
                        document.getElementById(section).style.order = response[i].DisplayOrder;
                    $('#' + label).html(response[i].Name);
                    if (response[i].HelpText == '' || response[i].HelpText == null)
                        $('#' + image).hide();
                    else
                        $('#' + image).show().attr('title', response[i].HelpText);
                    if (response[i].RestrictEditUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictEditUser == "@ConstDefaultValue.TRIALLEADER")
                        $('#' + section).css({ pointerEvents: 'none' });
                    else
                    {
                        if (response[i].IsMandatory == '' || response[i].IsMandatory == null) {
                            $('#' + label).removeClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, false);
                        } else {
                            $('#' + label).addClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, true);
                        }
                    }
                }
            }
        }
    }

    function Label(response, section, label, image, sessionstorageid)
    {
        if (response[i].IsViewable == '' || response[i].IsViewable == null)
            $('#'+section).hide();
        else {
            if ($('#UserType').val() == "@ConstDefaultValue.IISADMIN" || $('#UserType').val() == "@ConstDefaultValue.TRIALLEADER")
            {
                if (response[i].RestrictViewUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictViewUser == "@ConstDefaultValue.TRIALLEADER")
                     $('#'+section).hide();
                else {
                    $('#' + section).show();
                    if(response[i].DisplayOrder != null)
                        document.getElementById(section).style.order = response[i].DisplayOrder;
                    $('#' + label).html(response[i].Name);
                    if (response[i].HelpText == '' || response[i].HelpText == null)
