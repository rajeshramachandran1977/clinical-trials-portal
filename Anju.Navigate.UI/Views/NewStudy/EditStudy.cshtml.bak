@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@{
    ViewData["Title"] = "Edit Study";
    Layout = "~/Views/Shared/_Site.cshtml";
}
@using Anju.Navigate.Utilities;
<link rel="stylesheet" href="~/css/navigateStyles.css" />

@*<div class="container-fluid">*@
<form role="form" id="ui_frmEditStudy" class="frmNewSubFormcontainer col-md-12 shadow-lg" action="" method="post">
    <span id="popupNotification"></span>
    <input type="hidden" value="@ViewBag.StudyId" id="StudyId" />
    <input type="hidden" value="@ViewBag.StudyType" id="StudyType" />
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <input type="hidden" value="@ViewBag.Username" id="Username" />
    <input type="hidden" id="isvalidRegEx" />

    <div class="card mb-1 studyHeaderColor">
        <table cellpadding="3" cellspacing="0" class="studyHeaderTable">
            <tbody>
                <tr class="studyHeader" valign="top">
                    <td valign="top" class="wid_20">
                        <label class="ui_label">Study Number: </label>
                        <label class="ui_modal">@ViewBag.StudyId</label>
                    </td>
                    <td valign="top" class="wid_25">
                        <label class="ui_label">Investigator: </label>
                        <label class="ui_modal">@ViewBag.StudyOwner</label>
                    </td>
                    <td valign="top" class="wid_25">
                        <label class="ui_label">Study Title: </label>
                        <label class="ui_modal">@ViewBag.studyName</label>
                    </td>
                    <td valign="top" class="wid_30">
                        <label class="ui_label">Stage: </label>
                        <label class="ui_modal">@ViewBag.Stage</label><br>
                        <label class="ui_label">State: </label>
                        <label class="ui_modal">@ViewBag.State</label><br>
                        <label class="ui_label">Status: </label>
                        <label class="ui_modal">@ViewBag.Status</label><br>

                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="row ml-0">
        <div class="col-md-12 p-md-0">
            <div id="tabstripRoot">
                <ul class="noprint">
                    <li>
                        Scientific Rationale
                    </li>
                    <li>
                        Personnel Sites & Support
                    </li>
                    <li>
                        Tracking
                    </li>
                    <li>
                        General Details
                    </li>
                </ul>
                <div>
                    <div id="tabstripChild1">
                        <ul class="noprint">
                            <li id="sciencemain">
                                Science Main
                            </li>
                            <li id="diseasestates">
                                Disease States
                            </li>
                            <li id="cohortlevels">
                                Cohort Levels
                            </li>
                            <li id="treatmentinformation">
                                Treatment Information
                            </li>
                            <li id="correlativescience">
                                Correlative Science
                            </li>
                            <li id="studycoumpounds">
                                Study Compounds
                            </li>
                            <li id="indications">
                                Indications
                            </li>
                            <li id="objectives">
                                Objectives
                            </li>
                            <li id="pharmacovigilance">
                                Pharmacovigilance
                            </li>
                            <li id="studyenrollmentandtimelines">
                                Study Enrollment & Timelines
                            </li>
                            <li id="IRBRequirement">
                                IRB Requirement
                            </li>
                            <li id="Pandemicpreparednesstrialcategorization">
                                Pandemic Preparedness Trial Categorization
                            </li>
                            <li id="Regulatoryrequirements">
                                Regulatory Requirements
                            </li>
                            <li id="studyprotocolnumbers">
                                Study / Protocol Number(s)
                            </li>
                            <li id="keyreferences">
                                Key References
                            </li>
                        </ul>
                        @*Science Main*@
                        <partial name="~/Views/NewStudy/EditStudy/ScienceMain.cshtml" />
                        @*Disease States*@
                        <partial name="~/Views/NewStudy/EditStudy/Diseases.cshtml" />
                        @*Cohort Levels*@
                        <partial name="~/Views/NewStudy/EditStudy/CohortLevels.cshtml" />
                        @*Treatment Information*@
                        <partial name="~/Views/NewStudy/EditStudy/TreatmentInformation.cshtml" />
                        @*Correlative Sciences*@
                        <partial name="~/Views/NewStudy/EditStudy/CorrelativeSciences.cshtml" />
                        @*Study Coumpounds*@
                        <partial name="~/Views/NewStudy/EditStudy/StudyCoumpounds.cshtml" />
                        @*Indications*@
                        <partial name="~/Views/NewStudy/EditStudy/Indications.cshtml" />
                        @*Objectives and Endpoints*@
                        <partial name="~/Views/NewStudy/EditStudy/ObjectivesandEndpoints.cshtml" />
                        @*Pharmacovigilance*@
                        <partial name="~/Views/NewStudy/EditStudy/Pharmacovigilance.cshtml" />
                        @*Study Enrollment & Timelines*@
                        <partial name="~/Views/NewStudy/EditStudy/StudyEnrollmentandTimelines.cshtml" />
                        @*IRB Requirement*@
                        <partial name="~/Views/NewStudy/EditStudy/IRBRequirement.cshtml" />
                        @*Pandemic Preparedness Trial Categorization*@
                        <partial name="~/Views/NewStudy/EditStudy/PandemicPreparednessTrialCategorization.cshtml" />
                        @*Regulatory Requirements*@
                        <partial name="~/Views/NewStudy/EditStudy/RegulatoryRequirements.cshtml" />
                        @*Study / Protocol Number(s)*@
                        <partial name="~/Views/NewStudy/EditStudy/StudyProtocolNumbers.cshtml" />
                        @*Key References*@
                        <partial name="~/Views/NewStudy/EditStudy/KeyReferences.cshtml" />
                    </div>
                </div>
                <div>
                    <div id="tabstripChild2">
                        <ul>
                            <li id="contacts">
                                Contacts
                            </li>
                            <li id="investigatorqualifications">
                                Investigator Qualifications
                            </li>
                            <li>
                                Sites
                            </li>
                            <li id="researchgroupdescription">
                                Research Group Description
                            </li>
                            <li id="originalfinancialrequest">
                                Original Financial Request
                            </li>
                            <li id="emailList">
                                Email List
                            </li>
                        </ul>
                        <div>
                            @*Contacts*@
                            <partial name="~/Views/NewStudy/EditStudy/Contacts.cshtml" />
                        </div>
                        <div>
                            @*Investigator Qualifications*@
                            <partial name="~/Views/NewStudy/EditStudy/InvestigatorQualifications.cshtml" />
                        </div>
                        <div>
                            @*Sites*@
                            <partial name="~/Views/NewStudy/EditStudy/Sites.cshtml" />
                            @*<div>Content of Tab 2.3</div>*@
