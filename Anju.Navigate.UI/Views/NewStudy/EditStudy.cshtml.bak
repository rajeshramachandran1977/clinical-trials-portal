    function ValidateDocumentsFields() {
        $(".error").remove();
        retval = true;
        objDocuments = new Object();
        objDocuments.StudyId = $('#StudyId').val();
        objDocuments.DocumentId = $('#ui_num_documentid').val();

        if ($("#uploadfiles").closest(".k-upload").find(".k-file").length <= 0)
        {
            $('#documentname').after('<div class="error errorBackground"></span>' + $('#ui_lbl_documentname').html() + ' is required</div>');
            retval = false;
        }
        if ($('#ui_ddl_documentStatus').val() === 'Select' || $('#ui_ddl_documentStatus').val() === "") {
            $('#documentstatus').after('<div class="error errorBackground"><span class="k-icon k-i-warning"></span>' + $('#ui_lbl_documentstatus').html() + ' is required</div>');
            retval = false;
        }
        if ($('#ui_ddl_amendmentVersion').val() === 'Select' || $('#ui_ddl_amendmentVersion').val() === "") {
            $('#amendmentversion').after('<div class="error errorBackground"><span class="k-icon k-i-warning"></span>' + $('#ui_lbl_amendmentversion').html() + ' is required</div>');
            retval = false;
        }
        if ($('#ui_ddl_documentType').val() === 'Select' || $('#ui_ddl_documentType').val() === "") {
            $('#documenttype').after('<div class="error errorBackground"><span class="k-icon k-i-warning"></span>' + $('#ui_lbl_documenttype').html() + ' is required</div>');
            retval = false;
        }
    }

    function ValidateDocumentsFieldsEditMode() {
        $(".error").remove();
        retval = true;
        objDocuments = new Object();
        objDocuments.StudyId = $('#StudyId').val();
        objDocuments.DocumentId = $('#ui_num_documentideditmode').val();

        if ($("#uploadfileseditmode").closest(".k-upload").find(".k-file").length <= 0)
        {
            $('#documentnameeditmode').after('<div class="error errorBackground"></span>' + $('#ui_lbl_documentnameeditmode').html() + ' is required</div>');
            retval = false;
        }
        if ($('#ui_ddl_editdocumentStatus').val() === 'Select' || $('#ui_ddl_editdocumentStatus').val() === "") {
            $('#documentstatuseditmode').after('<div class="error errorBackground"><span class="k-icon k-i-warning"></span>' + $('#ui_lbl_documentstatuseditmode').html() + ' is required</div>');
            retval = false;
        }
        if ($('#ui_ddl_editamendmentVersion').val() === 'Select' || $('#ui_ddl_editamendmentVersion').val() === "") {
            $('#amendmentversioneditmode').after('<div class="error errorBackground"><span class="k-icon k-i-warning"></span>' + $('#ui_lbl_amendmentversioneditmode').html() + ' is required</div>');
