    var wnd;
    $(document).ready(function () {
        wnd = $("#modalWindow").kendoWindow({
            title: "@Messages.DELETEMESSAGETITLEBOX",
            modal: true,
            visible: false,
            resizable: false,
            width: 400
        }).data("kendoWindow");
    });

    function onCancel() {
        $("#Cohortlevels").data("kendoWindow").close();
        $("#TreatmentInformation").data("kendoWindow").close();
        $("#StudyCompounds").data("kendoWindow").close();
        $("#Contacts").data("kendoWindow").close();
        $("#Indications").data("kendoWindow").close();
        $("#ObjectivesandEndpoints").data("kendoWindow").close();
        $("#Studyprotocols").data("kendoWindow").close();
        $("#EmailLists").data("kendoWindow").close();
        $("#Sites").data("kendoWindow").close();
        $("#Milestones").data("kendoWindow").close();
        $("#Patientaccrual").data("kendoWindow").close();
        $("#Invoices").data("kendoWindow").close();
        $("#Contractstimeline").data("kendoWindow").close();
        $("#Status").data("kendoWindow").close();
        $("#ReviewsandNotes").data("kendoWindow").close();
        $("#Documents").data("kendoWindow").close();
        $("#addNotificationDocModal").modal("hide");
        $("#Submissions").data("kendoWindow").close();
    }

    function StudyDetailsID() {
        return {
            studyId: $('#StudyId').val()
        };
    }

    function filterStates() {
        return {
            countryId: $("#ui_ddl_country").val()
        };
    }

    function filterCities() {
        return {
            stateId: $("#ui_ddl_state").val()
        };
    }

    function Savedetails(type, objEditstudy, mode) {
        var params = {
             async: true,
            type: "POST",
            cache: false,
            dataType: "json",
            success: function (response) {
                if (response.msgType == 'Success') {
                    popupNotification.show('@Messages.ATTRIBUTEUPDATEDSUCCESSFULLY', "success");
                    $("#ui_dtg_gridCohortLevels").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_gridCohortLevels").data("kendoGrid").refresh();
                    $("#Cohortlevels").data("kendoWindow").close();
                    $("#ui_dtg_gridTreatmentInformation").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_gridTreatmentInformation").data("kendoGrid").refresh();
                    $("#TreatmentInformation").data("kendoWindow").close();
                    $("#ui_dtg_gridstudycompounds").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_gridstudycompounds").data("kendoGrid").refresh();
                    $("#StudyCompounds").data("kendoWindow").close();
                    $("#ui_dtg_gridindications").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_gridindications").data("kendoGrid").refresh();
                    $("#Indications").data("kendoWindow").close();
                    $("#ui_dtg_gridObjectivesandEndpoints").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_gridObjectivesandEndpoints").data("kendoGrid").refresh();
                    $("#ObjectivesandEndpoints").data("kendoWindow").close();
                    $("#ui_dtg_gridstudyprotocol").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_gridstudyprotocol").data("kendoGrid").refresh();
                    $("#Studyprotocols").data("kendoWindow").close();
                    $("#ui_dtg_Contacts").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_Contacts").data("kendoGrid").refresh();
                    $("#Contacts").data("kendoWindow").close();
                    $("#ui_dtg_studysites").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_studysites").data("kendoGrid").refresh();
                    $("#Sites").data("kendoWindow").close();
                    $("#ui_dtg_gridEmailList").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_gridEmailList").data("kendoGrid").refresh();
                    $("#EmailLists").data("kendoWindow").close();
                    $("#ui_dtg_Milestones").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_Milestones").data("kendoGrid").refresh();
                    $("#Milestones").data("kendoWindow").close();
                    $("#ui_dtg_Patientaccrual").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_Patientaccrual").data("kendoGrid").refresh();
                    $("#Patientaccrual").data("kendoWindow").close();
                    $("#ui_dtg_Invoices").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_Invoices").data("kendoGrid").refresh();
                    $("#Invoices").data("kendoWindow").close();
                    $("#ui_dtg_ContractsTimeline").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_ContractsTimeline").data("kendoGrid").refresh();
                    $("#Contractstimeline").data("kendoWindow").close();
                    $("#ui_dtg_Status").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_Status").data("kendoGrid").refresh();
                    $("#Status").data("kendoWindow").close();
                    $("#ui_dtg_ReviewsandNotes").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_ReviewsandNotes").data("kendoGrid").refresh();
                    $("#ReviewsandNotes").data("kendoWindow").close();
                    $("#ui_dtg_Documents").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_Documents").data("kendoGrid").refresh();
                    $("#Documents").data("kendoWindow").close();
                    $("#ui_dtg_Submissions").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_Submissions").data("kendoGrid").refresh();
                    $("#Submissions").data("kendoWindow").close();
                    $("#ui_dtg_Users").data("kendoGrid").dataSource.read();
                    $("#ui_dtg_Users").data("kendoGrid").refresh();
                    $("#RelatedUsers").data("kendoWindow").close();
                }

                    else
                        popupNotification.show("There are errors on the page. Please correct them to continue.", "error");
                },
                failure: function (response) {
                    popupNotification.show("There are errors on the page. Please correct them to continue.", "error");

        },
        };
        params.url = "/NewStudy/SaveUpdateEditdetails/";
        params.data = { "objEditstudy": objEditstudy,"type": type,"mode": mode};
        $.ajax(params);
    }

    $(function () {
        var validator = $("#ui_frmEditStudy").kendoValidator().data("kendoValidator");

        //#region Remove err msg on key up for non grid text fields
        $("#ui_txt_safetycriteria,#ui_txt_indication,#ui_txt_correlativescienceatcompanysite, \
        #ui_txt_correlativescienceatstudysite,#ui_txt_correlativesciencesamplingdet,\
        #ui_txt_noofpatients,#ui_txtarea_noofpatients,#enrollmentrate,#recruitmentEnd, \
        #noOfPatients,#studyduration,#impactPatientAcrual,#enrollmentHistory, \
        #noofpatientspertreatmentgroup,#ui_txtarea_rationaleForINDExemption, \
        #ui_txt_keyreferences,#studystart").on("keyup", function (e) {
            $(this).next("div.error").remove();
        })

        $('#ui_ddl_correlativeScience,#ui_dt_trialStart,#completionoffinalstudyreport,#trialEnd,#primaryPublication, \
           #aretherecompetingstudiesatyourinstitution,#organization,#isinspectedbytheFDA,#isFDAissuedaFDA483form,\
           #cooperativegroupstudy').change(function () {
            $(this).next("div.error").remove();
        }).change();
        //#endregion

        function Savedetails(type, objEditstudy) {
            var params = {
                type: "POST",
                cache: false,
                dataType: "json",
                success: function (response) {
                        if (response.msgType == 'Success')
                                   popupNotification.show('@Messages.ATTRIBUTEUPDATEDSUCCESSFULLY', "success");
                        else
                            popupNotification.show("There are errors on the page. Please correct them to continue.", "error");
                    },
                    failure: function (response) {
                        popupNotification.show("There are errors on the page. Please correct them to continue.", "error");

            },
            };
            params.url = "/NewStudy/SaveUpdateEditdetails/";
            params.data = { "objEditstudy": objEditstudy,"type": type};
            $.ajax(params);
        }
});

