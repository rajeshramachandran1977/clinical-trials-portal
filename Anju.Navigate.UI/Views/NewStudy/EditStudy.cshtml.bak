    function CheckBoxdetails(response, section, label, image, sessionstorageid)
    {
        if (response[i].IsViewable == '' || response[i].IsViewable == null)
            $('#'+section).hide();
        else {
            if ($('#UserType').val() == "@ConstDefaultValue.IISADMIN" || $('#UserType').val() == "@ConstDefaultValue.TRIALLEADER")
            {
                if (response[i].RestrictViewUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictViewUser == "@ConstDefaultValue.TRIALLEADER")
                    $('#' + section).hide();
                else {
                    $('#' + section).show();
                    if(response[i].DisplayOrder != null)
                        document.getElementById(section).style.order = response[i].DisplayOrder;
                    $('#' + label).html(response[i].Name);
                    if (response[i].HelpText == '' || response[i].HelpText == null)
                        $('#' + image).hide();
                    else
                        $('#' + image).show().attr('title', response[i].HelpText);
                    if (response[i].RestrictEditUser == "@ConstDefaultValue.IISADMIN" || response[i].RestrictEditUser == "@ConstDefaultValue.TRIALLEADER")
                        $('#' + section).css({ pointerEvents: 'none' });
                    else
                    {
                        if (response[i].IsMandatory == '' || response[i].IsMandatory == null) {
                            $('#' + label).removeClass("mandatory");
                            sessionStorage.setItem(sessionstorageid, false);
