    }

     //#region delete row functions in grids
    function deleteDocuments(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        $(document).ready(function () {
            wnd = $("#modalWindow").kendoWindow({
                title: deleteMsg,
                modal: true,
                visible: false,
                resizable: false,
                width: 400
            }).data("kendoWindow");
        });
        var grid = $("#ui_dtg_Documents").data("kendoGrid"); //Get the grid from which the pop-up is coming
        var tr = $(e.target).closest("tr"); //get the row for deletion
        var data = this.dataItem(tr);
        wnd.center().open();

        $("#ui_btn_yes").click(function () {
            grid.dataSource.remove(data);
            grid.dataSource.sync();
            wnd.close();
        });
        $("#ui_btn_no").click(function () {
            wnd.close();
        });
    }
    //#endregion

    function onUpload(e) {
    e.data = {};
    e.data["additional[0]"] = $("#uploadfiles").val();
    e.data["additional[1]"] = $('#ui_ddl_documentStatus').val();
    e.data["additional[2]"] = $('#ui_ddl_amendmentVersion').val();
    e.data["additional[3]"] = $('#ui_ddl_documentType').data("kendoDropDownList").text();
    e.data["additional[4]"] = $('#ui_ddl_documentSubType').val();
    e.data["additional[5]"] = "Manual";
    e.data["additional[6]"] = $("#ui_lbl_uploadedperson").val();
    e.data["additional[7]"] = $("#ui_lbl_uploadeddate").val();
    e.data["additional[8]"] = $('#ui_dt_originalDate').val() !== '' ? $('#ui_dt_originalDate').val() : ' ';
    e.data["additional[9]"] = $('#ui_dt_expirationDate').val() !== '' ? $('#ui_dt_expirationDate').val() : ' ';

    }

    function onUploadEditMode(e) {
        e.data = {};
        e.data["additionalEditmode[10]"] = $("#ui_num_documentideditmode").val();
        e.data["additionalEditmode[0]"] = $("#uploadfileseditmode").val();
        e.data["additionalEditmode[1]"] = $('#ui_ddl_editdocumentStatus').val();
        e.data["additionalEditmode[2]"] = $('#ui_ddl_editamendmentVersion').val();
        e.data["additionalEditmode[3]"] = $('#ui_ddl_editdocumentType').data("kendoDropDownList").text();
        e.data["additionalEditmode[4]"] = $('#ui_ddl_editdocumentSubType').val();
        e.data["additionalEditmode[5]"] = "Manual";
        e.data["additionalEditmode[6]"] = $("#ui_lbl_uploadedpersoneditmode").val();
        e.data["additionalEditmode[7]"] = $("#ui_lbl_uploadeddateeditmode").val();
        e.data["additionalEditmode[8]"] = $('#ui_dt_editeditoriginalDate').val() !== '' ? $('#ui_dt_editeditoriginalDate').val() : ' ';
        e.data["additionalEditmode[9]"] = $('#ui_dt_editeditexpirationDate').val() !== '' ? $('#ui_dt_editeditexpirationDate').val() : ' ';

    }

    function showDocuments(e) {

         $(".k-upload-files").remove();
         $(".k-upload-status").remove();
         $(".k-upload.k-header").addClass("k-upload-empty");
         $(".k-upload-button").removeClass("k-state-focused");
         $("#ui_frm_documents")[0].reset();

        var documentstemplate = kendo.template($("#documentstemplate").html());
        var grid = $("#ui_dtg_Documents").getKendoGrid();
        var wnd = $("#Documents").data("kendoWindow");
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));
        wnd.content(documentstemplate(dataItem));
        wnd.center().open();

        LoadDocumentsAttributesEditMode();

        $.ajax({
        async: true,
        type: "GET",
        url: "/NewStudy/Documents/",
        data:  { "mode": "Edit","docid": parseInt(dataItem.DocumentId) },
         success: function (response) {
             $('#testId').html(response);
        },
        failure: function (response) {
            popupNotification.show(errorsinthepage, "error");
        }
        });

         //

        //Fill document window
        var retVal = true;

        $('#ui_num_documentideditmode').val(dataItem.DocumentId);
        $("#ui_ddl_editamendmentVersion").data('kendoDropDownList').value(dataItem.DocumentVersion);
        $("#ui_ddl_editdocumentStatus").data('kendoDropDownList').value(dataItem.DocumentStatus);
        $("#ui_ddl_editdocumentType").data('kendoDropDownList').value(dataItem.DocumentType);
        $("#ui_ddl_editdocumentSubType").data('kendoDropDownList').value(dataItem.DocumentSubType);
        $("#ui_lbl_editdocumentsource").html(dataItem.SubModuleName);
        $("#ui_lbl_uploadedpersoneditmode").html(dataItem.ANJU_AddedBy);
        $("#ui_lbl_uploadeddateeditmode").html(kendo.toString(kendo.parseDate(dataItem.Anju_AddedDate), 'MMM dd, yyyy'));
        $("#ui_dt_editeditoriginalDate").data("kendoDatePicker").value(dataItem.OriginalDate);
        $("#ui_dt_editeditexpirationDate").data("kendoDatePicker").value(dataItem.ExpirationDate);

        var fileName = dataItem.DocumentNameWithOutExtension + dataItem.DocumentExtension;
        var DocumentNameWithOutExtension = dataItem.DocumentNameWithOutExtension;
        var DocumentExtension = dataItem.DocumentExtension;
        var subModuleFolderName = dataItem.SubModuleName;
        var studyId = dataItem.StudyId;
        var documentId = dataItem.DocumentId;

        $('.fileDownload').click(function () {
            window.location = "/NewStudy/DownloadFiles?fileName=" + fileName + '&&subModuleFolderName=' + subModuleFolderName + '&&studyId=' + studyId;

        });

        var username = $('#Username').val();
        $("#ui_lbl_uploadedperson").html(username);
        $("#ui_lbl_uploadeddate").html(kendo.toString(kendo.parseDate(new Date()), 'MMM dd, yyyy'));

        $("#uploadfiles").change(function () {
             $('#documentname').next("div.error").remove();
        });
        $("#ui_ddl_documentStatus").change(function () {
            $('#documentstatus').next("div.error").remove();
        });
        $("#ui_ddl_amendmentVersion").change(function () {
            $('#amendmentversion').next("div.error").remove();
         });
        $("#ui_ddl_documentType").change(function () {
            $('#documenttype').next("div.error").remove();
        });

        $("#ui_btnSaveDocumentseditmode").click(function () {
            ValidateDocumentsFieldsEditMode();
            if (retval === true)
                 UpdateDcouemntDetails();
             else
                popupNotification.show(errorsinthepage, "error");
        });

        function UpdateDcouemntDetails() {
            if (retVal === true) {
                var upload = $("#uploadfileseditmode").data("kendoUpload"),
                files = upload.getFiles();
                objDocumentDetails = new Object();
                objDocumentDetails.DocumentId =  documentId;
                objDocumentDetails.StudyId = studyId;
                objDocumentDetails.SubModuleName = subModuleFolderName;
                objDocumentDetails.DocumentName = files[0].name;
                objDocumentDetails.DocumentNameWithOutExtension = DocumentNameWithOutExtension;
                objDocumentDetails.DocumentExtension = DocumentExtension;
                objDocumentDetails.DocumentStatus = $("#ui_ddl_editdocumentStatus").val();
                objDocumentDetails.DocumentType =  $("#ui_ddl_editdocumentType").val();
                objDocumentDetails.DocumentSubType = $("#ui_ddl_editdocumentSubType").val();
                objDocumentDetails.DocumentVersion = $("#ui_ddl_editamendmentVersion").val();
                objDocumentDetails.OriginalDate = $("#ui_dt_editeditoriginalDate").val();
                objDocumentDetails.ExpirationDate = $("#ui_dt_editeditexpirationDate").val();
                objDocumentDetails.Anju_ChangedBy = $("#ui_lbl_uploadedpersoneditmode").val();
                $.ajax({
                    async: false,
                    type: "POST",
                    url: "/TaskWorkFlow/UpdateDocumentDetails",
                    data: { "documents": objDocumentDetails },
                    success: function (results) {
                        if (results.msgType === "Success") {
                           $("#ui_dtg_Documents").data("kendoGrid").dataSource.read();
                           $("#ui_dtg_Documents").data("kendoGrid").refresh();
                           $("#Documents").data("kendoWindow").close();

                        }
                        else {
                            popupNotification.show(results.msgType, "error");
                        }
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        popupNotification.show('Error', "error");
                    }
                });
            }
            else {

                popupNotification.show(errorsinthepage, "error");
            }
        }

    }

