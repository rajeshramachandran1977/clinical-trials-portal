@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
@using Anju.Navigate.UI;
@model Anju.Navigate.Data.ListOfDocuments
<div class="overflowHidden" id="documentsdetails">
    <input type="hidden" value="@ViewBag.Username" id="Username" />
    <div class="row mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" data-target="#addNotificationDocModal" data-toggle="modal" onclick="addDocuments()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right mr-4 pr-1 noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        @(Html.Kendo().Grid<Anju.Navigate.Data.Documents>
        ()
        .Name("ui_dtg_Documents")
        .Columns(columns =>
        {
            columns.Bound(c => c.DocumentId).Hidden(true);
            columns.Bound(c => c.StudyId).Hidden(true);
            columns.Bound(c => c.DocumentName).Width("30%").Title("Document Name").ClientTemplate(" <a onclick='Show(this);' href=\\#>#= DocumentName#</a> ");
            columns.Bound(c => c.DocumentStatus).Width("30%").Title("Document Status");
            columns.Bound(c => c.DocumentVersion).Width("30%").Title("Original / Amendment Version");
            columns.Bound(c => c.DocumentType).Width("30%").Title("Document Type");
            columns.Bound(c => c.DocumentSubType).Width("30%").Title("Document Sub-Type");
            columns.Template(@ConstDefaultValue.MANUAL).Width("30%").Title("Document Source");
            columns.Bound(c => c.ANJU_AddedBy).Width("30%").Title("Uploaded By");
            columns.Bound(c => c.Anju_AddedDate).Width("30%").Title("Date of Upload").ClientTemplate("#= Anju_AddedDate ? kendo.toString(kendo.parseDate(Anju_AddedDate), 'MMM dd, yyyy') : '' #"); ;
            columns.Bound(c => c.OriginalDate).Width("30%").Title("Original Date").ClientTemplate("#= OriginalDate ? kendo.toString(kendo.parseDate(OriginalDate), 'MMM dd, yyyy') : '' #"); ;
            columns.Bound(c => c.ExpirationDate).Width("30%").Title("Expiration Date").ClientTemplate("#= ExpirationDate ? kendo.toString(kendo.parseDate(ExpirationDate), 'MMM dd, yyyy') : '' #"); ;
            columns.Command(command => command.Custom("Tag").Text("Edit").Click("showDocuments")).Width(80);
            columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteDocuments")).Width(80);
            })
            .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label mb-1" })
            .Scrollable()
            .Groupable(false)
            .Sortable()
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(10))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(p => p.DocumentId))
            .Read(read => read.Action("GetDocumentsByStudyID", "NewStudy").Data("additionalInfo"))
            .Destroy(update => update.Action("DeleteDocuments", "NewStudy"))
            ))
        @(Html.Kendo().Window()
        .Name("Documents")
        .Title("Documents")
        .Actions(actions => actions.Clear())
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(1000)
        )
    </div>
</div>

<script type="text/x-kendo-template" id="documentstemplate">
    <div id="details-container">
        <form id="ui_frm_documents">
            <span id="popupNotification"></span>
            <div class="card p-2">
                <div id="flex">
                    <input type="hidden" id="ui_num_documentideditmode" min="1" data-bind="value:ui_num_documentid" />
                    <div class="row">
                        <div id="displayDocumentnameeditmode" class="col-md-6">
                            <div id="documentnameeditmode">
                                <label class="col-formEditStudy-labels mandatory" id="ui_lbl_documentnameeditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumentnameeditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @if (Model != null)
                                    {
                                        @(Html.Kendo().Upload()
                                          .Name("uploadfileseditmode")
                                          .Multiple(false)
                                          .Async(a => a
                                          .Save("CreateUpdateDocumentsEditMode", "NewStudy")
                                          .Remove("RemoveLMRCFinalRejectedOrWithdrawalDocuments", "TaskWorkFlow")
                                          .AutoUpload(false)
                                          )
                                          .Files(files =>
                                          {
                                              foreach (var f in Model.TrialBudgetDocuments)
                                              {
                                                  files.Add().Name(f.DocumentName).Extension(f.DocumentExtension);
                                              }
                                          })
                                          .ToClientTemplate()
                                        )
                                    }
                                </div>
                            </div>
                        </div>
                        <div id="displaydocumentStatuseditmode" class="col-md-5">
                            <div id="documentstatuseditmode">
                                <label class="col-formEditStudy-labels" id="ui_lbl_documentstatuseditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumentstatuseditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                        .Name("ui_ddl_editdocumentStatus")
                                        .HtmlAttributes(new { @class = "wid_100" })
                                        .DataTextField("Code")
                                        .DataValueField("Code")
                                        .OptionLabel("Select")
                                        .DataSource(source =>
                                        {
                                        source.Read(read =>
                                        {
                                        read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTSTATUS });
                                        })
                                        .ServerFiltering(true);
                                        })
                                        .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayAmendmentversioneditmode" class="col-md-6">
                            <div id="amendmentversioneditmode">
                                <label class="col-formEditStudy-labels" id="ui_lbl_amendmentversioneditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforamendmentversioneditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                        .Name("ui_ddl_editamendmentVersion")
                                        .HtmlAttributes(new { @class = "wid_100" })
                                        .DataTextField("Code")
                                        .DataValueField("Code")
                                        .OptionLabel("Select")
                                        .DataSource(source =>
                                        {
                                        source.Read(read =>
                                        {
                                        read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTVERSION });
                                        })
                                        .ServerFiltering(true);
                                        })
                                        .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                        <div id="displayDocumenttypeeditmode" class="col-md-5">
                            <div id="documenttypeeditmode">
                                <label class="col-formEditStudy-labels" id="ui_lbl_documenttypeeditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumenttypeeditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_editdocumentType")
                                    .HtmlAttributes(new { @class = "wid_100" })
                                    .DataTextField("Code")
                                    .DataValueField("CodeId")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTTYPE });
                                    })
                                    .ServerFiltering(true);
                                    })
                                    .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayDocumentsubtypeeditmode" class="col-md-6">
                            <div id="documentsubtypeeditmode">
                                <label class="col-formEditStudy-labels " id="ui_lbl_documentsubtypeeditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumentsubtypeeditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                        .Name("ui_ddl_editdocumentSubType")
                                        .HtmlAttributes(new { @class = "wid_100" })
                                        .DataTextField("Code")
                                        .DataValueField("Code")
                                        .OptionLabel("Select")
                                        .DataSource(source =>
                                        {
                                        source.Read(read =>
                                        {
                                        read.Action("GetDocumentSubTypeByDocumentTypeID", "TaskWorkFlow").Data("filterEditDocumentSubTypeeditmode");
                                        })
                                        .ServerFiltering(true);
                                        })
                                        .CascadeFrom("ui_ddl_editdocumentType")
                                        .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                        <div id="displayDocumentsourceeditmode" class="col-md-5">
                            <div id="documentsourceeditmode">
                                <label class="col-formEditStudy-labels " id="ui_lbl_documentsourceeditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumentsourceeditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    <label class="col-formEditStudy-labels " id="ui_lbl_editdocumentsource"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayUploadedbyeditmode" class="col-md-6">
                            <div id="uploadedbyeditmode">
                                <div class="col-md-12 p-md-0">
                                    <img src="/Images/helppic.gif" id="ui_img_helpTextforuploadedbyeditmode" data-toggle="tooltip" />
                                    <label class="col-formEditStudy-labels" id="ui_lbl_uploadedbyeditmode"></label>
                                </div>
                                <div class="col-md-12 p-md-0">
                                    <label class="col-formEditStudy-labels" id="ui_lbl_uploadedpersoneditmode"></label>
                                </div>
                            </div>
                        </div>
                        <div id="displayDateofuploadeditmode" class="col-md-5">
                            <div id="dateofuploadeditmode">
                                <div class="col-md-12 p-md-0">
                                    <img src="/Images/helppic.gif" id="ui_img_helpTextfordateofuploadeditmode" data-toggle="tooltip" />
                                    <label class="col-formEditStudy-labels" id="ui_lbl_dateofuploadeditmode"></label>
                                </div>
                                <div class="col-md-12 p-md-0">
                                    <label class="col-formEditStudy-labels" id="ui_lbl_uploadeddateeditmode"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayOriginaldateeditmode" class="col-md-6">
                            <div id="originaldateeditmode">
                                <label class="col-formEditStudy-labels " id="ui_lbl_originaldateeditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfororiginaldateeditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DatePicker()
                                        .Name("ui_dt_editeditoriginalDate")
                                        .HtmlAttributes(new { title = "monthpicker" })
                                        .Start(CalendarView.Month)
                                        .Depth(CalendarView.Month)
                                        .Format("MMM dd, yyyy")
                                        .DateInput()
                                        .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                        <div id="displayExpirationdateeditmode" class="col-md-5">
                            <div id="expirationdateeditmode">
                                <label class="col-formEditStudy-labels " id="ui_lbl_expirationdateeditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforexpirationdateeditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DatePicker()
                                        .Name("ui_dt_editeditexpirationDate")
                                        .Start(CalendarView.Month)
                                        .Depth(CalendarView.Month)
                                        .Format("MMM dd, yyyy")
                                        .DateInput()
                                        .HtmlAttributes(new { title = "monthpicker" })
                                        .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer pt-2">
                <button type="button" class="btn btn-primary mr-1" onclick="showDialog();">Cancel</button>
                <button type="button" class="btn btn-primary mr-3" id="ui_btnSaveDocumentseditmode">Save</button>
            </div>
        </form>
    </div>
</script>

<div class="modal fade" id="addNotificationDocModal">
    <div class="modal-dialog" id="modalEditStudyDialog">
        <div class="modal-content">
            <form method="post" id="ui_frm_documents">
                <div id="details-container">
                    <span id="popupNotification"></span>
                    <div class="modal-body">
                        <div id="flex">
                            <input type="hidden" id="ui_num_documentid" min="1" data-bind="value:ui_num_documentid" />
                            <div class="row">
                                <div id="displayDocumentname" class="col-md-6">
                                    <div id="documentname">
                                        <label class="col-formEditStudy-labels" id="ui_lbl_documentname"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumentname" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().Upload()
                                            .Name("uploadfiles")
                                            .Multiple(false)
                                            .Async(a => a
                                            .Save("CreateUpdateDocumentsAddMode", "NewStudy")
                                            .Remove("DeleteDocuments", "NewStudy")
                                            .AutoUpload(false)
                                            )
                                            .Events(events => events
                                            .Upload("onUpload")
                                            )
                                            )
                                        </div>
                                    </div>
                                </div>
                                <div id="displaydocumentStatus" class="col-md-5">
                                    <div id="documentstatus">
                                        <label class="col-formEditStudy-labels" id="ui_lbl_documentstatus"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumentstatus" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DropDownList()
                                            .Name("ui_ddl_documentStatus")
                                            .HtmlAttributes(new { @class = "wid_100" })
                                            .DataTextField("Code")
                                            .DataValueField("Code")
                                            .OptionLabel("Select")
                                            .DataSource(source =>
                                            {
                                            source.Read(read =>
                                            {
                                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTSTATUS });
                                            })
                                            .ServerFiltering(true);
                                            })
                                            )
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div id="displayAmendmentversion" class="col-md-6">
                                    <div id="amendmentversion">
                                        <label class="col-formEditStudy-labels" id="ui_lbl_amendmentversion"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextforamendmentversion" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DropDownList()
                                            .Name("ui_ddl_amendmentVersion")
                                            .HtmlAttributes(new { @class = "wid_100" })
                                            .DataTextField("Code")
                                            .DataValueField("Code")
                                            .OptionLabel("Select")
                                            .DataSource(source =>
                                            {
                                            source.Read(read =>
                                            {
                                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTVERSION });
                                            })
                                            .ServerFiltering(true);
                                            })
                                            )
                                        </div>
                                    </div>
                                </div>
                                <div id="displayDocumenttype" class="col-md-5">
                                    <div id="documenttype">
                                        <label class="col-formEditStudy-labels" id="ui_lbl_documenttype"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumenttype" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DropDownList()
                                            .Name("ui_ddl_documentType")
                                            .HtmlAttributes(new { @class = "wid_100" })
                                            .DataTextField("Code")
                                            .DataValueField("CodeId")
                                            .OptionLabel("Select")
                                            .DataSource(source =>
                                            {
                                            source.Read(read =>
                                            {
                                            read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTTYPE });
                                            })
                                            .ServerFiltering(true);
                                            })
                                            )
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div id="displayDocumentsubtype" class="col-md-6">
                                    <div id="documentsubtype">
                                        <label class="col-formEditStudy-labels " id="ui_lbl_documentsubtype"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumentsubtype" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DropDownList()
                                            .Name("ui_ddl_documentSubType")
                                            .HtmlAttributes(new { @class = "wid_100" })
                                            .DataTextField("Code")
                                            .DataValueField("Code")
                                            .OptionLabel("Select")
                                            .DataSource(source =>
                                            {
                                            source.Read(read =>
                                            {
                                            read.Action("GetDocumentSubTypeByDocumentTypeID", "TaskWorkFlow").Data("filterEditDocumentSubType");
                                            })
                                            .ServerFiltering(true);
                                            })
                                            .CascadeFrom("ui_ddl_documentType")
                                            )
                                        </div>
                                    </div>
                                </div>
                                <div id="displayDocumentsource" class="col-md-5">
                                    <div id="documentsource">
                                        <label class="col-formEditStudy-labels " id="ui_lbl_documentsource"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextfordocumentsource" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @ConstDefaultValue.MANUAL
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div id="displayUploadedby" class="col-md-6">
                                    <div id="uploadedby">
                                        <div class="col-md-12 p-md-0">
                                            <img src="/Images/helppic.gif" id="ui_img_helpTextforuploadedby" data-toggle="tooltip" />
                                            <label class="col-formEditStudy-labels" id="ui_lbl_uploadedby"></label>
                                        </div>
                                        <div class="col-md-12 p-md-0">
                                            <label class="col-formEditStudy-labels" id="ui_lbl_uploadedperson"></label>
                                        </div>
                                    </div>
                                </div>
                                <div id="displayDateofupload" class="col-md-5">
                                    <div id="dateofupload">
                                        <div class="col-md-12 p-md-0">
                                            <img src="/Images/helppic.gif" id="ui_img_helpTextfordateofupload" data-toggle="tooltip" />
                                            <label class="col-formEditStudy-labels" id="ui_lbl_dateofupload"></label>
                                        </div>
                                        <div class="col-md-12 p-md-0">
                                            <label class="col-formEditStudy-labels" id="ui_lbl_uploadeddate"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div id="displayOriginaldate" class="col-md-6">
                                    <div id="originaldate">
                                        <label class="col-formEditStudy-labels " id="ui_lbl_originaldate"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextfororiginaldate" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DatePicker()
                                            .Name("ui_dt_originalDate")
                                            .HtmlAttributes(new { title = "monthpicker" })
                                            .Start(CalendarView.Month)
                                            .Depth(CalendarView.Month)
                                            .Format("MMM dd, yyyy")
                                            .DateInput()
                                            )
                                        </div>
                                    </div>
                                </div>
                                <div id="displayExpirationdate" class="col-md-5">
                                    <div id="expirationdate">
                                        <label class="col-formEditStudy-labels " id="ui_lbl_expirationdate"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextforexpirationdate" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DatePicker()
                                            .Name("ui_dt_expirationDate")
                                            .Start(CalendarView.Month)
                                            .Depth(CalendarView.Month)
                                            .Format("MMM dd, yyyy")
                                            .DateInput()
                                            .HtmlAttributes(new { title = "monthpicker" })
                                            )
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer p-1">
                        <button type="button" class="btn btn-primary" id="ui_btnSaveDocumentsaddmode">Save</button>
                        <button type="button" class="btn btn-primary mr-1" onclick="showDialog();">Cancel</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>

    //#region delete row functions in grids
    function deleteDocuments(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        $(document).ready(function () {
            wnd = $("#modalWindow").kendoWindow({
                title: deleteMsg,
                modal: true,
                visible: false,
                resizable: false,
                width: 400
            }).data("kendoWindow");
        });
        var grid = $("#ui_dtg_Documents").data("kendoGrid"); //Get the grid from which the pop-up is coming
        var tr = $(e.target).closest("tr"); //get the row for deletion
        var data = this.dataItem(tr);
        wnd.center().open();

        $("#ui_btn_yes").click(function () {
            grid.dataSource.remove(data);
            grid.dataSource.sync();
            wnd.close();
        });
        $("#ui_btn_no").click(function () {
            wnd.close();
        });
    }
    //#endregion

    $("#ui_btnSaveDocumentsaddmode").click(function () {
        ValidateDocumentsFields();
        if (retval === true) {
            $(".k-upload-selected").click();
            $("#addNotificationDocModal").modal("hide");
            $("#ui_dtg_Documents").data("kendoGrid").dataSource.read();
            $("#ui_dtg_Documents").data("kendoGrid").refresh();
        }
    });

    $("#ui_btnSaveDocumentseditmode").click(function () {
        ValidateDocumentsFieldsEditMode();
        if (retval === true) {
            $(".k-upload-selected").click();
            $("#Documents").data("kendoWindow").close();
            $("#ui_dtg_Documents").data("kendoGrid").dataSource.read();
            $("#ui_dtg_Documents").data("kendoGrid").refresh();
        }
    });

    function addDocuments() {
        var username = $('#Username').val();
        $("#ui_lbl_uploadedperson").html(username);
        $("#ui_lbl_uploadeddate").html(kendo.toString(kendo.parseDate(new Date()), 'MMM dd, yyyy'));

        $("#uploadfiles").change(function () {
             $('#documentname').next("div.error").remove();
        });
        $("#ui_ddl_documentStatus").change(function () {
            $('#documentstatus').next("div.error").remove();
        });
         $("#ui_ddl_amendmentVersion").change(function () {
            $('#amendmentversion').next("div.error").remove();
         });
        $("#ui_ddl_documentType").change(function () {
            $('#documenttype').next("div.error").remove();
        });

        LoadDocumentsAttributes();
    }

    function Show(e) {
        var gridRowData = $("#ui_dtg_Documents").data("kendoGrid");
        if (gridRowData) {
            var data = gridRowData.dataItem($(e).closest("tr"));
            var subModuleFolderName = data.SubModuleName;
            var fileName = data.DocumentNameWithOutExtension + data.DocumentExtension;
            window.location = "/NewStudy/DownloadFiles?fileName=" + fileName + '&&subModuleFolderName=' + subModuleFolderName + '&&studyId=' + $('#StudyId').val();
        }
    }

    function LoadDocumentsAttributes() {
      $.ajax({
        async: true,
        type: "POST",
        url: "/NewStudy/GetAttributeValues/",
        cache: false,
        dataType: "json",
        success: function (response) {
            if (response.Data == '') {
                popupNotification.show(errorsinthepage, "error");
            } else {
                for (i = 0; i < response.length; i++) {
                    //Control Titles,Display Help Text,Mandate Fields,Viewable or not
                    switch (response[i].FieldType) {
                        case "@ConstDefaultValue.DOCUMENT":
                            Label(response, "displayDocumentname", "ui_lbl_documentname", "ui_img_helpTextfordocumentname", "isdocumentname");
                            break;
                        case "@ConstDefaultValue.DOCUMENTSDOCSTATUS":
                            DropDowndetails(response, "displaydocumentStatus", "ui_lbl_documentstatus", "ui_img_helpTextfordocumentstatus", "isdocumentstatus");
                            break;
                        case "@ConstDefaultValue.DOCUMENTAMENDMENTVERSION":
                            DropDowndetails(response, "displayAmendmentversion", "ui_lbl_amendmentversion", "ui_img_helpTextforamendmentversion", "isamendmentversion");
                            break;
                        case "@ConstDefaultValue.DOCUMENTDOCTYPE":
                            DropDowndetails(response, "displayDocumenttype", "ui_lbl_documenttype", "ui_img_helpTextfordocumenttype", "isdocumenttype");
                            break;
                        case "@ConstDefaultValue.DOCUMENTDOCSUBTYPE":
                            DropDowndetails(response, "displayDocumentsubtype", "ui_lbl_documentsubtype", "ui_img_helpTextfordocumentsubtype", "isdocumentsubtype");
                            break;
                         case "@ConstDefaultValue.DOCUMENTSOURCE":
                            Label(response, "displayDocumentsource", "ui_lbl_documentsource", "ui_img_helpTextfordocumentsource", "isdocumentsource");
                            break;
                        case "@ConstDefaultValue.UPLOADEDBY":
                            Label(response, "displayUploadedby", "ui_lbl_uploadedby", "ui_img_helpTextforuploadedby", "isuploadedby");
                            break;
                        case "@ConstDefaultValue.DOCUMENTDATE":
                            DropDowndetails(response, "displayDateofupload", "ui_lbl_dateofupload", "ui_img_helpTextfordateofupload", "isdateofupload");
                            break;
                        case "@ConstDefaultValue.ORIGINALDATE":
                            DropDowndetails(response, "displayOriginaldate", "ui_lbl_originaldate", "ui_img_helpTextfororiginaldate", "isoriginaldate");
                            break;
                        case "@ConstDefaultValue.EXPIRATIONDATE":
                            DropDowndetails(response, "displayExpirationdate", "ui_lbl_expirationdate", "ui_img_helpTextforexpirationdate", "isexpirationdate");
                            break;
                        default:
                            break;
                    }
                }
            }
        },
        failure: function (response) {
            popupNotification.show(errorsinthepage, "error");
        }
    });
    }

    function LoadDocumentsAttributesEditMode() {
      $.ajax({
        async: true,
        type: "POST",
        url: "/NewStudy/GetAttributeValues/",
        cache: false,
        dataType: "json",
        success: function (response) {
            if (response.Data == '') {
                popupNotification.show(errorsinthepage, "error");
            } else {
                for (i = 0; i < response.length; i++) {
                    //Control Titles,Display Help Text,Mandate Fields,Viewable or not
                    switch (response[i].FieldType) {
                        case "@ConstDefaultValue.DOCUMENT":
                            Label(response, "displayDocumentnameeditmode", "ui_lbl_documentnameeditmode", "ui_img_helpTextfordocumentnameeditmode", "isdocumentnameeditmode");
                            break;
                        case "@ConstDefaultValue.DOCUMENTSDOCSTATUS":
                            DropDowndetails(response, "displaydocumentStatuseditmode", "ui_lbl_documentstatuseditmode", "ui_img_helpTextfordocumentstatuseditmode", "isdocumentstatuseditmode");
                            break;
                        case "@ConstDefaultValue.DOCUMENTAMENDMENTVERSION":
                            DropDowndetails(response, "displayAmendmentversioneditmode", "ui_lbl_amendmentversioneditmode", "ui_img_helpTextforamendmentversioneditmode", "isamendmentversioneditmode");
                            break;
                        case "@ConstDefaultValue.DOCUMENTDOCTYPE":
                            DropDowndetails(response, "displayDocumenttypeeditmode", "ui_lbl_documenttypeeditmode", "ui_img_helpTextfordocumenttypeeditmode", "isdocumenttypeeditmode");
                            break;
                        case "@ConstDefaultValue.DOCUMENTDOCSUBTYPE":
                            DropDowndetails(response, "displayDocumentsubtypeeditmode", "ui_lbl_documentsubtypeeditmode", "ui_img_helpTextfordocumentsubtypeeditmode", "isdocumentsubtypeeditmode");
                            break;
                         case "@ConstDefaultValue.DOCUMENTSOURCE":
                            Label(response, "displayDocumentsourceeditmode", "ui_lbl_documentsourceeditmode", "ui_img_helpTextfordocumentsourceeditmode", "isdocumentsourceeditmode");
                            break;
                        case "@ConstDefaultValue.UPLOADEDBY":
                            Label(response, "displayUploadedbyeditmode", "ui_lbl_uploadedbyeditmode", "ui_img_helpTextforuploadedbyeditmode", "isuploadedbyeditmode");
                            break;
                        case "@ConstDefaultValue.DOCUMENTDATE":
                            DropDowndetails(response, "displayDateofuploadeditmode", "ui_lbl_dateofuploadeditmode", "ui_img_helpTextfordateofuploadeditmode", "isdateofuploadeditmode");
                            break;
                        case "@ConstDefaultValue.ORIGINALDATE":
                            DropDowndetails(response, "displayOriginaldateeditmode", "ui_lbl_originaldateeditmode", "ui_img_helpTextfororiginaldateeditmode", "isoriginaldateeditmode");
                            break;
                        case "@ConstDefaultValue.EXPIRATIONDATE":
                            DropDowndetails(response, "displayExpirationdateeditmode", "ui_lbl_expirationdateeditmode", "ui_img_helpTextforexpirationdateeditmode", "isexpirationdateeditmode");
                            break;
                        default:
                            break;
                    }
                }
            }
        },
        failure: function (response) {
            popupNotification.show(errorsinthepage, "error");
        }
    });
    }

</script>