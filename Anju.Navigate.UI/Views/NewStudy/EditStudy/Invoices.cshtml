<script src="~/scripts/Common/Common.js"></script>
<script>
   var charslefttoenter = '@ConstDefaultValue.CHARACTERSLEFTTOENTER';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var invoicesattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.Invoices)';
    var deleteMsg = '@Messages.DELETEMESSAGETITLEBOX';
    var checksenttosite = '@ConstDefaultValue.CHECKSENTTOSITE';
    var descriptionofpayment = '@ConstDefaultValue.DESCRIPTIONOFPAYMENT';
    var invoicedate = '@ConstDefaultValue.INVOICEDATE';
