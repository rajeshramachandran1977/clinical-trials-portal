@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="overflowHidden" id="invoicedetails">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_Invoicedetails" onclick="addInvoicedetails()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        @(Html.Kendo().Grid<Anju.Navigate.Data.Invoicedetails>
            ()
            .Name("ui_dtg_Invoices")
            .Columns(columns =>
            {
                columns.Bound(c => c.InvoicesdetailsId).Hidden(true);
                columns.Bound(c => c.StudyId).Hidden(true);
                columns.Bound(c => c.Checksenttosite).Width(200).Title("Check Sent to Site").ClientTemplate("#= Checksenttosite ? kendo.toString(kendo.parseDate(Checksenttosite), 'MMM dd, yyyy') : '' #");
                columns.Bound(c => c.Descriptionofpayment).Width(200).Title("Description of payment");
                columns.Bound(c => c.Invoicedate).Width(150).Title("Invoice Date").ClientTemplate("#= Invoicedate ? kendo.toString(kendo.parseDate(Invoicedate), 'MMM dd, yyyy') : '' #"); ;
                columns.Bound(c => c.Invoicenumber).Width(150).Title("Invoice No.");
                columns.Bound(c => c.Ponumber).Width(150).Title("PO Number");
                columns.Bound(c => c.Currency).Width(100).Title("Currency");
                columns.Bound(c => c.Paymentamount).Width(150).Title("Payment Amount");
                columns.Bound(c => c.Lineitem).Width(200).Title("Line Item");
                columns.Bound(c => c.Generalledgernumber).Width(200).Title("General Ledger Number");
                columns.Bound(c => c.Departmentcode).Width(150).Title("Department Code");
                columns.Bound(c => c.Budgetsource).Width(150).Title("Budget Source");
                columns.Bound(c => c.Personnel).Width(100).Title("Personnel");
                columns.Bound(c => c.Procedural).Width(100).Title("Procedural");
                columns.Bound(c => c.Irbfees).Width(105).Title("IRB Fees");
                columns.Bound(c => c.Irbannualfees).Width(200).Title("IRB Annual Fees");
                columns.Bound(c => c.Administrative).Width(150).Title("Administrative");
                columns.Bound(c => c.Pharmacy).Width(100).Title("Pharmacy");
                columns.Bound(c => c.Startup).Width(100).Title("Start-Up");
                columns.Bound(c => c.Correlative).Width(100).Title("Correlative");
                columns.Bound(c => c.Other).Width(100).Title("Other");
                columns.Bound(c => c.Organizationtype).Width(150).Title("Organization Type");
                columns.Bound(c => c.Natureofexpenditure).Width(200).Title("Nature of Expenditure");
                columns.Bound(c => c.Purposeofexpenditure).Width(200).Title("Purpose of Expenditure");
                columns.Bound(c => c.Settingofactivity).Width(200).Title("Setting of Activity");
                columns.Command(command => command.Custom("Tag").Text("Edit").Click("showInvoicedetails")).Width(80);
                columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteInvoicedetails")).Width(80);
            })
            .Events(events => events.DataBound("OnDataBoundforInvoicedetails"))
            .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label" })
            .Scrollable()
            .Groupable(false)
            .Sortable()
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(10))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(p => p.InvoicesdetailsId))
            .Read(read => read.Action("GetInvoicesdetails", "NewStudy"))
            .Destroy(update => update.Action("DeleteInvoicedetails", "NewStudy"))
            )
        )
        @(Html.Kendo().Window()
        .Name("Invoices")
        .Title("Invoices")
        .Actions(actions => actions.Clear())
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(1000)
        )
    </div>
</div>
