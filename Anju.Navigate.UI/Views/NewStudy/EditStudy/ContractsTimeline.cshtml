@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="overflowHidden" id="contractstimelinedetails">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_AddContractsTimeline" onclick="addContractsTimelinedetails()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        @(Html.Kendo().Grid<Anju.Navigate.Data.Contracttimelines>
            ()
            .Name("ui_dtg_ContractsTimeline")
            .Columns(columns =>
            {
            columns.Bound(c => c.ContractId).Hidden(true);
            columns.Bound(c => c.StudyId).Hidden(true);
            columns.Bound(c => c.Contracttype).Width(200).Title("Contract Type");
            columns.Bound(c => c.Contracttimelinestatus).Width(200).Title("Contract Status");
            columns.Bound(c => c.Contractversion).Width(150).Title("Version");
            columns.Bound(c => c.Currentlocation).Width(150).Title("Current Location");
            columns.Bound(c => c.Contactname).Width(150).Title("Contact Name");
            columns.Bound(c => c.Statuschange).Width(100).Title("Status Change Date").ClientTemplate("#= Statuschange ? kendo.toString(kendo.parseDate(Statuschange), 'MMM dd, yyyy') : '' #");
            columns.Bound(c => c.Comments).Width(150).Title("Comments");
            columns.Command(command => command.Custom("Tag").Text("Edit").Click("showContractsTimelinedetails")).Width(80);
            columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteContractsTimelinedetails")).Width(80);
            })
            .Events(events => events.DataBound("OnDataBoundforContractsTimeline"))
            .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label" })
            .Scrollable()
            .Groupable(false)
            .Sortable()
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(10))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(p => p.ContractId))
            .Read(read => read.Action("GetContractsTimeline", "NewStudy"))
            .Destroy(update => update.Action("DeleteContractsTimeline", "NewStudy"))
            )
        )
        @(Html.Kendo().Window()
        .Name("Contractstimeline")
        .Title("Contracts Timeline")
        .Actions(actions => actions.Clear())
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(1000)
        )
    </div>
</div>
<script type="text/x-kendo-template" id="contractstimelinetemplate">
    <div id="details-container">
        <form id="ui_frm_contractstimeline">
            <span id="popupNotification"></span>
            <div class="card p-2">
                <div id="flex">
                    <input type="hidden" id="ui_num_contractid" min="1" data-bind="value:ui_num_contractid" />
                    <div class="row">
                        <div id="displayContracttype" class="col-md-6">
                            <div id="contracttype">
                                <label class="col-formEditStudy-labels" id="ui_lbl_contracttype"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcontracttype" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                      .Name("ui_ddl_contracttype")
                                      .HtmlAttributes(new { @class = "wid_100" })
                                      .DataTextField("Code")
                                      .DataValueField("Code")
                                      .OptionLabel("Select")
                                      .DataSource(source =>
                                      {
                                      source.Read(read =>
                                      {
                                      read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.CONTRACTTYPE });
                                      })
                                      .ServerFiltering(true);
                                      })
                                      .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                        <div id="displayContractstatus" class="col-md-6">
                            <div id="contractstatus">
                                <label class="col-formEditStudy-labels" id="ui_lbl_contractstatus"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcontractstatus" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                      .Name("ui_ddl_contractstatus")
                                      .HtmlAttributes(new { @class = "wid_100" })
                                      .DataTextField("Code")
                                      .DataValueField("Code")
                                      .OptionLabel("Select")
                                      .DataSource(source =>
                                      {
                                      source.Read(read =>
                                      {
                                      read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.CONTRACTSTATUS });
                                      })
                                      .ServerFiltering(true);
                                      })
                                      .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayVersionforcontractstimeline" class="col-md-6">
                            <div id="version">
                                <label class="col-formEditStudy-labels " id="ui_lbl_versioncontractstimeline"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforversioncontractstimeline" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_versioncontractstimeline" maxlength="1"></textarea>
                                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_versioncontractstimeline" maxlength="1">
                                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforversioncontractstimeline"></label></span>
                                    <input type="hidden" id="regexexprforversioncontractstimeline" />
                                    <input type="hidden" id="validationmsgforversioncontractstimeline" />
                                </div>
                            </div>
                        </div>
                        <div id="displayCurrentlocation" class="col-md-6">
                            <div id="currentlocation">
                                <label class="col-formEditStudy-labels" id="ui_lbl_currentlocation"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcurrentlocation" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                      .Name("ui_ddl_currentlocation")
                                      .HtmlAttributes(new { @class = "wid_100" })
                                      .DataTextField("Code")
                                      .DataValueField("Code")
                                      .OptionLabel("Select")
                                      .DataSource(source =>
                                      {
                                      source.Read(read =>
                                      {
                                      read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.CURRENTLOCATION });
                                      })
                                      .ServerFiltering(true);
                                      })
                                      .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayContactname" class="col-md-6">
                            <div id="contactname">
                                <label class="col-formEditStudy-labels " id="ui_lbl_contactname"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcontactname" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_contactname" maxlength="1"></textarea>
                                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_contactname" maxlength="1">
                                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforcontactname"></label></span>
                                    <input type="hidden" id="regexexprforcontactname" />
                                    <input type="hidden" id="validationmsgforcontactname" />
                                </div>
                            </div>
                        </div>
                        <div id="displayStatuschangedate" class="col-md-6">
                            <div id="statuschangedate">
                                <label class="col-formEditStudy-labels " id="ui_lbl_statuschangedate"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforstatuschangedate" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DatePicker()
                                      .Name("ui_dt_statuschangedate")
                                      .Start(CalendarView.Month)
                                      .Depth(CalendarView.Month)
                                      .Format("MMM dd, yyyy")
                                      .DateInput()
                                      .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayComments" class="col-md-6">
                            <div id="comments">
                                <label class="col-formEditStudy-labels " id="ui_lbl_comments"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcomments" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_contractcomments" maxlength="1"></textarea>
                                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_contractcomments" maxlength="1">
                                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforcomments"></label></span>
                                    <input type="hidden" id="regexexprforcomments" />
                                    <input type="hidden" id="validationmsgforcomments" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row float-right mt-2">
                <button type="button" class="btn btn-primary mr-1" id="ui_btnSavecontractstimeline">Save</button>
                <button type="button" class="btn btn-primary mr-3" onclick="showDialog();">Cancel</button>
            </div>
        </form>
    </div>
</script>
<script src="~/scripts/Common/Common.js"></script>
<script>
var charslefttoenter = '@ConstDefaultValue.CHARACTERSLEFTTOENTER';
var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
var contractstimelineattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.ContractsTimeline)';
var deleteMsg = '@Messages.DELETEMESSAGETITLEBOX';
var contracttype = '@ConstDefaultValue.CONTRACTTYPE';
    var contractstatus = '@ConstDefaultValue.CONTRACTSTATUS';
    var version = '@ConstDefaultValue.CONTRACTSTIMELINEVERSION';
    var currentlocation = '@ConstDefaultValue.CURRENTLOCATION';
    var contactname = '@ConstDefaultValue.CONTACTNAME';
    var statuschangedate = '@ConstDefaultValue.STATUSCHANGEDATE';
    var comments = '@ConstDefaultValue.COMMENTS';
</script>
<script src="~/scripts/EditStudy/ContractsTimeline.js"></script>