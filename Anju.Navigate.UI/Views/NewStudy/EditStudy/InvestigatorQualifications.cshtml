                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforwhenwasyourlastGCPtraining"></label></span>
                    <input type="hidden" id="regexexprforwhenwasyourlastGCPtraining" />
                    <input type="hidden" id="validationmsgforwhenwasyourlastGCPtraining" />
                </div>
            </div>
        </div>
        <div id="displayTypeoftrainingreceived">
            <div id="typeoftrainingreceived">
                <label class="col-formEditStudy-labels " id="ui_lbl_typeoftrainingreceived"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextfortypeoftrainingreceived" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_typeoftrainingreceived" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_typeoftrainingreceived" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftfortypeoftrainingreceived"></label></span>
                    <input type="hidden" id="regexexprfortypeoftrainingreceived" />
                    <input type="hidden" id="validationmsgfortypeoftrainingreceived" />
                </div>
            </div>
        </div>
        <div id="displayListtrialexperience">
            <div id="listtrialexperience">
                <label class="col-formEditStudy-labels " id="ui_lbl_listtrialexperience"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextforlisttrialexperience" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_listtrialexperience" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_listtrialexperience" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforlisttrialexperience"></label></span>
                    <input type="hidden" id="regexexprforlisttrialexperience" />
                    <input type="hidden" id="validationmsgforlisttrialexperience" />
                </div>
            </div>
        </div>
        <div id="displayisparticipatedinacompanytrial">
            <div id="isparticipatedinacompanytrial" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_isparticipatedinacompanytrial"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextforisparticipatedinacompanytrial" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_isparticipatedinacompanytrial")
                    .OptionLabel("Select")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new List<SelectListItem>
                    () {
                    new SelectListItem() {
                    Text = @ConstDefaultValue.YES,
                    Value = @ConstDefaultValue.YES
                    },
                    new SelectListItem() {
                    Text = @ConstDefaultValue.NO,
                    Value = @ConstDefaultValue.NO
                    },
                    })
                    )
                </div>
            </div>
        </div>
        <div id="displayDatesoftrialparticipation">
            <div id="datesoftrialparticipation">
                <label class="col-formEditStudy-labels " id="ui_lbl_datesoftrialparticipation"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextfordatesoftrialparticipation" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_datesoftrialparticipation" maxlength="1"></textarea>
