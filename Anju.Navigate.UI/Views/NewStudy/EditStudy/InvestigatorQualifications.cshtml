        <div id="displayDetailsofthemainobservations">
            <div id="detailsofthemainobservations">
                <label class="col-formEditStudy-labels " id="ui_lbl_detailsofthemainobservations"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextfordetailsofthemainobservations" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_detailsofthemainobservations" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_detailsofthemainobservations" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftfordetailsofthemainobservations"></label></span>
                    <input type="hidden" id="regexexprfordetailsofthemainobservations" />
                    <input type="hidden" id="validationmsgfordetailsofthemainobservations" />
