                </div>
            </div>
        </div>
        <div id="displayDrugnames">
            <div id="drugnames">
                <label class="col-formEditStudy-labels " id="ui_lbl_drugnames"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextfordrugnames" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_drugnames" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_drugnames" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftfordrugnames"></label></span>
                    <input type="hidden" id="regexexprfordrugnames" />
                    <input type="hidden" id="validationmsgfordrugnames" />
                </div>
            </div>
        </div>
        <div id="displayProtocolnumbers">
            <div id="protocolnumbers">
                <label class="col-formEditStudy-labels " id="ui_lbl_protocolnumbers"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextforprotocolnumbers" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_protocolnumbers" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_protocolnumbers" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforprotocolnumbers"></label></span>
                    <input type="hidden" id="regexexprforprotocolnumbers" />
                    <input type="hidden" id="validationmsgforprotocolnumbers" />
                </div>
            </div>
        </div>
        <div id="displayNumberofongoingclinicaltrials">
            <div id="numberofongoingclinicaltrials">
                <label class="col-formEditStudy-labels " id="ui_lbl_numberofongoingclinicaltrials"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextfornumberofongoingclinicaltrials" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_numberofongoingclinicaltrials" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_numberofongoingclinicaltrials" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftfornumberofongoingclinicaltrials"></label></span>
                    <input type="hidden" id="regexexprfornumberofongoingclinicaltrials" />
                    <input type="hidden" id="validationmsgfornumberofongoingclinicaltrials" />
                </div>
            </div>
        </div>
        <div id="displayisinspectedbyahealthauthority">
            <div id="isinspectedbyahealthauthority" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_isinspectedbyahealthauthority"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextforisinspectedbyahealthauthority" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_isinspectedbyahealthauthority")
                    .OptionLabel("Select")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new List<SelectListItem>
                    () {
                    new SelectListItem() {
                    Text = @ConstDefaultValue.YES,
                    Value = @ConstDefaultValue.YES
                    },
                    new SelectListItem() {
                    Text = @ConstDefaultValue.NO,
                    Value = @ConstDefaultValue.NO
                    },
                    })
                    )
                </div>
            </div>
        </div>
        <div id="displayWhichhealthauthority">
            <div id="whichhealthauthority">
                <label class="col-formEditStudy-labels " id="ui_lbl_whichhealthauthority"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextforwhichhealthauthority" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_whichhealthauthority" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_whichhealthauthority" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforwhichhealthauthority"></label></span>
                    <input type="hidden" id="regexexprforwhichhealthauthority" />
                    <input type="hidden" id="validationmsgforwhichhealthauthority" />
                </div>
            </div>
        </div>
        <div id="displayDateoflastinspection">
            <div id="dateoflastinspection" class="row mb-1">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_dateoflastinspection"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextfordateoflastinspection" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DatePicker()
                    .Name("ui_dt_dateoflastinspection")
                    .Start(CalendarView.Year)
                    .Depth(CalendarView.Year)
                    .Format("MMM dd, yyyy")
                    .DateInput()
                    )
                </div>
            </div>
        </div>
        <div id="displayIsinspectedbytheFDA">
            <div id="isinspectedbytheFDA" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels" id="ui_lbl_isinspectedbytheFDA"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_isinspectedbytheFDA" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_isinspectedbytheFDA")
                    .OptionLabel("Select")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new List<SelectListItem>
                        () {
                        new SelectListItem() {
                        Text = @ConstDefaultValue.YES,
                        Value = @ConstDefaultValue.YES
                        },
                        new SelectListItem() {
                        Text = @ConstDefaultValue.NO,
                        Value = @ConstDefaultValue.NO
                        },
                        })
                    )
                </div>
            </div>
        </div>
        <div id="displayDateofFDAinspection">
            <div id="dateofFDAinspection" class="row mt-1 mb-1">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_dateofFDAinspection"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextfordateofFDAinspection" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DatePicker()
                    .Name("ui_dt_dateofFDAinspection")
                    .Start(CalendarView.Year)
                    .Depth(CalendarView.Year)
                    .Format("MMM dd, yyyy")
