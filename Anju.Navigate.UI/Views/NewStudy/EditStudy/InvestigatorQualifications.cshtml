@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard" id="investigatorqualificationsdetails">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row">
        <div class="wid_100">
            <img class="float-right mr-4 noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        <div id="displayMedicalSpecialty">
            <div id="medicalspecialty">
                <label class="col-formEditStudy-labels " id="ui_lbl_medicalspecialty"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextformedicalspecialty" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_medicalspecialty" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_50 ml-0" id="ui_txt_medicalspecialty" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftformedicalspecialty"></label></span>
                    <input type="hidden" id="regexexprformedicalspecialty" />
                    <input type="hidden" id="validationmsgformedicalspecialty" />
                </div>
            </div>
        </div>
        <div id="displayBoardCertification">
            <div id="boardCertification">
                <label class="col-formEditStudy-labels " id="ui_lbl_boardcertification"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextforboardcertification" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_boardcertification" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_50 ml-0" id="ui_txt_boardcertification" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforboardcertification"></label></span>
                    <input type="hidden" id="regexexprforboardcertification" />
                    <input type="hidden" id="validationmsgforboardcertification" />
                </div>
            </div>
        </div>
        <div id="displayLicenseorEquivalent">
            <div id="licenseorEquivalent">
                <label class="col-formEditStudy-labels " id="ui_lbl_licenseorequivalent"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextforlicenseorequivalent" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_licenseorequivalent" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_licenseorequivalent" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforlicenseorequivalent"></label></span>
                    <input type="hidden" id="regexexprforlicenseorequivalent" />
                    <input type="hidden" id="validationmsgforlicenseorequivalent" />
                </div>
            </div>
        </div>
        <div id="displayisreceivedGCPtraining">
            <div id="isreceivedGCPtraining" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_isreceivedGCPtraining"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextforisreceivedGCPtraining" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                     .Name("ui_ddl_isreceivedGCPtraining")
                     .OptionLabel("Select")
                     .DataTextField("Text")
                     .DataValueField("Value")
                     .BindTo(new List<SelectListItem>
                     () {
                     new SelectListItem() {
                     Text = @ConstDefaultValue.YES,
                     Value = @ConstDefaultValue.YES
                     },
                     new SelectListItem() {
                     Text = @ConstDefaultValue.NO,
                     Value = @ConstDefaultValue.NO
                     },
                     })
                    )
                </div>
            </div>
        </div>
        <div id="displayWhenwasyourlastGCPtraining">
            <div id="whenwasyourlastGCPtraining">
                <label class="col-formEditStudy-labels " id="ui_lbl_whenwasyourlastGCPtraining"></label>
