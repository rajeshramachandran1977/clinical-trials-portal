    <div class="row float-right">
        <button type="submit" class="btn btn-primary mr-1" id="ui_btnSaveInvestigatorQualifications">Save</button>
        <button type="button" class="btn btn-primary mr-1" onclick="showDialogfornongrid();">Cancel</button>
    </div>
</div>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var investigatorqualificationsattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.InvestigatorQualifications)';
    var yes = '@ConstDefaultValue.YES';
    var no = '@ConstDefaultValue.NO';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var medicalspecialty = '@ConstDefaultValue.MEDICALSPECIALTY';
    var boardcertification = '@ConstDefaultValue.BOARDCERTIFICATION';
    var licenseorequivalent = '@ConstDefaultValue.LICENSEOREQUIVALENT';
    var isreceivedgcptrainingthepast3years = '@ConstDefaultValue.ISRECEIVEDGCPTRAININGTHEPAST3YEARS';
    var lastgcptraining = '@ConstDefaultValue.LASTGCPTRAINING';
    var typeoftrainingreceived = '@ConstDefaultValue.TYPEOFTRAININGRECEIVED';
    var listtrialexperience = '@ConstDefaultValue.LISTTRIALEXPERIENCE';
    var isparticipatedinacompanytrial = '@ConstDefaultValue.ISPARTICIPATEDINACOMPANYTRIAL';
    var datesoftrialparticipation = '@ConstDefaultValue.DATESOFTRIALPARTICIPATION';
    var drugnames = '@ConstDefaultValue.DRUGNAMES';
    var protocolnumbers = '@ConstDefaultValue.PROTOCOLNUMBERS';
    var noofongoingclinicaltrials = '@ConstDefaultValue.NOOFONGOINGCLINICALTRIALS';
    var isinspectedbyahealthauthority = '@ConstDefaultValue.ISINSPECTEDBYAHEALTHAUTHORITY';
    var whichhealthauthority = '@ConstDefaultValue.WHICHHEALTHAUTHORITY';
    var dateoflastinspection = '@ConstDefaultValue.DATEOFLASTINSPECTION';
    var isinspectedbythefda = '@ConstDefaultValue.ISINSPECTEDBYTHEFDA';
    var dateoffdainspection = '@ConstDefaultValue.DATEOFFDAINSPECTION';
    var isfdaissueafda483form = '@ConstDefaultValue.ISFDAISSUEAFDA483FORM';
    var detailsofthemainobservations = '@ConstDefaultValue.DETAILSOFTHEMAINOBSERVATIONS';
</script>
<script src="~/scripts/EditStudy/InvestigatorQualifications.js"></script>