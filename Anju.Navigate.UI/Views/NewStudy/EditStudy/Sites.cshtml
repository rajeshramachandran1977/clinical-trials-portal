@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard overflowHidden">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row noprint mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_AddSites" onclick="addSites()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>

    <div id="flex">
        @(Html.Kendo().Grid<Anju.Navigate.Data.StudySites>
            ()
            .Name("ui_dtg_studysites")
            .Columns(columns =>
            {
            columns.Bound(c => c.SiteId).Hidden(true);
            columns.Bound(c => c.StudyId).Hidden(true);
            columns.Bound(c => c.SiteInstitution).Width("20%").Title("Site Institution Name");
            columns.Bound(c => c.InstitutionInternal).Width("15%").Title("Institution - Internal");
            columns.Bound(c => c.SiteCountry).Width("12%").Title("Site Country");
            columns.Bound(c => c.IsDrugShippedtoSite).Width("15%").Title("Drug Shipped to Site?").ClientTemplate("#= IsDrugShippedtoSite ? 'Yes' : 'No' #");
            columns.Bound(c => c.IsContractdirectwithSite).Width("18%").Title("Contract direct with Site?").ClientTemplate("#= IsContractdirectwithSite ? 'Yes' : 'No' #");
            columns.Command(command => command.Custom("Tag").Text("Edit").Click("showStudysites")).Width("10%");
            columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteStudysites")).Width("10%");
            })
            .Events(events => events.DataBound("OnDataBound"))
            .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label" })
            .Scrollable()
            .Groupable(false)
            .Sortable()
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(p => p.SiteId))
            .Read(read => read.Action("GetStudySites", "NewStudy"))
            .Destroy(update => update.Action("DeleteStudySites", "NewStudy"))
            )
        )
        @(Html.Kendo().Window()
        .Name("Sites")
        .Title("Sites")
        .Actions(actions => actions.Clear())
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(800)
        )
    </div>
</div>
<script type="text/x-kendo-template" id="sitestemplate">
    <div id="details-container">
        <form id="ui_frm_sites">
            <span id="popupNotification"></span>
            <div class="card p-2">
                <div id="flex">
                    <input type="hidden" id="ui_num_siteid" min="1" data-bind="value:ui_num_siteid" />
                    <div id="displaySiteinstitutionname">
                        <div id="siteinstitutionname">
                            <label class="col-formEditStudy-labels" id="ui_lbl_siteinstitutionname"></label>
                            <img src="/Images/helppic.gif" id="ui_img_helpTextforsiteinstitutionname" data-toggle="tooltip" />
                            <div class="col-md-12 p-md-0">
                                <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_siteinstitutionname" maxlength="1"></textarea>
                                <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_siteinstitutionname" maxlength="1">
                                <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforsiteinstitutionname"></label></span>
                                <input type="hidden" id="regexexprforsiteinstitutionname" />
                                <input type="hidden" id="validationmsgforsiteinstitutionname" />
                            </div>
                        </div>
                    </div>
                    <div id="displayInstitutioninternal">
                        <div id="institutioninternal" class="row">
                            <div class="col-md-3">
                                <label class="col-formEditStudy-labels" id="ui_lbl_institutioninternal"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforinstitutioninternal" data-toggle="tooltip" />
                            </div>
                            <div class="col-md-3">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_institutioninternal")
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues",
                                "NewStudy",
                                new { type = @ConstDefaultValue.PIINSTITUTION });
                                })
                                .ServerFiltering(true);
                                })
                                .ToClientTemplate()
                                )
                            </div>
                        </div>
                    </div>
                    <div id="displaySitecountry">
                        <div id="sitecountry" class="row">
                            <div class="col-md-3">
                                <label class="col-formEditStudy-labels" id="ui_lbl_sitecountry"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforsitecountry" data-toggle="tooltip" />
                            </div>
                            <div class="col-md-3">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_sitecountry")
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues",
                                "NewStudy",
                                new { type = @ConstDefaultValue.COUNTRY });
                                })
                                .ServerFiltering(true);
                                })
                                .ToClientTemplate()
                                )
                            </div>
                        </div>
                    </div>
                    <div id="displayIsdrugshippedtosite">
                        <div id="isdrugshippedtosite" class="row">
                            <div class="col-md-3">
                                <label class="col-formEditStudy-labels" id="ui_lbl_isdrugshippedtosite"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforisdrugshippedtosite" data-toggle="tooltip" />
                            </div>
                            <div class="col-md-3">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_isdrugshippedtosite")
                                .OptionLabel("Select")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .BindTo(new List<SelectListItem>
                                () {
                                new SelectListItem() {
                                Text = @ConstDefaultValue.YES,
                                Value = @ConstDefaultValue.YES
                                },
                                new SelectListItem() {
                                Text = @ConstDefaultValue.NO,
                                Value = @ConstDefaultValue.NO
                                },
                                })
                                .ToClientTemplate()
                                )
                            </div>
                        </div>
                    </div>
                    <div id="displayIscontractdirectwithsite">
                        <div id="iscontractdirectwithsite" class="row">
                            <div class="col-md-3">
                                <label class="col-formEditStudy-labels" id="ui_lbl_iscontractdirectwithsite"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforisiscontractdirectwithsite" data-toggle="tooltip" />
                            </div>
                            <div class="col-md-3>
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_isiscontractdirectwithsite")
                                .OptionLabel("Select")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .BindTo(new List<SelectListItem>
                                () {
                                new SelectListItem() {
                                Text = @ConstDefaultValue.YES,
                                Value = @ConstDefaultValue.YES
                                },
                                new SelectListItem() {
                                Text = @ConstDefaultValue.NO,
                                Value = @ConstDefaultValue.NO
                                },
                                })
                                .ToClientTemplate()
                                )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row float-right mt-2">
                <button type="button" class="btn btn-primary mr-1" id="ui_btnSavesites">Save</button>
                <button type="button" class="btn btn-primary mr-3" onclick="showDialog();">Cancel</button>
            </div>
        </form>
    </div>
</script>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var sitesattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.Sites)';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var deleteMsg = '@Messages.DELETEMESSAGETITLEBOX';
    var yes = '@ConstDefaultValue.YES';
    var no = '@ConstDefaultValue.NO';
    var charslefttoenter = '@ConstDefaultValue.CHARACTERSLEFTTOENTER';

    var institutioninternal = '@ConstDefaultValue.INSTITUTIONINTERNAL';
    var siteinstitution = '@ConstDefaultValue.SITEINSTITUTION';
    var country = '@ConstDefaultValue.COUNTRY';
    var isdrugshippedtosite = '@ConstDefaultValue.ISDRUGSHIPPEDTOSITE';
    var iscontractdirectwithsite = '@ConstDefaultValue.ISCONTRACTDIRECTWITHSITE';
</script>
<script src="~/scripts/EditStudy/Sites.js"></script>