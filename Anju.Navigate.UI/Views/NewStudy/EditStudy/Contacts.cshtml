                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayCountry" class="col-md-6">
                            <div id="country">
                                <label class="col-formEditStudy-labels" id="ui_lbl_country"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcountry" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_country")
                                    .HtmlAttributes(new { @class = "wid_100" })
                                    .DataTextField("Code")
                                    .DataValueField("CountryId")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetCountries", "Register");
                                    })
                                    .ServerFiltering(true);
                                    })
                                    .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                        <div id="displayState" class="col-md-6">
                            <div id="state">
                                <label class="col-formEditStudy-labels " id="ui_lbl_state"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforstate" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_state")
                                    .HtmlAttributes(new { @class = "wid_100" })
                                    .DataTextField("Code")
                                    .DataValueField("StateId")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetStatesByCountryID", "Register").Data("filterStates");
                                    })
                                    .ServerFiltering(true);
                                    })
                                    .Enable(false)
                                    .AutoBind(false)
                                    .CascadeFrom("ui_ddl_country")
                                    .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayCity" class="col-md-6">
                            <div id="city">
                                <label class="col-formEditStudy-labels " id="ui_lbl_city"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcity" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_city")
                                    .HtmlAttributes(new { @class = "wid_100" })
                                    .DataTextField("Name")
                                    .DataValueField("CityId")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetCitiesByStateID", "Register").Data("filterCities");
                                    })
                                    .ServerFiltering(true);
                                    })
                                    .Enable(false)
                                    .AutoBind(false)
                                    .CascadeFrom("ui_ddl_state")
