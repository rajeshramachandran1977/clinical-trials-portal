                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_contacttype")
                                    .HtmlAttributes(new { @class = "wid_100" })
                                    .DataTextField("Code")
                                    .DataValueField("Code")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                    source.Read(read =>
                                    {
                                    read.Action("GetSysCodeValues",
                                    "NewStudy",
