@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard overflowHidden" id="contactsdetails">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row noprint mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_AddContacts" onclick="addContacts()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        @(Html.Kendo().Grid<Anju.Navigate.Data.NewStudy>
            ()
            .Name("ui_dtg_Contacts")
            .Columns(columns =>
            {
            columns.Bound(c => c.SiteIndex).Width(200).Title("Site Index");
            columns.Bound(c => c.PrincipalInvestigatorId).Title("id");
            columns.Bound(c => c.ContactType).Width(200).Title("Contact Type");
            columns.Bound(c => c.ContactTypeDetails).Width(200).Title("Contact Type Details");
            columns.Bound(c => c.TaxID).Width(200).Title("Tax ID");
            columns.Bound(c => c.Salutation).Width(200).Title("Salutation");
            columns.Bound(c => c.FirstName).Width(200).Title("First Name");
            columns.Bound(c => c.LastName).Width(200).Title("Last Name");
            columns.Bound(c => c.Suffix).Width(200).Title("Suffix");
            columns.Bound(c => c.Title).Width(200).Title("Title");
            columns.Bound(c => c.Degree).Width(200).Title("Credentials");
            columns.Bound(c => c.Institution).Width(200).Title("Institution");
            columns.Bound(c => c.Address1).Width(200).Title("Address Line 1");
            columns.Bound(c => c.Address2).Width(200).Title("Address Line 2");
            columns.Bound(c => c.Address3).Width(200).Title("Address Line 3");
            columns.Bound(c => c.CityName).Width(200).Title("City");
            columns.Bound(c => c.StateName).Width(200).Title("State");
            columns.Bound(c => c.PostalCode).Width(200).Title("Postal Code");
            columns.Bound(c => c.CountryName).Width(200).Title("Country");
            columns.Bound(c => c.Phone).Width(200).Title("Phone");
            columns.Bound(c => c.Fax).Width(200).Title("Fax");
            columns.Bound(c => c.PrimaryEmailId).Width(200).Title("Email");
            columns.Bound(c => c.Npinumber).Width(200).Title("NPI #");
            columns.Command(command => command.Custom("Tag").Text("Edit").Click("showContacts")).Width(90);
            columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteContacts")).Width(90);
            })
            .Events(events => events.DataBound("OnDataBoundforContacts"))
            .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label" })
            .Scrollable()
            .Groupable(false)
            .Sortable()
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(p => p.StudyId))
            .Read(read => read.Action("GetContacts", "NewStudy"))
            .Destroy(update => update.Action("DeleteContacts", "NewStudy"))
            )
        )
        @(Html.Kendo().Window()
        .Name("Contacts")
        .Title("Contacts")
        .Actions(actions => actions.Clear())
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(1000)
        )
    </div>
</div>
<script type="text/x-kendo-template" id="contactstemplate">
    <div id="details-container">
        <form id="ui_frm_contacts">
            <span id="popupNotification"></span>
