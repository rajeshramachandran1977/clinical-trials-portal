@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard overflowHidden" id="emaillistdetails">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row noprint mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_AddEmailList" onclick="addEmaillist()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>

    @(Html.Kendo().Grid<Anju.Navigate.Data.EmailList>
    ()
    .Name("ui_dtg_gridEmailList")
    .Columns(columns =>
    {
        columns.Bound(c => c.Id).Hidden(true);
        columns.Bound(c => c.StudyId).Hidden(true);
        columns.Bound(c => c.Email).Width("70%").Title("Recipient");
        columns.Command(command => command.Custom("Tag").Text("Edit").Click("showEmailList")).Width("15%");
        columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteEmailList")).Width("15%");
    })
    .Events(events => events.DataBound("OnDataBoundforEmailList"))
    .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label" })
    .Scrollable()
    .Groupable(false)
    .Sortable()
    .Editable(editable => editable.Mode(GridEditMode.InCell).DisplayDeleteConfirmation(false))
    .Pageable(pageable => pageable
    .Refresh(true)
    .PageSizes(true)
    .ButtonCount(5))
    .DataSource(dataSource => dataSource
    .Ajax()
    .Model(model => model.Id(p => p.Id))
    .Read(read => read.Action("GetEmailList", "NewStudy").Data("StudyDetailsID"))
    .Destroy(update => update.Action("DeleteEmailList", "NewStudy").Data("StudyDetailsID"))
    )
    )
    @(Html.Kendo().Window()
    .Name("EmailLists")
    .Title("Email Lists")
    .Actions(actions => actions.Clear())
    .Visible(false)
    .Modal(true)
    .Draggable(true)
    .Width(800)
    )
</div>
<script type="text/x-kendo-template" id="emailtemplate">
    <div id="details-container">
        <form id="ui_frm_emaillists">
            <span id="popupNotification"></span>
            <div class="card p-2">
                <div id="flex">
                    <input type="hidden" id="ui_num_emaillistid" min="1" data-bind="value:ui_num_emaillistid" />
                    <div id="displayRecipient">
                        <div id="recipient">
                            <label class="col-formEditStudy-labels " id="ui_lbl_recipient"></label>
                            <img src="/Images/helppic.gif" id="ui_img_helpTextforrecipient" data-toggle="tooltip" />
                            <div class="col-md-12 p-md-0">
                                <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_recipient" maxlength="1"></textarea>
                                <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_recipient" maxlength="1">
                                <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforrecipient"></label></span>
                                <input type="hidden" id="regexexprforrecipient" />
                                <input type="hidden" id="validationmsgforrecipient" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row float-right mt-2">
                <button type="button" class="btn btn-primary mr-1" id="ui_btnSaveemaillists">Save</button>
                <button type="button" class="btn btn-primary mr-3" onclick="showDialog();">Cancel</button>
            </div>
        </form>
    </div>
</script>
<script>
    var emaillistattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.EmailList)';
    var deleteMsg = '@Messages.DELETEMESSAGETITLEBOX';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var recipient = '@ConstDefaultValue.RECIPIENT';
</script>
<script src="~/scripts/EditStudy/Emaillist.js"></script>