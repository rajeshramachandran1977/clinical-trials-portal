    <script src="~/scripts/Common/Common.js"></script>
<script>
var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
var diseasesattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.DiseaseStates)';
var urlriskfactors = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.RISKFACTORS})';
var urlgenomicprofile = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.GENOMICPROFILE})';
var urllineoftherapy = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.LINEOFTHERAPY})';
var urldiseasepatientpopulation = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.DISEASEFORPATIENTPOPULATION})';

var franchise = '@ConstDefaultValue.FRANCHISE';
var randomized = '@ConstDefaultValue.RANDOMIZED';
