@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
    <head>
        <meta http-equiv="Cache-control" content="no-cache">
        <meta http-equiv="Expires" content="-1">
    </head>
    <div class="editcard" id="diseasestatescontents">
        <input type="hidden" value="@ViewBag.UserType" id="UserType" />
        <div class="row">
            <div class="wid_100">
                <img class="float-right mr-4 noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
            </div>
        </div>
        <div id="flex">
            <div id="displayFranchise">
                <div id="franchise" class="row mt-1">
                    <div class="col-md-3">
                        <label class="col-formEditStudy-labels" id="ui_lbl_franchise"></label>
                        <img src="~/Images/helppic.gif" id="ui_img_franchise" data-toggle="tooltip" />
                    </div>
                    <div class="col-md-3">
                        @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_franchise")
                        .DataTextField("Code")
                        .DataValueField("Code")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetSysCodeValues",
                        "NewStudy",
                        new { type = @ConstDefaultValue.FRANCHISE });
                        })
                        .ServerFiltering(true);
                        })
                        )
                    </div>
                </div>
            </div>
            <div id="displayDisease">
                <div id="disease" class="row mt-1">
                    <div class="col-md-3">
