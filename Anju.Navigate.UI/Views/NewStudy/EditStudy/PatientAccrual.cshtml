@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard overflowHidden" id="patientaccrualdetails">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row noprint mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_AddPatientAccrual" onclick="addPatientaccrual()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        @(Html.Kendo().Grid<Anju.Navigate.Data.PatientAccrual>
            ()
            .Name("ui_dtg_Patientaccrual")
            .Columns(columns =>
            {
                columns.Bound(c => c.PatientaccrualId).Hidden(true);
                columns.Bound(c => c.StudyId).Hidden(true);
                columns.Bound(c => c.MonthYear).Width("11%").Title("Month and Year of Accrual");
                columns.Bound(c => c.TreatedPatients).Width("16%").Title("Number of New Patients Treated this month");
                columns.Bound(c => c.CurrentPatients).Width("17%").Title("Total no. of patients currently on treatment");
                columns.Bound(c => c.WithdrawnPatients).Width("18%").Title("Total No. of patients withdrawn from treatment");
                columns.Bound(c => c.CompletedPatients).Width("18%").Title("Total No. of patients completed treatment");
                columns.Command(command => command.Custom("Tag").Text("Edit").Click("showPatientaccrual")).Width("10%");
                columns.Command(command => command.Custom("Delete").Text("Delete").Click("deletePatientaccrual")).Width("10%");
            })
            .Events(events => events.DataBound("OnDataBoundforPatientAccrual"))
            .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label" })
            .Scrollable()
            .Groupable(false)
            .Sortable()
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(p => p.PatientaccrualId))
            .Read(read => read.Action("GetPatientAccrual", "NewStudy"))
            .Destroy(update => update.Action("DeletePatientAccrual", "NewStudy"))
            )
        )
        @(Html.Kendo().Window()
        .Name("Patientaccrual")
        .Title("Patient Accrual")
        .Actions(actions => actions.Clear())
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(1000)
        )
    </div>
</div>
<script type="text/x-kendo-template" id="patientaccrualtemplate">
    <div id="details-container">
        <form id="ui_frm_patientaccrual">
            <span id="popupNotification"></span>
            <div class="card p-2">
                <div id="flex">
                    <input type="hidden" id="ui_num_id" min="1" data-bind="value:ui_num_id" />
                    <div class="row">
                        <div id="displayMonthandYearofaccrual" class="col-md-6">
                            <div id="monthandyearofaccrual">
                                <label class="col-formEditStudy-labels " id="ui_lbl_monthandyearofaccrual"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextformonthandyearofaccrual" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DatePicker()
                                            .Name("ui_dt_monthandyearofaccrual")
                                            .Start(CalendarView.Year)
                                            .Depth(CalendarView.Year)
                                            .Format("MMM yyyy")
                                            .Value(CalendarView.Month.ToString())
                                            .DateInput()
                                            .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                        <div id="displayNoofnewpatientstreatedthismonth" class="col-md-6">
                            <div id="noofnewpatientstreatedthismonth">
                                <label class="col-formEditStudy-labels " id="ui_lbl_noofnewpatientstreatedthismonth"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfornoofnewpatientstreatedthismonth" data-toggle="tooltip" />
                                <div>
                                    <input type="number" class="numberFieldWidth" id="ui_num_noofnewpatientstreatedthismonth" min="1" data-bind="value:ui_num_noofnewpatientstreatedthismonth" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayTotalnoofpatientscurrentlyontreatment" class="col-md-6">
                            <div id="totalnoofpatientscurrentlyontreatment">
                                <label class="col-formEditStudy-labels " id="ui_lbl_totalnoofpatientscurrentlyontreatment"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfortotalnoofpatientscurrentlyontreatment" data-toggle="tooltip" />
                                <div>
                                    <input type="number" class="numberFieldWidth" id="ui_num_totalnoofpatientscurrentlyontreatment" min="1" data-bind="value:ui_num_totalnoofpatientscurrentlyontreatment" />
                                </div>
                            </div>
                        </div>
                        <div id="displayTotalnoofpatientswithdrawnfromtreatment" class="col-md-6">
                            <div id="totalnoofpatientswithdrawnfromtreatment">
                                <label class="col-formEditStudy-labels " id="ui_lbl_totalnoofpatientswithdrawnfromtreatment"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfortotalnoofpatientswithdrawnfromtreatment" data-toggle="tooltip" />
                                <div>
                                    <input type="number" class="numberFieldWidth" id="ui_num_totalnoofpatientswithdrawnfromtreatment" min="1" data-bind="value:ui_num_totalnoofpatientswithdrawnfromtreatment" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displayTotalnoofpatientscompletedtreatment" class="col-md-6">
                            <div id="totalnoofpatientscompletedtreatment">
                                <label class="col-formEditStudy-labels" id="ui_lbl_totalnoofpatientscompletedtreatment"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfortotalnoofpatientscompletedtreatment" data-toggle="tooltip" />
                                <div>
                                    <input type="number" class="numberFieldWidth" id="ui_num_totalnoofpatientscompletedtreatment" min="1" data-bind="value:ui_num_totalnoofpatientscompletedtreatment" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row float-right mt-2">
                <button type="button" class="btn btn-primary mr-1" id="ui_btnSavepatientaccrual">Save</button>
                <button type="button" class="btn btn-primary mr-3" onclick="showDialog();">Cancel</button>
            </div>
        </form>
    </div>
</script>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var patientaccrualattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.PatientAccrual)';
    var deleteMsg = '@Messages.DELETEMESSAGETITLEBOX';
    var monthandyearofaccrual = '@ConstDefaultValue.MONTHANDYEAROFACCRUAL';
    var numberofnewpatientstreatedthismonth = '@ConstDefaultValue.NUMBEROFNEWPATIENTSTREATEDTHISMONTH'
    var totalnoofpatientscurrentlyontreatment = '@ConstDefaultValue.TOTALNOOFPATIENTSCURRENTLYONTREATMENT';
    var totalnoofpatientswithdrawnfromtreatment = '@ConstDefaultValue.TOTALNOOFPATIENTSWITHDRAWNFROMTREATMENT';
    var totalnoofpatientscompletedtreatment = '@ConstDefaultValue.TOTALNOOFPATIENTSCOMPLETEDTREATMENT';
</script>
<script src="~/scripts/EditStudy/PatientAccrual.js"></script>