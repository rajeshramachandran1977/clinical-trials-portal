@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard" id="Pandemicpreparednesstrialcategorizationcontents">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row noprint">
        <div class="wid_100">
            <img class="float-right mr-4 noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        <div id="displayPandemicpreparednesstrialcategorization">
            <div id="pandemicpreparednesstrialcategorization" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels" id="ui_lbl_pandemicpreparednesstrialcategorization"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextforpandemicpreparednesstrialcategorization" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_pandemicpreparednesstrialcategorization")
                    .DataTextField("Code")
                    .DataValueField("Code")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                    source.Read(read =>
                    {
                    read.Action("GetSysCodeValues",
                    "NewStudy",
                    new { type = @ConstDefaultValue.PANADEMICPREPAREDNESSTRIALCATEGORIZATION });
                    })
                    .ServerFiltering(true);
                    })
                    )
                </div>
            </div>
        </div>
        <div id="displaySafetymonitoringinterval">
            <div id="safetymonitoringinterval" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_safetymonitoringinterval"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextforsafetymonitoringinterval" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_safetymonitoringinterval")
                    .OptionLabel("Select")
                    .BindTo(new List<SelectListItem>
                        ()
                        {
                        new SelectListItem() {
                        Text = @ConstDefaultValue.YES,
                        Value = @ConstDefaultValue.YES
                        },
                        new SelectListItem() {
                        Text = @ConstDefaultValue.NO,
                        Value = @ConstDefaultValue.NO
                        }
                        })
                    )
                </div>
            </div>
        </div>
        <div id="displayMaximumallowabletimebetweenvisits">
            <div id="maximumallowabletimebetweenvisits">
                <label class="col-formEditStudy-labels " id="ui_lbl_safetymaximumallowabletimebetweenvisits"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextformaximumallowabletimebetweenvisits" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100" id="ui_txtarea_maximumallowabletimebetweenvisits" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100" id="ui_txt_maximumallowabletimebetweenvisits" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftformaximumallowabletimebetweenvisits"></label></span>
                    <input type="hidden" id="regexexprformaximumallowabletimebetweenvisits" />
                    <input type="hidden" id="validationmsgformaximumallowabletimebetweenvisits" />
                </div>
            </div>
        </div>
    </div>
    <div class="row float-right">
        <button type="submit" class="btn btn-primary mr-1" id="ui_btnSavePandemicPreparedness">Save</button>
        <button type="button" class="btn btn-primary mr-1" onclick="showDialogfornongrid();">Cancel</button>
    </div>
</div>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var pandemicpreparednessattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.PandemicPreparednessTrialCategorization)';
    var yes = '@ConstDefaultValue.YES';
    var no = '@ConstDefaultValue.NO';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var panademicpreparednesstrialcategorization = '@ConstDefaultValue.PANADEMICPREPAREDNESSTRIALCATEGORIZATION'
    var issafetymonitoringinterval = '@ConstDefaultValue.ISSAFETYMONITORINGINTERVAL'
    var maximumallowabletimebetweenvisits = '@ConstDefaultValue.MAXIMUMALLOWABLETIMEBETWEENVISITS';
</script>
<script src="~/scripts/EditStudy/PandemicPreparednessTrialCategorization.js"></script>