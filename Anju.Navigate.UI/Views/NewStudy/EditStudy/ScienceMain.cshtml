@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard" id="sciencemaincontents">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row">
        <div class="wid_100">
            <img class="float-right mr-4 noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        <div id="displaytitleoftrial">
            <div id="titleoftrial">
                <label class="col-formEditStudy-labels " id="ui_lbl_titleOfTrial"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextfortitleOfTrial" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_titleOfTrial" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_titleOfTrial">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftfortitleOfTrial"></label></span>
                    <input type="hidden" id="regexexprfortitleOfTrial" />
                    <input type="hidden" id="validationmsgfortitleOfTrial" />
                </div>
            </div>
        </div>
        <div id="displaystudydescriptors">
            <div id="studydescriptors" class="row">
                <div class="col-md-3">
                    <label class="col-formEditStudy-labels" id="ui_lbl_multistudydescriptors"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextformultistudydescriptors" data-toggle="tooltip" />
                </div>
                <div class="col-md-12">
                    <select id="ui_multistudydescriptors" name="ui_multistudydescriptors"></select>
                </div>
            </div>
        </div>
        <div id="displayinvestigationalDrugandReferenceTherapy">
            <div id="investigationalDrugandReferenceTherapy">
                <label class="col-formEditStudy-labels" id="ui_lbl_investigationalDrugandReferenceTherapy"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextforinvestigationalDrugandReferenceTherapy" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_InvestigationalDrugandReferenceTherapy" maxlength='1'></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_InvestigationalDrugandReferenceTherapy" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforInvestigationalDrugandReferenceTherapy"></label></span>
                    <input type="hidden" id="regexexprforinvestigationalDrugandReferenceTherapy" />
                    <input type="hidden" id="validationmsgforinvestigationalDrugandReferenceTherapy" />
                </div>
            </div>
        </div>
        <div id="displayGender">
            <div id="Gender" class="row">
                <div class="col-md-3">
                    <label class="col-formEditStudy-labels" id="ui_lbl_multiselectGender"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_multiselectGender" data-toggle="tooltip" />
                </div>
                <div class="col-md-12">
                    <select id="ui_multiselectGender" name="ui_multiselectGender"></select>
                </div>
            </div>
        </div>
        <div id="displaymaxAge">
            <div id="maxAge" class="row">
                <div class="col-md-3">
                    <label class="col-formEditStudy-labels" id="ui_lbl_maxAge"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_maxAge" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_maxAge")
                    .DataTextField("Code")
                    .DataValueField("Code")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                    source.Read(read =>
                    {
                    read.Action("GetSysCodeValues",
                    "NewStudy",
                    new { type = @ConstDefaultValue.MAXIMUMAGE });
                    });
                    })
                    )
                </div>
            </div>
        </div>
        <div id="displayexclusionCriteria">
            <div id="exclusionCriteria">
                <label class="col-formEditStudy-labels" id="ui_lbl_exclusionCriteria"></label>
                <img src="~/Images/helppic.gif" id="ui_img_exclusionCriteria" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_exclusioncriteria" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_exclusioncriteria" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforexclusioncriteria"></label></span>
                    <input type="hidden" id="regexforexclusionCriteria" />
                    <input type="hidden" id="validationmsgforexclusionCriteria" />
                </div>
            </div>
        </div>
        <div id="displayclinicalPharmacology">
            <div id="clinicalPharmacology">
                <label class="col-formEditStudy-labels" id="ui_lbl_clinicalPharmacology"></label>
                <img src="~/Images/helppic.gif" id="ui_img_clinicalPharmacology" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_clinicalPharmacology" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_clinicalPharmacology" maxlength="1">
                    <span class="float-right generic_text_small count"><label id="ui_lbl_charsleftforclinicalPharmacology"></label></span>
                    <input type="hidden" id="regexforclinicalPharmacology" />
                    <input type="hidden" id="validationmsgforclinicalPharmacology" />
                </div>
            </div>
        </div>
        <div id="displayinterventionstatus">
            <div id="interventionstatus" class="row">
                <div class="col-md-3">
                    <label class="col-formEditStudy-labels" id="ui_lbl_interventionstatus"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_interventionstatus" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_interventionstatus")
                    .DataTextField("Code")
                    .DataValueField("Code")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                    source.Read(read =>
                    {
                    read.Action("GetSysCodeValues",
                    "NewStudy",
                    new { type = @ConstDefaultValue.INTERVENTIONSTATUS });
                    });
                    })
                    )
                </div>
            </div>
        </div>
        <div id="displayIndicationforsciencemain">
            <div id="indicationforsciencemain">
                <label class="col-formEditStudy-labels" id="ui_lbl_indicationforsciencemain"></label>
                <img src="~/Images/helppic.gif" id="ui_img_indicationforsciencemain" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_indicationforsciencemain" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_indicationforsciencemain" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforindicationforsciencemain"></label></span>
                    <input type="hidden" id="regexforindicationforsciencemain" />
                    <input type="hidden" id="validationmsgforindicationforsciencemain" />
                </div>
            </div>
        </div>
        <div id="displayplacebocontrolled">
            <div id="placebocontrolled" class="row">
                <div class="col-md-3">
                    <label class="col-formEditStudy-labels" id="ui_lbl_placebocontrolled"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_placebocontrolled" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_placebocontrolled")
                    .OptionLabel("Select")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new List<SelectListItem>
                        () {
                        new SelectListItem() {
                        Text = @ConstDefaultValue.YES,
                        Value = @ConstDefaultValue.YES
                        },
                        new SelectListItem() {
                        Text = @ConstDefaultValue.NO,
                        Value = @ConstDefaultValue.NO
                        },
                        })
                    )
                </div>
            </div>
        </div>
        <div id="displaypatientype">
            <div id="patientype" class="row">
                <div class="col-md-3">
                    <label class="col-formEditStudy-labels" id="ui_lbl_multiselectpatientype"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_multiselectpatientype" data-toggle="tooltip" />
                </div>
                <div class="col-md-12">
                    <select id="ui_multiselectpatientype" name="ui_multiselectpatientype"></select>
                </div>
            </div>
        </div>
        <div id="displaypatientpopulation">
            <div id="patientpopulation">
                <label class="col-formEditStudy-labels" id="ui_lbl_patientpopulation"></label>
                <img src="~/Images/helppic.gif" id="ui_img_patientpopulation" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_patientpopulation" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_patientpopulation" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforpatientpopulation"></label></span>
                    <input type="hidden" id="regexforpatientpopulation" />
                    <input type="hidden" id="validationmsgforpatientpopulation" />
                </div>
            </div>
        </div>
        <div id="displaysafetycriteria">
            <div id="safetycriteria">
                <label class="col-formEditStudy-labels" id="ui_lbl_safetycriteria"></label>
                <img src="~/Images/helppic.gif" id="ui_img_safetycriteria" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_safetycriteria" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_safetycriteria" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforsafetycriteria"></label></span>
                    <input type="hidden" id="regexforsafetycriteria" />
                    <input type="hidden" id="validationmsgforsafetycriteria" />
                </div>
            </div>
        </div>
        <div id="displayothercompound">
            <div id="othercompound">
                <label class="col-formEditStudy-labels" id="ui_lbl_othercompound"></label>
                <img src="~/Images/helppic.gif" id="ui_img_othercompound" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_othercompound" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_othercompound" maxlength="1">
                    <input type="hidden" id="regexforothercompound" />
                    <input type="hidden" id="validationmsgforothercompound" />
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforothercompound"></label></span>
                </div>
            </div>
        </div>
        <div id="displayphases">
            <div id="phases">
                <label class="col-formEditStudy-labels" id="ui_lbl_phases"></label>
                <img src="~/Images/helppic.gif" id="ui_img_phases" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <div class="custom-control custom-checkbox custom-control-inline col-md-2 text-left">
                        <input type="checkbox" class="custom-control-input" id="PhaseI">
                        <label class="custom-control-label ui_label" for="PhaseI" id="ui_lbl_phasei"></label>
                    </div>
                    <div class="custom-control custom-checkbox custom-control-inline col-md-2 text-left">
                        <input type="checkbox" class="custom-control-input" id="PhaseII">
                        <label class="custom-control-label ui_label" for="PhaseII" id="ui_lbl_phaseii"></label>
                    </div>
                    <div class="custom-control custom-checkbox custom-control-inline col-md-2 text-left">
                        <input type="checkbox" class="custom-control-input" id="PhaseIII">
                        <label class="custom-control-label ui_label" for="PhaseIII" id="ui_lbl_phaseiii"></label>
                    </div>
                    <div class="custom-control custom-checkbox custom-control-inline col-md-2 text-left">
                        <input type="checkbox" class="custom-control-input" id="PhaseIV">
                        <label class="custom-control-label ui_label" for="PhaseIV" id="ui_lbl_phaseiv"></label>
                    </div>
                </div>
            </div>
        </div>
        <div id="displayrationaleforstudy">
            <div id="rationaleforstudy">
                <label class="col-formEditStudy-labels" id="ui_lbl_rationaleforstudy"></label>
                <img src="~/Images/helppic.gif" id="ui_img_rationaleforstudy" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_rationaleforstudy" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_rationaleforstudy" maxlength="1">
                    <input type="hidden" id="regexforrationaleforstudy" />
                    <input type="hidden" id="validationmsgforrationaleforstudy" />
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforrationaleforstudy"></label></span>
                </div>
            </div>
        </div>
        <div id="displaystudydesign">
            <div id="studydesign">
                <label class="col-formEditStudy-labels" id="ui_lbl_studydesign"></label>
                <img src="~/Images/helppic.gif" id="ui_img_studydesign" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_studydesign" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_studydesign" maxlength="1">
                    <input type="hidden" id="regexforstudydesign" />
                    <input type="hidden" id="validationmsgforstudydesign" />
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforstudydesign"></label></span>
                </div>
            </div>
        </div>
        <div id="displayminAge">
            <div id="minAge" class="row">
                <div class="col-md-3">
                    <label class="col-formEditStudy-labels" id="ui_lbl_minAge"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_minAge" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_minAge")
                    .DataTextField("Code")
                    .DataValueField("Code")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                    source.Read(read =>
                    {
                    read.Action("GetSysCodeValues",
                    "NewStudy",
                    new { type = @ConstDefaultValue.MINIMUMAGE });
                    });
                    })
                    )
                </div>
            </div>
        </div>
        <div id="displaykeyinclusioncriteria">
            <div id="keyinclusioncriteria">
                <label class="col-formEditStudy-labels" id="ui_lbl_keyinclusioncriteria"></label>
                <img src="~/Images/helppic.gif" id="ui_img_keyinclusioncriteria" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_keyinclusioncriteria" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_keyinclusioncriteria" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforkeyinclusioncriteria"></label></span>
                    <input type="hidden" id="regexforkeyinclusioncriteria" />
                    <input type="hidden" id="validationmsgforkeyinclusioncriteria" />
                </div>
            </div>
        </div>
        <div id="displaybasisfosamplesize">
            <div id="basisfosamplesize">
                <label class="col-formEditStudy-labels" id="ui_lbl_basisforsamplesize"></label>
                <img src="~/Images/helppic.gif" id="ui_img_basisforsamplesize" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_basisfosamplesize" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_basisfosamplesize" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforbasisfosamplesize"></label></span>
                    <input type="hidden" id="regexforbasisfosamplesize" />
                    <input type="hidden" id="validationmsgforbasisfosamplesize" />
                </div>
            </div>
        </div>
        <div id="displaytreatmentarmsapplyforthistrial">
            <div id="treatmentarmsapplyforthistrial">
                <label class="col-formEditStudy-labels" id="ui_lbl_treatmentarmsapplyforthistrial"></label>
                <img src="~/Images/helppic.gif" id="ui_img_treatmentarmsapplyforthistrial" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_treatmentarmsapplyforthistrial" maxlength="4000"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_treatmentarmsapplyforthistrial" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftfortreatmentarmsapplyforthistrial"></label></span>
                    <input type="hidden" id="regexfortreatmentarmsapplyforthistrial" />
                    <input type="hidden" id="validationmsgfortreatmentarmsapplyforthistrial" />
                </div>
            </div>
        </div>
    </div>
    <div class="row float-right">
        <button type="submit" class="btn btn-primary mr-1" id="ui_btnSaveScienceMain">Save</button>
        <button type="button" class="btn btn-primary mr-1" onclick="showDialogfornongrid();">Cancel</button>
    </div>
</div>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var scimainattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.ScienceMain)';
    var urlstudydescriptors = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.STUDYDESCRIPTORS})';
    var urlmultiselectpatienttype = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.PATIENTTYPE})';

    var url = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.PATIENTTYPE })';
    var url = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.RISKFACTORS })';
    var url = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.GENOMICPROFILE })';
    var url = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.LINEOFTHERAPY })';
    var url = '@Url.Action("GetSysCodeValues", "NewStudy", new {type = @ConstDefaultValue.DISEASEFORPATIENTPOPULATION })';
    var studytitle = '@ConstDefaultValue.STUDYTITLE';
    var studydescriptors = '@ConstDefaultValue.STUDYDESCRIPTORS';
    var investigationaldrugandreferencetherapy = '@ConstDefaultValue.INVESTIGATIONALDRUGANDREFERENCETHERAPY'
    var gender = '@ConstDefaultValue.GENDER';
    var exclusioncriteria = '@ConstDefaultValue.EXCLUSIONCRITERIA';
    var maximumage = '@ConstDefaultValue.MAXIMUMAGE';
    var clinicalpharmacology = '@ConstDefaultValue.CLINICALPHARMACOLOGY';
    var interventionstatus = '@ConstDefaultValue.INTERVENTIONSTATUS';
    var indicationforsciencemain = '@ConstDefaultValue.INDICATIONFORSCIENCEMAIN';
    var patienttype = '@ConstDefaultValue.PATIENTTYPE';
    var patientpopulation = '@ConstDefaultValue.PATIENTPOPULATION';
    var safetycriteria = '@ConstDefaultValue.SAFETYCRITERIA';
    var othercompound = '@ConstDefaultValue.OTHERCOMPOUND';
    var studyphase = '@ConstDefaultValue.STUDYPHASE';
    var phasei = '@ConstDefaultValue.PHASEI';
    var phaseii = '@ConstDefaultValue.PHASEII';
    var phaseiii = '@ConstDefaultValue.PHASEIII';
    var phaseiv = '@ConstDefaultValue.PHASEIV';
    var rationaleforstudy = '@ConstDefaultValue.RATIONALEFORSTUDY';
    var studydesign = '@ConstDefaultValue.STUDYDESIGN';
    var minimumage = '@ConstDefaultValue.MINIMUMAGE';
    var inclusioncriteria = '@ConstDefaultValue.INCLUSIONCRITERIA';
    var basisforsamplesize = '@ConstDefaultValue.BASISFORSAMPLESIZE';
    var treatmentarmsapplyforthistrial = '@ConstDefaultValue.TREATMENTARMSAPPLYFORTHISTRIAL';
    var placebocontrolled = '@ConstDefaultValue.PLACEBOCONTROLLED';
    var characterslefttoenter = '@ConstDefaultValue.CHARACTERSLEFTTOENTER'

    var yes = '@ConstDefaultValue.YES';
    var no = '@ConstDefaultValue.NO';

     function onCancel() {
        window.location.href = "/NewStudy/EditStudy";
    }

</script>
<script src="~/scripts/EditStudy/ScienceMain.js"></script>