@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard" id="studycoumpoundscontents">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row noprint mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_AddStudyComponents" onclick="addStudyComponents()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    @(Html.Kendo().Grid<Anju.Navigate.Data.StudyCompounds>
    ()
    .Name("ui_dtg_gridstudycompounds")
    .Columns(columns =>
    {
        columns.Bound(c => c.StudyComponentId).Hidden(true);
        columns.Bound(c => c.StudyId).Hidden(true);
        columns.Bound(c => c.CompoundType).Width("20%").Title("Compound Type");
        columns.Bound(c => c.CompanyCompound).Width("20%").Title("Company Compound");
        columns.Bound(c => c.NonCompanyCompound).Width("20%").Title("Non-Company Compound");
        columns.Bound(c => c.CompoundCategory).Width("20%").Title("Compound Category");
        columns.Command(command => command.Custom("Tag").Text("Edit").Click("showStudycompounds")).Width("10%");
        columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteStudycompounds")).Width("10%");
    })
    .Events(events => events.DataBound("OnDataBoundforStudyCompounds"))
    .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label" })
    .Scrollable()
    .Groupable(false)
    .Sortable()
    .Editable(editable => editable.Mode(GridEditMode.InCell).DisplayDeleteConfirmation(false))
    .Pageable(pageable => pageable
    .Refresh(true)
    .PageSizes(true)
    .ButtonCount(5))
    .DataSource(dataSource => dataSource
    .Ajax()
    .Model(model => model.Id(p => p.StudyComponentId))
    .Read(read => read.Action("GetStudyCompounds", "NewStudy"))
    .Destroy(update => update.Action("DeleteStudyCompounds", "NewStudy"))
    )
    )
    @(Html.Kendo().Window()
    .Name("StudyCompounds")
    .Title("Study Compounds")
    .Actions(actions => actions.Clear())
    .Visible(false)
    .Modal(true)
    .Draggable(true)
    .Width(800)
    )
</div>
<script type="text/x-kendo-template" id="studycompoundstemplate">
    <div id="details-container">
        <form id="ui_frm_studycompounds" ">
            <span id="popupNotification"></span>
            <div class="card p-2">
                <div id="flex">
                    <input type="hidden" id="ui_num_studycomponentid" min="1" data-bind="value:ui_num_studycomponentid" />
                    <div id="displayCompoundtype">
                        <div id="compoundtype" class="row">
                            <div class="col-md-4">
                                <label class="col-formEditStudy-labels" id="ui_lbl_compoundtype"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcompoundtype" data-toggle="tooltip" />
                            </div>
                            <div class="col-md-4">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_compoundtype")
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .HtmlAttributes(new { @class = "wid_100" })
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetSysCodeValues",
                                        "NewStudy",
                                        new { type = @ConstDefaultValue.COMPOUNDTYPE });
                                    })
                                    .ServerFiltering(true);
                                })
                                .ToClientTemplate()
                                )
                            </div>
                        </div>
                    </div>
                    <div id="displayPrimary">
                        <div id="primary" class="row">
                            <div class="col-md-4">
                                <label class="col-formEditStudy-labels" id="ui_lbl_companycompound"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcompoundprimary" data-toggle="tooltip" />
                            </div>
                            <div class="col-md-4">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_companycompound")
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .HtmlAttributes(new { @class = "wid_100" })
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues",
                                "NewStudy",
                                new { type = @ConstDefaultValue.PRIMARY });
                                })
                                .ServerFiltering(true);
                                })
                                .ToClientTemplate()
                                )
                            </div>
                        </div>

                    </div>
                    <div id="displayNoncompanycompound">
                        <div id="noncompanycompound" class="row">
                            <div class="col-md-4">
                                <label class="col-formEditStudy-labels" id="ui_lbl_noncompanycompound"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextfornoncompanycompound" data-toggle="tooltip" />
                            </div>
                            <div class="col-md-4">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_noncompanycompound")
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .HtmlAttributes(new { @class = "wid_100" })
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues",
                                "NewStudy",
                                new { type = @ConstDefaultValue.NONCOMPANYCOMPOUND });
                                })
                                .ServerFiltering(true);
                                })
                                .ToClientTemplate()
                                )
                            </div>
                        </div>
                    </div>
                    <div id="displayDrugorCompoundcategory">
                        <div id="drugorCompoundcategory" class="row">
                            <div class="col-md-4">
                                <label class="col-formEditStudy-labels" id="ui_lbl_compoundcategory"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforcompoundcategory" data-toggle="tooltip" />
                            </div>
                            <div class="col-md-4">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_compoundcategory")
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .HtmlAttributes(new { @class = "wid_100" })
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues",
                                "NewStudy",
                                new { type = @ConstDefaultValue.DRUGORCOMPOUNDTYPEFORSECONDARY });
                                })
                                .ServerFiltering(true);
                                })
                                .ToClientTemplate()
                                )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row float-right mt-2">
                <button type="button" class="btn btn-primary mr-1" id="ui_btnSavestudycompounds">Save</button>
                <button type="button" class="btn btn-primary mr-3" onclick="showDialog();">Cancel</button>
            </div>
        </form>
    </div>
</script>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var studycomponentsattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.StudyCompounds)';
    var deleteMsg = '@Messages.DELETEMESSAGETITLEBOX';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var primary = '@ConstDefaultValue.PRIMARY';
    var compoundtype = '@ConstDefaultValue.COMPOUNDTYPE';
    var noncompanycompound = '@ConstDefaultValue.NONCOMPANYCOMPOUND';
    var drugorcompoundsecondarytype =  '@ConstDefaultValue.DRUGORCOMPOUNDTYPEFORSECONDARY';
</script>
<script src="~/scripts/EditStudy/StudyCoumpounds.js"></script>