@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard" id="pharmacovigilancecontents">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row">
        <div class="wid_100">
            <img class="float-right mr-4 noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        <div id="displayDatacollectioninterventional">
            <div id="datacollectioninterventional" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_datacollectioninterventional"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextfordatacollectioninterventional" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                        .Name("ui_ddl_interventionaltrial")
                        .DataTextField("Code")
                        .DataValueField("Code")
                        .OptionLabel("Select")
                        .DataSource(source =>
                        {
                        source.Read(read =>
                        {
                        read.Action("GetSysCodeValues",
                        "NewStudy",
                        new { type = @ConstDefaultValue.DATACOLLECTIONINTERVENTIONAL });
                        })
                        .ServerFiltering(true);
                        })
                    )
                </div>
            </div>
        </div>
        <div id="displayDatacollectionnoninterventional">
            <div id="datacollectionnoninterventional" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_datacollectionnoninterventional"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextfordatacollectionnoninterventional" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_noninterventionalTrial")
                            .DataTextField("Code")
                            .DataValueField("Code")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                            source.Read(read =>
                            {
                            read.Action("GetSysCodeValues",
                            "NewStudy",
                            new { type = @ConstDefaultValue.DATACOLLECTIONNONINTERVENTIONAL });
                            })
                            .ServerFiltering(true);
                            })
                    )
                </div>
            </div>
        </div>
        <div id="displayOccurrenceofotherspecialscenarios">
            <div id="occurrenceofotherspecialscenarios" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_occurrenceofotherspecialscenarios"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextforoccurrenceofotherspecialscenarios" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_occurrenceofotherspecialscenarios")
                    .OptionLabel("Select")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new List<SelectListItem>
                        ()
                        {
                        new SelectListItem() {
                        Text = @ConstDefaultValue.YES,
                        Value = @ConstDefaultValue.YES
                        },
                        new SelectListItem() {
                        Text = @ConstDefaultValue.NO,
                        Value = @ConstDefaultValue.NO
                        }
                        })
                    )
                </div>
            </div>
        </div>
        <div id="displayAllnonseriousAEs">
            <div id="allnonseriousAEs" class="row">
                <div class="col-md-4">
                    <label class="col-formEditStudy-labels " id="ui_lbl_allnonseriousaes"></label>
                    <img src="~/Images/helppic.gif" id="ui_img_helpTextforallnonseriousaes" data-toggle="tooltip" />
                </div>
                <div class="col-md-3">
                    @(Html.Kendo().DropDownList()
                    .Name("ui_ddl_allnonseriousaes")
                    .OptionLabel("Select")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new List<SelectListItem>
                        ()
                        {
                        new SelectListItem() {
                        Text = @ConstDefaultValue.YES,
                        Value = @ConstDefaultValue.YES
                        },
                        new SelectListItem() {
                        Text = @ConstDefaultValue.NO,
                        Value = @ConstDefaultValue.NO
                        }
                        })
                    )
                </div>
            </div>
        </div>
        <div id="displaySpecifywhatsafetydata">
            <div id="specifywhatsafetydata">
                @*<div id="InvolvingPRIMARYDATACOLLECTIONWITHOUT">*@
                <label class="col-formEditStudy-labels " id="ui_lbl_specifywhatsafetydata"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextforspecifywhatsafetydata" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_specifywhatsafetydata" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_specifywhatsafetydata" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforspecifywhatsafetydata"></label></span>
                    <input type="hidden" id="regexexprforspecifywhatsafetydata" />
                    <input type="hidden" id="validationmsgforspecifywhatsafetydata" />
                </div>
            </div>
            @*</div>*@
        </div>
        <div id="displayAdverseEvents">
            <div id="adverseEvents">
                <label class="col-formEditStudy-labels" id="ui_lbl_adverseEvents"></label>
                <img src="~/Images/helppic.gif" id="ui_img_helpTextforadverseEvents" data-toggle="tooltip" />
                <div class="col-md-12 p-md-0">
                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_adverseevents" maxlength="1"></textarea>
                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_adverseevents" maxlength="1">
                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforadverseEvents"></label></span>
                    <input type="hidden" id="regexexprforadverseEvents" />
                    <input type="hidden" id="validationmsgforadverseEvents" />
                </div>
            </div>
        </div>
    </div>
    <div class="row float-right">
        <button type="submit" class="btn btn-primary mr-1" id="ui_btnSavePharmacovigilance">Save</button>
        <button type="button" class="btn btn-primary mr-1" onclick="showDialogfornongrid();">Cancel</button>
    </div>
</div>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var pharmacovigilanceattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.Pharmacovigilance)';

    var datacollectioninterventional = '@ConstDefaultValue.DATACOLLECTIONINTERVENTIONAL';
    var datacollectionnoninterventional = '@ConstDefaultValue.DATACOLLECTIONNONINTERVENTIONAL';
    var occurrenceofotherspecialscenarios = '@ConstDefaultValue.OCCURRENCEOFOTHERSPECIALSCENARIOS';
    var allnonseriousaes = '@ConstDefaultValue.ALLNONSERIOUSAES';
    var safetydata = '@ConstDefaultValue.SAFETYDATA';
    var adverseevents = '@ConstDefaultValue.ADVERSEEVENTS';

    var yes = '@ConstDefaultValue.YES';
    var no = '@ConstDefaultValue.NO';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
</script>
<script src="~/scripts/EditStudy/Pharmacovigilance.js"></script>