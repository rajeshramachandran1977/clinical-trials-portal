@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
<head>
    <meta http-equiv="Cache-control" content="no-cache">
    <meta http-equiv="Expires" content="-1">
</head>
<div class="editcard" id="studyprotocolnumberscontents">
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />
    <div class="row noprint mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_AddStudyProtocolNumbers" onclick="addStudyProtocolNumbers()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    @(Html.Kendo().Grid<Anju.Navigate.Data.StudyProtocol>
    ()
    .Name("ui_dtg_gridstudyprotocol")
    .Columns(columns =>
    {
        columns.Bound(c => c.StudyProtocolId).Hidden(true);
        columns.Bound(c => c.StudyId).Hidden(true);
        columns.Bound(c => c.StudyProtocolnos).Width("40%").Title("Study / Protocol Number(s)");
        columns.Bound(c => c.Organization).Width("40%").Title("Organization");
        columns.Command(command => command.Custom("Tag").Text("Edit").Click("showStudyProtocolNumbers")).Width("10%");
        columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteStudyProtocol")).Width("10%");
    })
    .Events(events => events.DataBound("OnDataBoundforStudyProtocol"))
    .HtmlAttributes(new { style = "height:50vh", @class = "ui_label" })
    .Scrollable()
    .Groupable(false)
    .Sortable()
    .Editable(editable => editable.Mode(GridEditMode.InCell).DisplayDeleteConfirmation(false))
    .Pageable(pageable => pageable
    .Refresh(true)
    .PageSizes(true)
    .ButtonCount(5))
    .DataSource(dataSource => dataSource
    .Ajax()
    .Model(model => model.Id(p => p.StudyProtocolId))
    .Read(read => read.Action("GetStudyProtocols", "NewStudy"))
    .Destroy(update => update.Action("DeleteStudyProtocols", "NewStudy"))
    )
    )
    @(Html.Kendo().Window()
    .Name("Studyprotocols")
    .Title("Study Protocols")
    .Actions(actions => actions.Clear())
    .Visible(false)
    .Modal(true)
    .Draggable(true)
    .Width(800)
    )


</div>
<script type="text/x-kendo-template" id="studyprotocolnumberstemplate">
    <div id="details-container">
        <form id="ui_frm_studyprotocolnumbers">
            <span id="popupNotification"></span>
            <div class="card p-2">
                <div id="flex">
                    <input type="hidden" id="ui_num_studyprotocolid" min="1" data-bind="value:ui_num_studyprotocolid" />
                    <div id="flex">
                        <div id="displayOrganization">
                            <div id="organization" class="row">
                                <div class="col-md-3">
                                    <label class="col-formEditStudy-labels " id="ui_lbl_organization"></label>
                                    <img src="/Images/helppic.gif" id="ui_img_helpTextfororganization" data-toggle="tooltip" />
                                </div>
                                <div class="col-md-3">
                                    @(Html.Kendo().DropDownList()
                                     .Name("ui_ddl_organization")
                                     .DataTextField("Code")
                                     .DataValueField("Code")
                                     .OptionLabel("Select")
                                     .DataSource(source =>
                                     {
                                        source.Read(read =>
                                        {
                                        read.Action("GetSysCodeValues",
                                        "NewStudy",
                                        new { type = @ConstDefaultValue.ORGANIZATION });
                                        })
                                        .ServerFiltering(true);
                                     })
                                     .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                        <div id="displayStudyProtocolNumbers">
                            <div id="studyprotocolnumberserrmsg">
                                <label class="col-formEditStudy-labels " id="ui_lbl_studyprotocolnumbers"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforstudyprotocolnumbers" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_studyprotocolnumbers"></textarea>
                                    <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_studyprotocolnumbers">
                                    <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforstudyprotocolnumbers"></label></span>
                                    <input type="hidden" id="regexexprforstudyprotocolnumbers" />
                                    <input type="hidden" id="validationmsgforstudyprotocolnumbers" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row float-right mt-2">
                <button type="button" class="btn btn-primary mr-1" id="ui_btnSavestudyprotocolnos">Save</button>
                <button type="button" class="btn btn-primary mr-3" onclick="showDialog();">Cancel</button>
            </div>
        </form>
    </div>
</script>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var charslefttoenter = '@ConstDefaultValue.CHARACTERSLEFTTOENTER';
    var deleteMsg = '@Messages.DELETEMESSAGETITLEBOX';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
    var studyprotocolsattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.StudyProtocolNumbers)';

    var studyprotocolnumbers = '@ConstDefaultValue.STUDYPROTOCOLNUMBERS';
    var organization = '@ConstDefaultValue.ORGANIZATION';
</script>
<script src="~/scripts/EditStudy/StudyProtocolNumbers.js"></script>

