        isregexexprforversion = true;

        $.ajax({
            async: true,
            type: "GET",
            url: "/NewStudy/Submissions/",
            data: { "mode": "Edit", "docid": parseInt(dataItem.SubmissionId) },
            success: function (response) {
                $('#SubmissionsforEditStudy').html(response);
            },
            failure: function (response) {
                popupNotification.show(errorsinthepage, "error");
            }
        });

        //$("#uploadsubmissiondetailseditmode").data("kendoUpload").value(dataItem.Submissiondetails);
        $('#ui_num_submissionsideditmode').val(dataItem.SubmissionId);
        $("#ui_ddl_submissiontypeeditmode").data('kendoDropDownList').value(dataItem.Submissiontype);
        $("#ui_txt_versioneditmode,#ui_txtarea_versioneditmode").val(dataItem.Submissionversion);
        $("#ui_dt_studyeligibilitydateeditmode").data("kendoDatePicker").value(dataItem.Studyeligibilitydate);
        $("#ui_dt_submissiondateeditmode").data("kendoDatePicker").value(dataItem.Submissiondate);

        if (dataItem.Submissiondetails == null) {
            $("#uploadsubmissiondetailseditmode").kendoUpload({
                async: {
                    saveUrl: "/NewStudy/CreateUpdateSubmissionsEditMode",
                    autoUpload: false
                },
                 multiple: false,
                select: onSelectsubmissiondetailsEditMode,
                upload: onUploadsubmissiondetailsEditMode
            });
        }
        else {
            var files = [{ name: dataItem.Submissiondetails, size: dataItem.DocumentSize, extension: dataItem.DocumentExtension }];

            $("#uploadsubmissiondetailseditmode").kendoUpload({
                async: {
                    saveUrl: "/NewStudy/CreateUpdateSubmissionsEditMode",
                    autoUpload: false
                },
                 multiple: false,
                select: onSelectsubmissiondetailsEditMode,
                upload: onUploadsubmissiondetailsEditMode,
                files: files
            });

            var fileName = dataItem.Submissiondetails;
            var subModuleFolderName = "Submissions";
            var studyId = dataItem.StudyId;
            $('.fileDownload').click(function () {
                window.location = "/NewStudy/DownloadFiles?fileName=" + fileName + '&&subModuleFolderName=' + subModuleFolderName + '&&studyId=' + studyId;

            });

        }

        $("#ui_btnSavesubmissionseditmode").click(function () {
            ValidateSubmissonsFieldsinEditMode();
            if (retval === true && isregexexprforversion === true) {
                $(".k-upload-selected").click();
                Savedetails(type = 29, objEditstudy = objSubmissons);   
                $("#Submissionswindow").data("kendoWindow").close();
                $("#ui_dtg_Submissions").data("kendoGrid").dataSource.read();
                $("#ui_dtg_Submissions").data("kendoGrid").refresh();
            }
        });

    }


    //#endregion

</script>
