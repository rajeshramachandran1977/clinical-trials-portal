        function UpdateDcouemntDetails() {
            if (retVal === true) {
                var upload = $("#uploadfileseditmode").data("kendoUpload"),
                files = upload.getFiles();
                objDocumentDetails = new Object();
                objDocumentDetails.DocumentId =  documentId;
                objDocumentDetails.StudyId = studyId;
                objDocumentDetails.SubModuleName = subModuleFolderName;
                objDocumentDetails.DocumentName = files[0].name;
                objDocumentDetails.DocumentNameWithOutExtension = DocumentNameWithOutExtension;
                objDocumentDetails.DocumentExtension = DocumentExtension;
                objDocumentDetails.DocumentStatus = $("#ui_ddl_editdocumentStatus").val();
                objDocumentDetails.DocumentType =  $('#ui_ddl_editdocumentType').val();
                objDocumentDetails.DocumentSubType = $("#ui_ddl_editdocumentSubType").val();
                objDocumentDetails.DocumentVersion = $("#ui_ddl_editamendmentVersion").val();
                objDocumentDetails.OriginalDate = $("#ui_dt_editeditoriginalDate").val();
                objDocumentDetails.ExpirationDate = $("#ui_dt_editeditexpirationDate").val();
                objDocumentDetails.Anju_ChangedBy = $("#ui_lbl_uploadedpersoneditmode").val();
                $.ajax({
                    async: false,
                    type: "POST",
                    url: "/TaskWorkFlow/UpdateDocumentDetails",
                    data: { "documents": objDocumentDetails },
                    success: function (results) {
                        if (results.msgType === "Success") {
                           $("#ui_dtg_Documents").data("kendoGrid").dataSource.read();
                           $("#ui_dtg_Documents").data("kendoGrid").refresh();
                           $("#Documents").data("kendoWindow").close();

                        }
                        else {
                            popupNotification.show(results.msgType, "error");
                        }
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        popupNotification.show('Error', "error");
                    }
                });
            }
            else {

                popupNotification.show(errorsinthepage, "error");
            }
        }

    }

