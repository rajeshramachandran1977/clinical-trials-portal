@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@using Anju.Navigate.Utilities;
@using Anju.Navigate.UI;
@model Anju.Navigate.Data.ListOfSubmissions
<div class="overflowHidden" id="submissiondetails">
    <input type="hidden" value="@ViewBag.Username" id="Username" />
    <div class="row mb-2">
        <div class="col-md-12">
            <button type="button" class="btn btn-primary" id="ui_btn_AddSubmissions" data-target="#addSubmissionsModal" data-toggle="modal" onclick="addSubmissions()"><span class="k-icon k-i-plus"></span>Add</button>
            <img class="float-right noprint" src="~/Images/print.gif" id="ui_img_print" onclick="Print()" data-toggle="tooltip" title='@Messages.PRINTERICON' />
        </div>
    </div>
    <div id="flex">
        @(Html.Kendo().Grid<Anju.Navigate.Data.Submissions>
        ()
        .Name("ui_dtg_Submissions")
        .Columns(columns =>
        {
            columns.Bound(c => c.SubmissionId).Hidden(true);
            columns.Bound(c => c.StudyId).Hidden(true);
            columns.Bound(c => c.Submissiontype).Width("20%").Title("Submission Type ");
            columns.Bound(c => c.Submissionversion).Width("20%").Title("Version");
            columns.Bound(c => c.Studyeligibilitydate).Width("20%").Title("Study eligibility date").ClientTemplate("#= Studyeligibilitydate ? kendo.toString(kendo.parseDate(Studyeligibilitydate), 'MMM dd, yyyy') : '' #");
            columns.Bound(c => c.Submissiondate).Width("15%").Title("Submission Date").ClientTemplate("#= Submissiondate ? kendo.toString(kendo.parseDate(Submissiondate), 'MMM dd, yyyy') : '' #");
            columns.Bound(c => c.Submissiondetails).Width("15%").Title("Submission Details").ClientTemplate(" <a onclick='Show(this);' href=\\#>#= Submissiondetails#</a> ");
            columns.Command(command => command.Custom("Tag").Text("Edit").Click("showSubmissions")).Width("10%");
            columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteSubmissions")).Width("10%");
        })
        .Events(events => events.DataBound("OnDataBoundforSubmissions"))
            .HtmlAttributes(new { style = "height:50vh;", @class = "ui_label" })
            .Scrollable()
            .Groupable(false)
            .Sortable()
            .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(10))
            .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(p => p.SubmissionId))
            .Read(read => read.Action("GetSubmissionsByStudyID", "NewStudy").Data("additionalInfo"))
            .Destroy(update => update.Action("DeleteSubmissions", "NewStudy"))
            ))
        @(Html.Kendo().Window()
        .Name("Submissionswindow")
        .Title("Submissions")
        .Actions(actions => actions.Clear())
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(1000)
        )
    </div>
</div>

<script type="text/x-kendo-template" id="submissionstemplate">
    <div id="details-container">
        <form id="ui_frm_submissions" >
            <span id="popupNotification"></span>
            <div class="card p-2">
