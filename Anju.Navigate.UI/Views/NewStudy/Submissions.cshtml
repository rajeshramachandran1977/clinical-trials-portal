               .Files(files =>
               {

                   foreach (var f in Model.Submissions)
                   {
                       // files.Add().Name(f.Submissiondetails);

                       files.Add().Name(f.Submissiondetails).Extension(f.DocumentExtension).Size(f.DocumentSize);

                   }

               })
              .ToClientTemplate()
            )
        }*@
                                    <input type="file" name="files" id="uploadsubmissiondetailseditmode" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row float-right mt-2">
                <button type="button" class="btn btn-primary mr-1" id="ui_btnSavesubmissionseditmode">Save</button>
                <button type="button" class="btn btn-primary mr-3" onclick="showDialog();">Cancel</button>
