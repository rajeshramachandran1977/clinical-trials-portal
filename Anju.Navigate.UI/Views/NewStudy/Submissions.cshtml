                                <label class="col-formEditStudy-labels " id="ui_lbl_submissiondateeditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforsubmissiondateeditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @(Html.Kendo().DatePicker()
                                        .Name("ui_dt_submissiondateeditmode")
                                        .Start(CalendarView.Month)
                                        .Depth(CalendarView.Month)
                                        .Format("MMM dd, yyyy")
                                        .DateInput()
                                        .HtmlAttributes(new { title = "monthpicker" })
                                        .ToClientTemplate()
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="displaySubmissiondetailseditmode" class="col-md-6">
                            <div id="submissiondetailseditmode">
                                <label class="col-formEditStudy-labels mandatory" id="ui_lbl_submissiondetailseditmode"></label>
                                <img src="/Images/helppic.gif" id="ui_img_helpTextforsubmissiondetailseditmode" data-toggle="tooltip" />
                                <div class="col-md-12 p-md-0">
                                    @*@if (Model != null)
        {
            @(Html.Kendo().Upload()
              .Name("uploadsubmissiondetailseditmode")
              .Multiple(false)
              .Async(a => a
              .Save("CreateUpdateSubmissionsEditMode", "NewStudy")
              //.Remove("RemoveLMRCFinalRejectedOrWithdrawalDocuments", "TaskWorkFlow")
              .AutoUpload(false)
              )
              .Events(events => events
              .Upload("onUploadsubmissiondetailsEditMode")
              .Select("onSelectsubmissiondetailsEditMode")
