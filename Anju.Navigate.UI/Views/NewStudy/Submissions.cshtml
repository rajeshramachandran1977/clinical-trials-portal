    </div>
</script>

<div class="modal fade" id="addSubmissionsModal">
    <div class="modal-dialog" id="modalEditStudyDialog">
        <div class="modal-content">
            <form method="post" id="ui_frm_submissions">
                <div id="details-container">
                    <span id="popupNotification"></span>
                    <div class="modal-body">
                        <div id="flex">
                            <input type="hidden" id="ui_num_submissionsid" min="1" data-bind="value:ui_num_submissionsid" />
                            <div class="row">
                                <div id="displaySubmissiontype" class="col-md-6">
                                    <div id="submissiontype">
                                        <label class="col-formEditStudy-labels" id="ui_lbl_submissiontype"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextforsubmissiontype" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DropDownList()
                                               .Name("ui_ddl_submissiontype")
                                               .HtmlAttributes(new { @class = "wid_100" })
                                               .DataTextField("Code")
                                               .DataValueField("Code")
                                               .OptionLabel("Select")
                                               .DataSource(source =>
                                               {
                                               source.Read(read =>
                                               {
                                               read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.SUBMISSIONTYPE });
                                               })
                                               .ServerFiltering(true);
                                               })
                                            )
                                        </div>
                                    </div>
                                </div>
                                <div id="displayVersion" class="col-md-6">
                                    <div id="version">
                                        <label class="col-formEditStudy-labels" id="ui_lbl_version"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextforversion" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            <textarea rows="4" class="k-textbox wid_100 ml-0" id="ui_txtarea_version" maxlength="1"></textarea>
                                            <input type="text" class="k-textbox wid_100 ml-0" id="ui_txt_version" maxlength="1">
                                            <span class="generic_text_small float-right count"><label id="ui_lbl_charsleftforversion"></label></span>
                                            <input type="hidden" id="regexexprforversion" />
                                            <input type="hidden" id="validationmsgforversion" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div id="displayStudyeligibilitydate" class="col-md-6">
                                    <div id="studyeligibilitydate">
                                        <label class="col-formEditStudy-labels " id="ui_lbl_studyeligibilitydate"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextforstudyeligibilitydate" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DatePicker()
                                                .Name("ui_dt_studyeligibilitydate")
                                                .Start(CalendarView.Month)
                                                .Depth(CalendarView.Month)
                                                .Format("MMM dd, yyyy")
                                                .DateInput()
                                                .HtmlAttributes(new { title = "monthpicker" })
                                            )
                                        </div>
                                    </div>
                                </div>
                                <div id="displaySubmissiondate" class="col-md-6">
                                    <div id="submissiondate">
                                        <label class="col-formEditStudy-labels " id="ui_lbl_submissiondate"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextforsubmissiondate" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @(Html.Kendo().DatePicker()
                                                .Name("ui_dt_submissiondate")
                                                .Start(CalendarView.Month)
                                                .Depth(CalendarView.Month)
                                                .Format("MMM dd, yyyy")
                                                .DateInput()
                                                .HtmlAttributes(new { title = "monthpicker" })
                                            )
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div id="displaySubmissiondetails" class="col-md-6">
                                    <div id="submissiondetails">
                                        <label class="col-formEditStudy-labels mandatory" id="ui_lbl_submissiondetails"></label>
                                        <img src="/Images/helppic.gif" id="ui_img_helpTextforsubmissiondetails" data-toggle="tooltip" />
                                        <div class="col-md-12 p-md-0">
                                            @if (Model != null)
                                            {
                                                @(Html.Kendo().Upload()
                                                  .Name("uploadsubmissiondetailsaddmode")
                                                  .Multiple(false)
                                                  .Async(a => a
                                                  .Save("CreateUpdateSubmissionsAddMode", "NewStudy")
                                                  .Remove("RemoveLMRCFinalRejectedOrWithdrawalDocuments", "TaskWorkFlow")
                                                  .AutoUpload(false)
                                                  )
                                                  .Events(events => events
                                                  .Upload("onUploadsubmissiondetailsAddMode")
                                                  .Select("onSelectsubmissiondetailsAddMode")
                                                  )
                                                //.Files(files =>
                                                //{
                                                //     foreach (var f in Model.Submissions)
                                                //     {
                                                //       files.Add().Name(f.Submissiondetails);
                                                //     }
                                                //})
                                                )
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer p-1">
                        <button type="button" class="btn btn-primary" id="ui_btnSaveSubmissonsaddmode">Save</button>
                        <button type="button" class="btn btn-primary mr-1" onclick="showDialog();">Cancel</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script src="~/scripts/Common/Common.js"></script>
<script>
    var submissionsattributeid = '@EnumExtension.ToId(ConstDefaultValue.AttributeId.Submissions)';
    var submissiontype = '@ConstDefaultValue.SUBMISSIONTYPE';
    var submissionsversion = '@ConstDefaultValue.SUBMISSIONSVERSION';
    var studyeligibilitydate = '@ConstDefaultValue.STUDYELIGIBILITYDATE';
    var submissiondate = '@ConstDefaultValue.SUBMISSIONDATE';
    var submissiondetails = '@ConstDefaultValue.SUBMISSIONDETAILS';
    var errorsinthepage = '@Messages.ERRORSINTHEPAGE';
</script>
<script src="~/scripts/EditStudy/Submissions.js"></script>