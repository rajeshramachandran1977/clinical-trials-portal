@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI
@{
    ViewData["Title"] = "Scientific Rationale II";
    Layout = "~/Views/Shared/_Site.cshtml";
}
@using Anju.Navigate.Utilities;
<link rel="stylesheet" href="~/css/navigateStyles.css" />

<form role="form" id="ui_frmNewStudyII" class="newWindowMargin p-md-4 shadow-lg" method="post">
    <span id="popupNotification"></span>
    <div class="row">
        <div class="col-md-4 pb-2">
            <img src="~/Images/Research_ICON2.png" class="register_img" />
            @if (@ViewBag.pITaskStatus?.ToUpper() == @ConstDefaultValue.SUBMITPROTOCOL.ToUpper())
            {
                <label class="task_heading" id="taskHeading">Submit Protocol</label>
            }
            else if (@ViewBag.TaskName?.ToUpper() == @ConstDefaultValue.RESUBMITPROTOCOL.ToUpper())
            {
                <label class="task_heading" id="taskHeading">Resubmit Protocol</label>
            }
            else
            {
                <label class="task_heading" id="taskHeading">New Proposal Submission</label>
            }
        </div>
        <div class="col-md-8 text-right">
            <label class="ui_label">Welcome @ViewBag.Username</label>
        </div>
    </div>
    <div class="card col-md-12 p-md-2">
        <div class="padding_left_100px">
            <div class="row">
                <div>
                    <input type="button" class="btn btn-submission no-click" id="scientificRationale" value="Scientific Rationale" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click wid_250px" id="personnelResearchSites" value="Personnel & Research Sites" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click" id="requestedSupport" value="Requested Support" />
                    <span class=" k-icon k-i-arrow-right font_30 arrow_icon_clr"></span>
                    <input type="button" class="btn btn-submission no-click" id="confirmation" value="Confirmation" />
                </div>
            </div>
            <div class="row">
                <button type="button" class="btn btn-submission no-click height_30px width_5" id="1">1</button>
                <button type="button" class="btn btn-submission no-click height_30px width_5 ml-1" id="2">2</button>
            </div>
        </div>

        <div class="row mt-md-2">
            <div class="col-md-8 border-right">
                <div class="btn-group">
                    <button class="btn btn-primary ml-md-4" id="ui_btnPreviousSection" type="submit">Previous Section</button>
                </div>
                <div class="btn-group float-right">
                    <button type="button" class="btn btn-primary" onclick="deleteNewStudyDialog();" id="deleteBtn">Delete Current Submission</button>
                </div>
            </div>
            <div class="col-md-4">
                <input type="hidden" value="@ViewBag.mode" id="mode" />
                <input type="hidden" value="@ViewBag.StudyId" id="StudyId" />
                <input type="hidden" value="@ViewBag.StudyType" id="StudyType" />
                <input type="hidden" value="@ViewBag.pITaskStatus" id="pITaskStatus" />
                <input type="hidden" value="@ConstDefaultValue.SUBMITPROTOCOL" id="pIsubmitprotocol" />
                <input type="hidden" value="@ViewBag.TaskName" id="TaskName" />
                <input type="button" class="btn btn-primary" onclick="showDialog();" value="Cancel" />
                <button type="button" id="ui_btnSaveandExit" class="btn btn-primary">Save & Exit</button>
                <button type="button" id="ui_btnSaveandContinue" class="btn btn-primary">Save & Continue...</button>
            </div>
        </div>
    </div>

    <hr />
    <div class="setup-content d-none" id="step-2">
        <div class="card">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title mandatory align-items-center d-flex justify-content-center">
                    Sample Size Justification and Statistical Analysis
                </div>
                <div class="col-md-10 pl-0">
                    <label class="ui_label pl-2">
                        Provide sample size justification by clearly stating the statistical assumptions, level of significance and power. If no formal sample size calculation was done, provide an explanation why such a calculation was not done. Provide a brief description of the statistical hypothesis and methods for data analysis, focusing on the analysis of the primary objective if available.
                    </label>
                    <textarea rows="4" class="k-textbox wid_99" id="ui_txt_sampleSizeJustification" maxlength="4000"></textarea>
                    <span id="ui_txt_sampleSizeJustification_span" class="float-right generic_text_small count">4000 Characters left to enter</span>
                </div>
            </div>
        </div>

        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title mandatory align-items-center d-flex justify-content-center">
                    Clinical Pharmacology
                </div>
                <div class="col-md-10 pl-0">
                    <label class="ui_label pl-2">
                        Indicate PK or drug-level assessments to be made, if applicable
                    </label>
                    <textarea rows="4" class="k-textbox wid_99" id="ui_txt_clinicalPharmacology" maxlength="4000"></textarea>
                    <span id="ui_txt_clinicalPharmacology_span" class="float-right generic_text_small count">4000 Characters left to enter</span>
                </div>
            </div>
        </div>

        @if (@ViewBag.pITaskStatus?.ToUpper() == @ConstDefaultValue.SUBMITPROTOCOL.ToUpper() || (@ViewBag.TaskName?.ToUpper() == @ConstDefaultValue.RESUBMITPROTOCOL.ToUpper()))
        {
            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center submitprotocol d-flex justify-content-center">
                        Investigational Site Protocol Number
                    </div>
                    <div class="col-md-10 pl-0">
                        <label class="ui_label pl-2">
                            For example, your institution protocol number, a COOP group number, etc.
                        </label>
                        <textarea rows="4" class="k-textbox wid_99" id="ui_txt_submitprotocol" maxlength="300"></textarea>
                        <span id="ui_txt_submitprotocol_span" class="float-right generic_text_small count">300 Characters left to enter</span>
                    </div>
                </div>
            </div>

        }

        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Correlative Science Studies
                </div>
                <div class="col-md-10">
                    <div class="row">
                        <div class="col-md-12 pl-0" id="correlativeScience">
                            <label class="mandatory ui_label pl-2">
                                Will this study include Correlative Science?
                            </label>
                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_correlativeScience")
                            .OptionLabel("Select")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .BindTo(new List<SelectListItem>
                                () {
                                new SelectListItem() {
                                Text = @ConstDefaultValue.YES,
                                Value = @ConstDefaultValue.YES
                                },
                                new SelectListItem() {
                                Text =  @ConstDefaultValue.NO,
                                Value = @ConstDefaultValue.NO
                                },
                                })
                                .Events(e =>
                                {
                                e.Select("onChangeOfCorrelativeScience");
                                })
                            )
                        </div>
                        <div id="ifCorrelativeScienceYes" class="wid_100">
                            <div class="col-md-12 pl-0">
                                <label class="form-check-inline mandatory ui_label pl-2">
                                    Biomarker / Correlative Science Studies performed at Study Site(s)
                                </label>
                                <textarea rows="4" class="k-textbox wid_99" id="ui_txt_correlativescienceAtStudySite" maxlength="4000"></textarea>
                                <span id="ui_txt_correlativescienceAtStudySite_span" class="float-right generic_text_small count">4000 Characters left to enter</span>
                            </div>
                            <div class="col-md-12 pl-0">
                                <label class="form-check-inline mandatory ui_label pl-2">
                                    Biomarker / Correlative Science Studies performed at Company Site
                                </label>
                                <textarea rows="4" class="k-textbox wid_99" id="ui_txt_correlativescienceAtCompanySite" maxlength="4000"></textarea>
                                <span id="ui_txt_correlativescienceAtCompanySite_span" class="float-right generic_text_small count">4000 Characters left to enter</span>
                            </div>
                            <div class="col-md-12 pl-0">
                                <label class="form-check-inline mandatory ui_label pl-2">
                                    Biomarker / Correlative Science Sampling Details
                                </label>
                                <textarea rows="4" class="k-textbox wid_99" id="ui_txt_correlativeScienceSamplingDet" maxlength="4000"></textarea>
                                <span id="ui_txt_correlativeScienceSamplingDet_span" class="float-right generic_text_small count">4000 Characters left to enter</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Planned Trial Milestone Dates and Enrollment
                </div>
                <div class="col-md-10">
                    <div class="row">
                        <div class="col-md-12 pl-0">
                            <div class="panel pl-md-2">
                                <div class="panel-body ui_panel backgnd_color">Monthy & Year must be entered for each item.</div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="row" id="trialStart">

                                        <div class="col-md-6">
                                            <label for="ui_lbldateFirstpatientfirstvisit" class="text-right mandatory ui_label">Trial Start (First Patient First Visit)</label>
                                        </div>
                                        <div class="col-md-6">
                                            @(Html.Kendo().DatePicker()
                                            .Name("ui_dt_trialStart")
                                            .Start(CalendarView.Year)
                                            .Depth(CalendarView.Year)
                                            .Format("MMM yyyy")
                                            .Value(CalendarView.Month.ToString())
                                            .DateInput()
                                            .HtmlAttributes(new { @class = "wid_100", title = "monthpicker" })
                                            )
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row" id="recruitmentEnd">
                                        <div class="col-md-6">
                                            <label for="ui_lbldateLastpatientfirstvisit" class="mandatory ui_label text-right ">Recruitment End (Last Patient First Visit)</label>
                                        </div>
                                        <div class="col-md-6">
                                            @(Html.Kendo().DatePicker()
                                            .Name("ui_dt_recruitmentEnd")
                                            .Start(CalendarView.Year)
                                            .Depth(CalendarView.Year)
                                            .Format("MMM yyyy")
                                            .Value(CalendarView.Month.ToString())
                                            .DateInput()
                                            .HtmlAttributes(new { @class = "wid_100", title = "monthpicker" })
                                            )
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row" id="trialEnd">
                                <div class="col-md-3 text-right">
                                    <label for="ui_lastPatientLastVisit" class="mandatory ui_label">Trial End(Last Patient Last Visit) </label>
                                </div>
                                <div class="col-md-3">
                                    @(Html.Kendo().DatePicker()
                                    .Name("ui_dt_trialEnd")
                                    .Start(CalendarView.Year)
                                    .Depth(CalendarView.Year)
                                    .Format("MMM yyyy")
                                    .Value(CalendarView.Month.ToString())
                                    .DateInput()
                                    .HtmlAttributes(new { @class = "wid_100", title = "monthpicker" })
                                    )
                                </div>
                            </div>

                            <div class="row mt-md-2">
                                <div class="col-md-6">
                                    <div class="row" id="completionOfTrialReport">
                                        <div class="col-md-6">
                                            <label for="ui_lblCompletionofTrialReport" class="mandatory ui_label float-right">Completion of Trial Report</label>
                                        </div>
                                        <div class="col-md-6">
                                            @(Html.Kendo().DatePicker()
                                            .Name("ui_dt_completionOfTrialReport")
                                            .Start(CalendarView.Year)
                                            .Depth(CalendarView.Year)
                                            .Format("MMM yyyy")
                                            .Value(CalendarView.Month.ToString())
                                            .DateInput()
                                            .HtmlAttributes(new { @class = "wid_100", title = "monthpicker" })
                                            )
                                        </div>
                                        <div class="alert-warning float-left mt-1 ml-4 col-md-11">
                                            <span class="alert-warning ui_label">
                                                <img src="/Images/AlertOutlineIcon.jpg">(Final Trial Report to be sent to @ConfigValues.appName no later than 12 months after Last Patient Last Visit. [6 months  for pediatric trials]).
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row" id="primaryPublication">
                                        <div class="col-md-6">
                                            <label for="ui_lblPrimaryPublicationDate" class="mandatory ui_label float-right">Primary Publication Date</label>
                                        </div>
                                        <div class="col-md-6">
                                            @(Html.Kendo().DatePicker()
                                            .Name("ui_dt_primaryPublication")
                                            .Start(CalendarView.Year)
                                            .Depth(CalendarView.Year)
                                            .Format("MMM yyyy")
                                            .Value(CalendarView.Month.ToString())
                                            .DateInput()
                                            .HtmlAttributes(new { @class = "wid_100", title = "monthpicker" })
                                            )
                                        </div>
                                        <div class="alert-warning float-left mt-1 ml-4 col-md-11">
                                            <span class="alert-warning ui_label">
                                                <img src="~/Images/AlertOutlineIcon.jpg" />
                                                (Publication to be sent to @ConfigValues.appName no later than 24 months after Last Patient Last Visit).
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row pt-md-3">
                                <div class="col-md-6">
                                    <div class="row" id="noOfPatients">
                                        <div class="col-md-6">
                                            <label for="ui_lblCompletionofTrialReport" class="float-right mandatory ui_label">Total Planned Number of Patients</label>
                                        </div>
                                        <div class="col-md-6">
                                            <input type="number" id="ui_num_noOfPatients" min="1" max="9999" data-bind="value:ui_num_noOfPatients" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row" id="plannedNoOfCenters">
                                        <div class="col-md-6">
                                            <label for="ui_lblCompletionofTrialReport" class="text-right mandatory ui_label">Planned Number of Centers</label>
                                        </div>
                                        <div class="col-md-6">
                                            <input type="number" id="ui_num_plannedNoOfCenters" min="1" max="1000" data-bind="value:ui_num_plannedNoOfCenters" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row ">
                            </div>
                            <div class="row">
                                <div class="col-md-12 pl-4">
                                    @(Html.Kendo().Grid<Anju.Navigate.Data.Center>
                                        ()
                                        .Name("ui_dtg_Center")
                                        .Columns(columns =>
                                        {
                                        columns.Bound(c => c.CenterId).Hidden(true);
                                        columns.Bound(c => c.Institution).Width("90%").Title("Center Institution");
                                        columns.Command(command => command.Custom("Delete").Text("Delete").Click("deleteCenter")).Width("10%");
                                        })
                                        .ToolBar(tools =>
                                        {
                                            tools.Create();
                                            tools.Save();
                                        })
                                        .HtmlAttributes(new { style = "height: 200px;" })
                                        .Scrollable()
                                        .Groupable(false)
                                        .Sortable()
                                        .Events(events => events.Edit("OnsaveChanges"))
                                        .Editable(editable => editable.Mode(GridEditMode.InCell).DisplayDeleteConfirmation(false))
                                        .Pageable(pageable => pageable
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                                        .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Model(model => model.Id(p => p.CenterId))
                                        .Create(update => update.Action("CreateUpdateCenter", "NewStudy", new { Mode = "Create" }))
                                        .Update(update => update.Action("CreateUpdateCenter", "NewStudy", new { Mode = "Update" }))
                                        .Read(read => read.Action("GetCenter", "NewStudy"))
                                        .Destroy(update => update.Action("DeleteCenter", "NewStudy"))
                                        )
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Enrollment History for Other Related Studies
                </div>
                <div class="col-md-10 pl-0">
                    <textarea rows="4" class="k-textbox wid_99" id="ui_txt_enrollmentHistory" maxlength="300"></textarea>
                    <span id="ui_txt_enrollmentHistory_span" class="generic_text_small float-right count">300 Characters left to enter</span>
                </div>
            </div>
        </div>

        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Competing Studies.
                </div>
                <div class="col-md-10">
                    <div class="row">
                        <div class="col-md-12" id="competingStudies">
                            <div class="row">
                                <div class="col-md-4 mandatory pl-2 ui_label">
                                    Are there competing studies at your institution?
                                </div>
                                <div class="col-md-3">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_competingStudies")
                                    .HtmlAttributes(new { @class = "wid_100" })
                                    .OptionLabel("Select")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .BindTo(new List<SelectListItem>
                                        () {
                                        new SelectListItem() {
                                        Text = @ConstDefaultValue.YES,
                                        Value = @ConstDefaultValue.YES
                                        },
                                        new SelectListItem() {
                                        Text = @ConstDefaultValue.NO,
                                        Value = @ConstDefaultValue.NO
                                        },
                                        })
                                        .Events(e =>
                                        {
                                        e.Select("onChangeOfCompetingStudies");
                                        })
                                    )
                                </div>
                                <div class="col-md-5 label_description">
                                    (Respond "Yes", if there are protocols that would compete with patient accrual)
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 pl-0" id="impactPatientAcrual">
                            <label class="mandatory ui_label pl-2">
                                How will these studies impact patient accrual for the proposed study?
                            </label>
                            <textarea rows="4" class="k-textbox wid_99" id="ui_txt_impactPatientAccrual" maxlength="300"></textarea>
                            <span id="ui_txt_impactPatientAccrual_span" class="generic_text_small float-right count">300 Characters left to enter</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    IND Submission
                </div>
                <div class="col-md-10 pl-0">
                    <div class="row pl-3" id="proposedStudyIND">
                        <div class="col-md-4 mandatory pl-2 ui_label">
                            Do you plan to submit an IND for the proposed study?
                        </div>
                        <div class="col-md-3">
                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_proposedStudyIND")
                            .HtmlAttributes(new { @class = "wid_100" })
                            .OptionLabel("Select")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .BindTo(new List<SelectListItem>
                                () {
                                new SelectListItem() {
                                Text = @ConstDefaultValue.YES,
                                Value = @ConstDefaultValue.YES
                                },
                                new SelectListItem() {
                                Text = @ConstDefaultValue.NO,
                                Value = @ConstDefaultValue.NO
                                },
                                })
                                .Events(e =>
                                {
                                e.Select("onChangeOfINDProposedStudy");
                                })
                            )
                        </div>
                        <div class="col-md-5 label_description">
                            (If No, You will be required to provide your rationale for IND Exemption by addressing each of the five (5) criteria detailed in FDA guidance)
                        </div>
                        <div class="col-md-12 pl-0" id="rationaleINDExemption">
                            <label class="mandatory ui_label pl-2">
                                Rationale for IND Exemption
                            </label>
                            <textarea rows="4" class="k-textbox wid_99" id="ui_txt_rationaleForINDExemption" maxlength="1000"></textarea>
                            <span id="ui_txt_rationaleForINDExemption_span" class="generic_text_small float-right count">1000 Characters left to enter</span>
                        </div>
                    </div>
                    <div class="row pl-3">
                        <label class="form-check-inline ui_link pl-2">
                            <a href="#" target="_blank" id="fdaGuidanceLink">FDA guidance for IND Exemption 21CFR 312.2 (b)(1)(i)-(v).</a>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
        {
            <div class="card mt-md-2">
                <div class="row pl-md-3">
                    <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                        IRB Registration Requirement
                    </div>
                    <div class="col-md-10">
                        <div class="row">
                            <div class="col-md-12 pl-2" id="registrationIRB">
                                <div class="col-md-9 mandatory ui_label pl-0 float-left">
                                    Has the institutional IRB been registered into the internet-based registration system maintained by the US Department of Health and Human Services?
                                </div>
                                <div class="col-md-3 float-left">
                                    @(Html.Kendo().DropDownList()
                                    .Name("ui_ddl_registrationIRB")
                                    .OptionLabel("Select")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .BindTo(new List<SelectListItem>
                                        () {
                                        new SelectListItem() {
                                        Text = @ConstDefaultValue.YES,
                                        Value = @ConstDefaultValue.YES
                                        },
                                        new SelectListItem() {
                                        Text = @ConstDefaultValue.NO,
                                        Value = @ConstDefaultValue.NO
                                        },
                                        })
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row pl-2 ui_label mt-md-2">
                            IRBs that are not registered must submit an initial registration electronically through http://ohrp.cit.nih.gov/efile or in writing to the Good Clinical Practice Program (HF-34), Office of Science and Health Coordination, Food and Drug Administration, 5600 Fishers Lane, Rockville, MD 20857.
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title align-items-center d-flex justify-content-center">
                    Pharmacovigilance Requirements
                </div>
                <div class="col-md-10">
                    <div class="row">
                        <div class="col-md-12 ui_label pl-2">
                            The minimum requirements for Adverse Event (AE) collection are presented below. Please identify the type of trial you are proposing and note the @ConfigValues.appName requirements for what adverse event data must be collected during the course of the trial. You may only select one (from the drop down menu). If your proposal is approved, these requirements must be reflected fully in the protocol.
                        </div>
                    </div>
                    <div class="row">
                        @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
                        {
                            <div class="col-md-4 ui_label pl-2">
                                Interventional Trial
                            </div>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_interventionalTrial")
                                .OptionLabel("Select")
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .HtmlAttributes(new { @class = "wid_50" })
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues",
                                "NewStudy",
                                new { type = @ConstDefaultValue.DATACOLLECTIONINTERVENTIONAL });
                                })
                                .ServerFiltering(true);
                                })
                                .Events(e =>
                                {
                                e.Select("onChangeOfInterventionalTrial");
                                })
                                )
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4 ui_label pl-2">
                                Non-Interventional Trial
                            </div>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_interventionalTrial")
                                .OptionLabel("Select")
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .HtmlAttributes(new { @class = "wid_90" })
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues",
                                "NewStudy",
                                new { type = @ConstDefaultValue.DATACOLLECTIONNONINTERVENTIONAL });
                                })
                                .ServerFiltering(true);
                                })
                                .Events(e =>
                                {
                                e.Select("onChangeOfInterventionalTrial");
                                })
                                )
                            </div>
                        }
                    </div>
                    <div id="InvolvingPRIMARYDATACOLLECTIONWITHOUT" class="row pl-0">
                        <div id="ForPRIMARYDATACOLLECTIONWITH" class="ui_label  pl-2">
                            Data must be collected as required to meet the objective of the study and in line with any local regulations, which may result in AE/SAEs associated with a @ConfigValues.appName product being identified
                        </div>
                        <div id="basedOnSecondaryUseofdata" class="ui_label  pl-2">
                            Data must be collected as required to meet the objective of the study and in line with any local regulations (as the study uses secondary data, @ConfigValues.appName does not require specific adverse event collection).
                        </div>
                        <div class="col-md-12 pl-0">
                            <label class="ui_label pl-2">
                                Specify what safety data (if any) will be collected:
                            </label>
                            <textarea rows="4" class="k-textbox wid_99" id="ui_txt_Specifywhatsafetydata" maxlength="4000"></textarea>
                            <span id="ui_txt_Specifywhatsafetydata_span" class="float-right generic_text_small count">4000 Characters left to enter</span>
                        </div>
                    </div>
                    <div id="withACompanyDrug" class="row pl-0">
                        <div class="ui_label  pl-2">
                            Must be collected:
                            <ul>
                                <li>All Serious Adverse Events (SAE)</li>
                                <li>All reports of drug exposure during pregnancy</li>
                                @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
                                {
                                    <li>All non-serious Adverse Events (AE)</li>
                                    <li>All reports of misuse and abuse of the @ConfigValues.appName drug, other medication errors and uses outside of what is foreseen in the protocol (irrespective if a clinical event has occurred)</li>
                                }
                                @if (ViewBag.StudyType != @ConstDefaultValue.INTERVENTIONAL)
                                {
                                    <li>All reports of misuse and abuse of the @ConfigValues.appName product</li>
                                }
                            </ul>
                        </div>
                        @if (ViewBag.StudyType != @ConstDefaultValue.INTERVENTIONAL)
                        {
                            <div class="col-md-12 ui_label pl-2">
                                The collection of individual non-serious AEs and reports describing other "special scenarios" * is preferable and recommended but not mandatory provided that local regulations are met
                            </div>
                            <div class="col-md-12 ui_label pl-2">
                                Please check all data that will be collected in addition to the above:
                                (select all that apply)
                            </div>
                            <div class="col-md-12 ui_label pl-2">
                                <div class="custom-control custom-checkbox custom-control-inline col-md-3 pl-5 text-left">
                                    <input type="checkbox" class="custom-control-input" id="ui_chkbox_allnonseriousAEs">
                                    <label class="custom-control-label ui_label" for="ui_chkbox_allnonseriousAEs">All non-serious AEs</label>
                                </div>
                                <div class="custom-control custom-checkbox custom-control-inline col-md-6 pl-5 text-left">
                                    <input type="checkbox" class="custom-control-input" id="ui_chkbox_allreportsdescribingtheoccurrenceofotherspecialscenarios">
                                    <label class="custom-control-label ui_label" for="ui_chkbox_allreportsdescribingtheoccurrenceofotherspecialscenarios">All reports describing the occurrence of other "special scenarios" *</label>
                                </div>
                            </div>
                            <div class="col-md-12 ui_label pl-2">
                                * The special scenarios include reports of drug-drug / drug-food interaction, drug use during lactation or breast-feeding, lack of effectiveness, overdose, drug maladministration or accidental exposure, dispensing errors / medication errors, withdrawal or rebound symptoms, irrespective of whether a clinical event has occurred.
                            </div>
                        }
                    </div>
                    @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
                    {
                        <div id="withNOCompanyDrug" class="row pl-0">
                            <div class="ui_label pl-2">
                                Must be collected:
                                <ul>
                                    <li>All Serious Adverse Events* (SAE)</li>
                                    <li>All non-serious Adverse Events (AE)</li>
                                </ul>
                                * Relationship between the AE/SAE and the trial conduct would be expected to be collected rather than relationship to trial drug.
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-12 pl-0">
                            <label class="ui_label pl-2">
                                Adverse Events Exempt from Collection
                            </label>
                            @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
                            {
                                <div class="label_description pl-2">(If there are any SAEs or AEs that are proposed to be exempted from collection, please detail these here)</div>
                            }
                            else
                            {
                                <div class="label_description pl-2">(For non-interventional studies involving primary data collection WITH a @ConfigValues.appName product of focus, if there are any SAEs or AEs that are proposed to be exempted from collection, please detail these here)</div>
                            }
                            <textarea rows="4" class="k-textbox wid_99" id="ui_txt_adverseEvents" maxlength="4000"></textarea>
                            <span id="ui_txt_adverseEvents_span" class="float-right generic_text_small count">4000 Characters left to enter</span>
                        </div>
                    </div>

                    <div class="row pl-0 pt-md-3">
                        @if (ViewBag.StudyType == @ConstDefaultValue.INTERVENTIONAL)
                        {
                            <div class="col-md-12 pl-2 ui_label">
                                The requirements for the transfer to @ConfigValues.appName of adverse event data collected from the trial, including timeframes, are defined in the IIT Agreement. For trials involving patients treated with a @ConfigValues.appName drug, the @ConfigValues.appName safety requirements include:
                                <ul>
                                    <li>Provision of the randomization codes (for blinded trials) to @ConfigValues.appName</li>
                                    <li>Transfer to @ConfigValues.appName in an ongoing manner of reports of SAEs, drug misuse or abuse, reports of drug exposure during pregnancy, any other information that may suggest a change in the benefit-risk profile for the @ConfigValues.appName drug, and where required, copies of Investigator Notifications for suspected unexpected serious adverse events (SUSAR) and copies of the Development Safety Update Report</li>
                                    <li>Performing an adverse event reconciliation between the Sponsors trial database and an output from the @ConfigValues.appName safety database periodically throughout the trial.</li>
                                </ul>
                                Once the study concept is approved and the IIT agreement is executed, please refer to the IIT agreement for exact requirements for the type of trial you are proposing.
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12 pl-2 ui_label">The requirements for the transfer of collected adverse event data to @ConfigValues.appName, including timeframes, are defined in the IIT Agreement. For non-interventional study involving primary data collection and with a @ConfigValues.appName product of focus, they include the transfer to @ConfigValues.appName in an ongoing manner of reports of SAEs, drug exposure during pregnancy, drug misuse or abuse and, where required, non-serious adverse drug reactions and any other information that may suggest a change in the benefit-risk profile for the @ConfigValues.appName drug. In addition, AE reconciliation between the Sponsor's trial database and an output from the @ConfigValues.appName safety database will be required to be performed periodically throughout the trial. Once the study concept is approved and the IIT agreement is executed, please refer to the IIT agreement for exact requirements for the type of trial you are proposing.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card mt-md-2">
            <div class="row pl-md-3">
                <div class="col-md-2 editer-title mandatory align-items-center d-flex justify-content-center">
                    Key References
                </div>
                <div class="col-md-10 pl-0">
                    <label class="ui_label pl-2">
                        Please list all key references here.
                    </label>
                    <textarea rows="4" class="k-textbox wid_99" id="ui_txt_keyReferences" maxlength="8000"></textarea>
                    <span id="ui_txt_keyReferences_span" class="generic_text_small float-right count">8000 Characters left to enter</span>
                </div>
            </div>
        </div>

    </div>
    <div class="card p-md-2 mt-md-2">
        <div class="row ">
            <div class="col-md-8 border-right">
                <div class="btn-group">
                    <button class="btn btn-primary ml-md-4" id="ui_btnPreviousSectionEnd" type="submit">Previous Section</button>
                </div>
                <div class="btn-group float-right">
                    <button type="button" class="btn btn-primary" onclick="deleteNewStudyDialog();" id="deleteBtnEnd">Delete Current Submission</button>
                </div>
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-primary" onclick="showDialog();">Cancel</button>
                <button type="button" id="ui_btnSaveandExitEnd" class="btn btn-primary">Save & Exit</button>
                <button type="button" id="ui_btnSaveandContinueEnd" class="btn btn-primary">Save & Continue...</button>
            </div>
        </div>
    </div>
    <div>
        <partial name="~/Views/Common/CancelNewStudy.cshtml" />
        <partial name="~/Views/Common/DeleteNewStudy.cshtml" />
        <partial name="~/Views/Common/DeleteRecordDialogBox.cshtml" />
    </div>
</form>
<script>
    var appName = '@ConfigValues.appName';
    var fdaLink = "@ConstDefaultValue.FDALINK";
    var RESUBMITPROPOSAL="@Messages.RESUBMITPROPOSAL";
    var RESUBMITPROTOCOL ="@ConstDefaultValue.RESUBMITPROTOCOL";
    var SUBMITPROTOCOL="@ConstDefaultValue.SUBMITPROTOCOL";
    var DELETEMESSAGETITLEBOX="@Messages.DELETEMESSAGETITLEBOX";
</script>
<script src="~/scripts/ScientificRationaleII.js"></script>
<script src="~/scripts/Common/Common.js"></script>