@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Anju.Navigate.Utilities;
@using Kendo.Mvc.UI
@{
    Layout = "~/Views/Shared/_Site.cshtml";
}
<link rel="stylesheet" href="~/css/navigateStyles.css" />

<div id="formdetails">
    <form id="ui_frmRegister">
        <div class="row">
            <span id="popupNotification"></span>
            <div class="col-md-3">
                <div class="card position-fixed m-md-2">
                    <div class="card-header">
                        <img src="~/Images/NewUser.jpg" class="pull-left mr-2" />
                        <strong>Create New User Account</strong>
                    </div>
                    <div class="card-body">
                        <ul class="stepper">
                            <li class="stepper-item">
                                <img class="register_img" id="personalDetails" src="~/Images/PersonalDetails.jpg" />
                                <div class="ui_label">Personal Details</div>
                            </li>
                            <li class="stepper-item ">
                                <img class="register_img" id="companyDetails" src="~/Images/CompanyDetails.jpg" />
                                <div class="ui_label">Company Details</div>
                            </li>
                            <li class="stepper-item">
                                <img class="register_img" id="loginCredentials" src="~/Images/LoginCredentials.jpg" />
                                <div class="ui_label">Login Credentials</div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="card">
                    <p class="text-info">
                        Please enter contact information as requested below for the person who will serve as the PRIMARY contact for this request.
                    </p>
                    <p class="text-info">
                        Any information you provide here will be used only for the purpose of evaluating your submission & to authenticate your identity.
                    </p>
                </div>
                <br />
                <div>
                    <p class="text-danger">All fields marked * are required.</p>
                </div>

                <div class="card">
                    <div class="card-header">
                        <img src="~/Images/PersonalDetails.jpg" class="pull-left mr-2" />
                        <strong>Personal Details</strong>
                    </div>
                    <div class="card-body">
                        <div class="form-group row" id="salutation">
                            <label class="col-form-label mandatory">Salutation</label>
                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_salutation")
                            .HtmlAttributes(new { @class = "wid_40 " })
                            .DataTextField("Code")
                            .DataValueField("Code")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                            source.Read(read =>
                            {
                            read.Action("GetSysCodeValues", "Register", new { type = @ConstDefaultValue.SALUTATION });
                            })
                            .ServerFiltering(true);
                            })
                            )
                        </div>

                        <div class="form-group row" id="firstName">
                            <label class="col-form-label mandatory">First Name</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_firstName")
                            .HtmlAttributes(new { maxlength = 255, @class = "wid_40" })
                            )
                        </div>

                        <div class="form-group row" id="lastName">
                            <label class="col-form-label mandatory">Last Name</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_lastName")
                            .HtmlAttributes(new { maxlength = 255, @class = "wid_40" })
                            )
                        </div>

                        <div class="form-group row">
                            <label class="col-form-label">Suffix</label>
                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_suffix")
                            .HtmlAttributes(new { @class = "wid_40" })
                            .DataTextField("Code")
                            .DataValueField("Code")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                            source.Read(read =>
                            {
                            read.Action("GetSysCodeValues", "Register", new { type = @ConstDefaultValue.SUFFIX });
                            })
                            .ServerFiltering(true);
                            })
                            )
                        </div>

                        <div class="form-group row">
                            <label class="col-form-label">Title</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_title")
                            .HtmlAttributes(new { maxlength = 255, @class = "wid_40" })
                            )
                        </div>

                        <div class="form-group row" id="multiselectCredentials">
                            <label class="col-form-label mandatory">Credentials</label>
                            <select id="ui_multiselect_credentials" name="ui_multiselect_credentials" class="wid_40"></select>
                        </div>

                    </div>
                </div>

                <div class="card mt-md-2">
                    <div class="card-header">
                        <img class="pull-left mr-2" src="~/Images/CompanyDetails.jpg" />
                        <strong>Company Details</strong>
                    </div>
                    <div class="card-body">
                        <div class="form-group row" id="organizationName">
                            <label class="col-form-label mandatory">Organization Name</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_organizationName")
                            .HtmlAttributes(new { maxlength = 255, @class = "wid_40" })
                            )
                        </div>

                        <div class="form-group row" id="department">
                            <label class="col-form-label mandatory">Department</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_department")
                            .HtmlAttributes(new { maxlength = 255, @class = "wid_40" })
                            )
                        </div>

                        <div class="form-group row" id="addressLine1">
                            <label class="col-form-label mandatory">Address Line 1</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_addressLine1")
                            .HtmlAttributes(new { maxlength = 255, @class = "wid_60" })
                            )
                        </div>

                        <div class="form-group row">
                            <label class="col-form-label">Address Line 2</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_addressLine2")
                            .HtmlAttributes(new { maxlength = 255, @class = "wid_60" })
                            )
                        </div>

                        <div class="form-group row" id="country">
                            <label class="col-form-label mandatory">Country</label>
                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_country")
                            .HtmlAttributes(new { @class = "wid_40" })
                            .DataTextField("Code")
                            .DataValueField("CountryId")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                            source.Read(read =>
                            {
                            read.Action("GetCountries", "Register");
                            })
                            .ServerFiltering(true);
                            })
                            )
                        </div>

                        <div class="form-group row" id="state">
                            <label class="col-form-label mandatory">State/Region</label>
                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_state")
                            .HtmlAttributes(new { @class = "wid_40" })
                            .DataTextField("Code")
                            .DataValueField("StateId")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                            source.Read(read =>
                            {
                            read.Action("GetStatesByCountryID", "Register").Data("filterStates");
                            })
                            .ServerFiltering(true);
                            })
                            .Enable(false)
                            .AutoBind(false)
                            .CascadeFrom("ui_ddl_country")
                            )
                        </div>

                        <div class="form-group row" id="city">
                            <label class="col-form-label mandatory">City</label>
                            @(Html.Kendo().DropDownList()
                            .Name("ui_ddl_city")
                            .HtmlAttributes(new { @class = "wid_40" })
                            .DataTextField("Name")
                            .DataValueField("CityId")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                            source.Read(read =>
                            {
                            read.Action("GetCitiesByStateID", "Register").Data("filterCities");
                            })
                            .ServerFiltering(true);
                            })
                            .Enable(false)
                            .AutoBind(false)
                            .CascadeFrom("ui_ddl_state")
                            )
                        </div>

                        <div class="form-group row" id="zipPostalCode">
                            <label class="col-form-label mandatory">Zip/Postal Code</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_zip")
                            .HtmlAttributes(new { maxlength = 15, @class = "wid_20" })
                            )
                        </div>

                        <div class="form-group row" id="phone">
                            <label class="col-form-label mandatory">Phone</label>
                            @(Html.Kendo().MaskedTextBox()
                            .Name("ui_txt_phone")
                            .Mask("(999) 999-9999")
                            .HtmlAttributes(new { maxlength = 60 })
                            )
                        </div>
                        <div class="form-group row">
                            <label class="col-form-label">Fax</label>
                            @(Html.Kendo().TextBox()
                            .Name("ui_txt_fax")
                            .HtmlAttributes(new { maxlength = 60, @class = "wid_40 " })
                            )
                        </div>
                    </div>
                </div>

                <div class="card mt-md-2">
                    <div class="card-header">
                        <img class="pull-left mr-2" src="~/Images/LoginCredentials.jpg" />
                        <strong>Login Credentials</strong>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-7">
                                <div class="form-group row" id="primaryEmailAddress">
                                    <label class="col-form-label mandatory">Primary Email Address</label>
                                    @(Html.Kendo().TextBox()
                                    .Name("ui_txt_primaryEmailAddress")
                                    .HtmlAttributes(new { maxlength = 60, @class = "wid_65" })
                                    )
                                    <span class="k-icon k-i-check-circle show_hide_email_icon check_circle_icon"></span>
                                </div>
                                <div class="form-group row" id="userName">
                                    <label class="col-form-label mandatory">User Name</label>
                                    @(Html.Kendo().TextBox()
                                    .Name("ui_txt_userName")
                                    .HtmlAttributes(new { maxlength = 255, @class = "wid_65" })
                                    )
                                    <span class="k-icon k-i-check-circle show_hide_icon check_circle_icon"></span>
                                </div>
                                <div class="form-group row" id="password">
                                    <label class="col-form-label mandatory">Password</label>
                                    @(Html.Kendo().TextBox()
                                    .Name("ui_txt_password")
                                    .HtmlAttributes(new { maxlength = 255, @class = "wid_65", type = "password" })
                                    )
                                    <span class="fa fa-eye toggle-password position-relative pt-md-2"></span>
                                </div>
                                <div class="form-group row" id="confirmPassword">
                                    <label class="col-form-label mandatory"> Confirm Password</label>
                                    @(Html.Kendo().TextBox()
                                    .Name("ui_txt_confirmPassword")
                                    .HtmlAttributes(new { maxlength = 255, @class = "wid_65", type = "password" })
                                    )
                                </div>
                            </div>

                            <div class="col-md-5 pt-md-5 mt-md-5">
                                <div class="show_hide_notification">
                                    <div class=" notification pwd_notify">
                                        <p class="pwd_header" id="passwordHeader">  <img src="~/Images/Lock_Icon_1.png" class="wid_12px" /></p>

                                        <div class="pwd_notify_icon" id="passwordLength">
                                            <img id="passwordLengthImg" src="~/Images/Warning.jpg" class="wid_15px" />
                                        </div>
                                        <div class="pwd_notify_icon" id="upperLowerCase">
                                            <img id="upperLowerCaseImg" src="~/Images/Warning.jpg" class="wid_15px" />
                                        </div>

                                        <div class="pwd_notify_icon" id="number">
                                            <img id="numberImg" src="~/Images/Warning.jpg" class="wid_15px" />
                                        </div>
                                        <div class="pwd_notify_icon" id="specialCharacter">
                                            <img id="specialCharacterImg" src="~/Images/Warning.jpg" class="wid_15px" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-md-2">
            <div class="col-md-12 text-right">
                <button class="btn btn-light" id="btnCancel" onclick="showDialog();" type="button">Cancel</button>
                <button class="btn btn-primary" id="btnNext" type="button">Next</button>
            </div>
        </div>

        <div id="YesNoDialog">
            <partial name="~/Views/Common/CancelDialogBox.cshtml" />
        </div>
        <p id="infoMsg" class="infoMsg text_center"></p>
        <p id="errorMsg" class="errorMsg text_center"></p>

    </form>
</div>
<div id="summarydetails">

</div>
<script src="~/scripts/Register.js"></script>
<script src="~/scripts/RegisterSummary.js"></script>
<script src="~/scripts/Common/Common.js"></script>