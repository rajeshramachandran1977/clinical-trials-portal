@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Anju.Navigate.Utilities;
@model Anju.Navigate.Data.ListOfDocuments
@using Kendo.Mvc.UI;
@{
    Layout = "~/Views/Shared/_Site.cshtml";
    ViewData["Title"] = "StudyCloseout";
}
<link rel="stylesheet" href="~/css/navigateStyles.css" />

<div class="p-md-4 shadow-lg newWindowMargin">
    <span id="popupNotification"></span>
    <label class="task_heading m-md-0" id="taskHeading">Initiate Study Closeout</label>
    <hr />

    <div class="uploadDocuments text-center ui_label font-weight-light redColor">
        <div>The information you submit on this website will be used in accordance with our Privacy Policy.</div>
        <div><a class="btn btn-link ui_link">[link]</a></div>
    </div>
    <div class="panel" id="panelForPI">
        <div class="panel-body study_panel ui_panel" id="piPanel"></div>
    </div>
    <div>
        <input type="hidden" id="StudyId" value="@ViewBag.StudyId" />
        <input type="hidden" id="txtUserName" value=@ViewBag.AssignedUsername />
        <input type="hidden" id="LogedinUserName" value=@ViewBag.LogedinUserName />
        <input type="hidden" id="taskName" value="@ViewBag.GMRCTaskName" />
        <input type="hidden" id="StudyNumber" value="@ViewBag.StudyNumber" />
        <input type="hidden" id="TitleofTrial" value="@ViewBag.TitleofTrial" />
        <input type="hidden" id="Institution" value=@ViewBag.Institution />
    </div>
    <div class="pt-3">
        <ul>
            <li class="list_item">@ViewBag.StudyNumber: @ViewBag.TitleofTrial</li>
            <li class="list_item">Submitted By @ViewBag.AssignedUsername: @ViewBag.Institution</li>
            <li class="list_item"><a href="" class="ui_link">Submission Summary</a></li>
            <li class="list_item"><a href='@Url.Action("EditStudy", "NewStudy")' class="ui_link" target="_blank">Study Profile</a></li>
        </ul>
    </div>
    <hr />

    <div class="row pt-2" id="chkbox">
        <label class="mandatory col-md-1 pl-md-4"></label>
        <input type="checkbox" class="custom-control-input" id="resubmissionReason">
        <label class="custom-control-label ui_label pt-md-1" for="resubmissionReason" id="checkboxLabel">Initiate Study closeout</label>
    </div>

    <div id="IRBClosure">
        <div class="row">
            @(Html.Kendo().Grid<Anju.Navigate.Data.Documents>
               ()
               .Name("ui_dtg_FinalStudyDocuments")
               .Columns(columns =>
               {
                   columns.Bound(c => c.DocumentId).Hidden(true);
                   columns.Command(command => command.Custom("Tag").Text("Tag").Click("showDetails")).Width("8%");
                   columns.Bound(c => c.DocumentName).Width("19%").Title("Document Name").ClientTemplate(" <a onclick='Show(this);' href=\\#>#= DocumentName#</a> ");
                   columns.Bound(c => c.DocumentStatus).Width("15%").Title("Document Status");
                   columns.Bound(c => c.DocumentType).Width("15%").Title("Document Type");
                   columns.Bound(c => c.DocumentSubType).Width("15%").Title("Document Sub-Type");
                   columns.Bound(c => c.DocumentVersion).Width("20%").Title("Original / Amendment Version");
                   columns.Bound(c => c.SubModuleName).Hidden(true);
                   columns.Bound(c => c.StudyId).Hidden(true);
                   columns.Bound(c => c.OriginalDate).Hidden(true);
                   columns.Bound(c => c.ExpirationDate).Hidden(true);
                   columns.Bound(c => c.DocumentName).Hidden(true);
                   //columns.Command(command => { command.Destroy(); }).Width("8%");
               })
               .HtmlAttributes(new { style = "height:200px;", @class = "ui_label wid_100" })
               .Scrollable()
               .AutoBind(true)
               .Groupable(false)
               .Sortable()
               .Pageable(pageable => pageable
               .PageSizes(true)
               .ButtonCount(5))
               .DataSource(dataSource => dataSource
               .Ajax()
               .Model(model => model.Id(p => p.DocumentId))
               .Read(read => read.Action("GetDocumentsByStudyID", "NewStudy").Data("additionalInfo"))
               //.Destroy(update => update.Action("DeleteDocuments", "NewStudy"))
               )
            )

            @(Html.Kendo().Window()
            .Name("FinalStudyDetails")
            .Title("Review Document")
            .Visible(false)
            .Modal(true)
            .Draggable(true)
            .Width(800)
            )
        </div>
        <div class="row mt-2" id="ReviewStatus">
            <label class="ui_label col-form-label mandatory">Review Status</label>
            <div class="col-md-4">
                @(Html.Kendo().DropDownList()
                .Name("ui_ddl_reviewStatus")
                .OptionLabel("Select")
                .DataTextField("Code")
                .DataValueField("Code")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.REVIEWDECISION });
                    });
                })
                )
            </div>
        </div>
        <div class="row" id="ReviewComments">
            <label class="ui_label mandatory col-form-label">Review Comments</label>
            <textarea rows="4" class="k-textbox col-md-8 wid_100 ml-md-3" id="ui_txt_reviewComments" maxlength="300"></textarea>
            <span class="generic_text_small col-md-11 ml-md-4 text-right count">300 Characters left to enter</span>
        </div>
    </div>
    <div id="submitIRBClosure">
        <div class="form-group row">
            <label class="col-form-label col-md-4 mandatory">Upload IRB Study Closure Notification</label>
            <div class="col-md-8 mt-md-2">
                <button type="button"><span class="k-icon k-i-plus"></span>Add Document</button>
                <a href="javascript:void(0);" class="ui_link col-md-7">DOWNLOAD</a>
                <button type="button"><span class="k-icon k-i-delete"></span>Remove</button>
            </div>
        </div>
    </div>
    <div id="submitFinalStudyData">
        <div class="form-group row">
            <label class="col-form-label col-md-4 mandatory">Upload Final Study data / Report</label>
            <div class="col-md-8 mt-md-2">
                <button type="button"><span class="k-icon k-i-plus"></span>Add Document</button>
                <a href="javascript:void(0);" class="ui_link col-md-7">DOWNLOAD</a>
                <button type="button"><span class="k-icon k-i-delete"></span>Remove</button>
            </div>
        </div>
    </div>
    <div id="closeStudy">
        <div class="row" id="reasonForClosure">
            <label class="ui_label col-form-label mandatory col-md-4">Reason for Closure</label>
            <div class="col-md-4">
                @(Html.Kendo().DropDownList()
                .Name("ui_ddl_reasonForClosure")
                .OptionLabel("Select")
                .DataTextField("Code")
                .DataValueField("Code")
                .HtmlAttributes(new { @class = "wid_100" })
               .DataSource(source =>
               {
                   source.Read(read =>
                   {
                       read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.CLOSUREREASONS });
                   });
               })
                )
            </div>
        </div>
        <div class="row panel m-0 pb-2">
            <div class="panel-body study_panel ui_panel">
                <p class="m-0">Completed-Must have LPLV date</p>
                <p class="m-0">Cancelled-Never activated</p>
                <p class="m-0">Stopped by @ConfigValues.appName-Study was activated</p>
                <p class="m-0">Stopped by Investigator-Study was activated</p>
            </div>
        </div>

        <div class="row pt-2" id="ClosureCheckbox">
            <label class="mandatory col-md-1 pl-md-4"></label>
            <input type="checkbox" class="custom-control-input" id="studyClosureCheckbox">
            <label class="custom-control-label ui_label pt-md-1" for="studyClosureCheckbox">All required study-closure related activities have been completed.</label>
        </div>
        <div class="form-group row" id="closeStudyLetter">
            <label class="col-form-label col-md-4 mandatory">Upload study closure document</label>
            <div class="col-md-8 mt-md-2">
                <button type="button" data-target="#addCloseStudyModal" data-toggle="modal"><span class="k-icon k-i-plus"></span>Add Document</button>
                <a href="javascript:void(0);" class="ui_link col-md-7" id="closeStudyDownload">DOWNLOAD</a>
                <button type="button" id="btn_RemoveCloseStudyDocument"><span class="k-icon k-i-delete"></span>Remove</button>
            </div>
        </div>
    </div>
    <div id="finalStudyData">
        <div class="form-group row">
            <label class="col-md-3 col-form-label mandatory">Upload Final Study Data / Report</label>
            <div class="col-md-6">
                @(Html.Kendo().Upload()
                .Name("fileFinalStudyData")
                .Files(
                  files =>
                  {
                      foreach (var f in Model.Documents)
                      {
                          files.Add().Name(f.DocumentNameWithOutExtension + f.DocumentExtension).Extension(f.DocumentExtension).Size(f.DocumentSize);
                      }
                  })
                .Multiple(false)
                .Async(a => a
                .Save("SaveAsyncFinalStudyDocument", "StudyCloseout")
                .Remove("RemoveFinalStudyDocument", "StudyCloseout")
                .AutoUpload(false)
                )
                )
            </div>
        </div>
    </div>
    <div class="uploadDocuments">
        <div class="form-group row">
            <div class="col-md-3 mt-md-1">
                <button type="button" id="" data-target="#addDocModal" data-toggle="modal"><span class="k-icon k-i-plus"></span>Add Document</button>
            </div>
        </div>
        <div class="form-group row mt-md-2">
            @(Html.Kendo().Grid<Anju.Navigate.Data.Documents>
                ()
                .Name("ui_dtg_uploadDocumentsGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.DocumentId).Hidden(true);
                    //columns.Command(command => command.Custom("Tag").Text("Tag").Click("showDetails")).Width("8%");
                    //columns.Bound(c => c.DocumentName).Width("19%").Title("Document Name").ClientTemplate(" <a onclick='Show(this);' href=\\#>#= DocumentName#</a> ");
                    columns.Bound(c => c.DocumentStatus).Width("15%").Title("Document Status");
                    columns.Bound(c => c.DocumentType).Width("15%").Title("Document Type");
                    columns.Bound(c => c.DocumentSubType).Width("15%").Title("Document Sub-Type");
                    columns.Bound(c => c.DocumentVersion).Width("20%").Title("Original / Amendment Version");
                    columns.Bound(c => c.SubModuleName).Hidden(true);
                    columns.Bound(c => c.StudyId).Hidden(true);
                    columns.Bound(c => c.OriginalDate).Hidden(true);
                    columns.Bound(c => c.ExpirationDate).Hidden(true);
                    columns.Bound(c => c.DocumentName).Hidden(true);
                   // columns.Command(command => { command.Destroy(); }).Width("8%");
                })
                .HtmlAttributes(new { style = "height:200px", @class = "ui_label wid_100" })
                .Scrollable()
                .AutoBind(false)
                .Groupable(false)
                .Sortable()
                .Pageable(pageable => pageable
                .Refresh(true)
                .PageSizes(true)
                .ButtonCount(5))
                .DataSource(dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.DocumentId))
                //.Read(read => read.Action("GetDocumentsByStudyID", "NewStudy").Data("additionalInfo"))
                .Destroy(update => update.Action("DeleteDocuments", "NewStudy"))
                )
            )
            @(Html.Kendo().Window()
                .Name("Details")
                .Title("Review Document")
                .Visible(false)
                .Modal(true)
                .Draggable(true)
                .Width(800)
            )
        </div>
    </div>
    <div class="row pt-3">
        <div class="col-md-12 text-right">
            <button type="button" class="btn btn-primary" id="ui_btn_submit">Submit</button>
            <button type="button" class="btn btn-primary" id="ui_btn_cancel" onclick="showDialog();">Cancel</button>
        </div>
    </div>
    <div>
        <partial name="~/Views/Common/CancelDialogBox.cshtml" />
    </div>
    <div class="modal fade" id="addDocModal">
        <div class="modal-dialog" id="modal_dialog">
            <div class="modal-content">
                <form method="post" id="">
                    <div class="modal-header modal_header"></div>
                    <div class="modal-body">
                        <div class="row ml-md-2 mr-0" id="uploadAdditionalFiles">
                            @(Html.Kendo().Upload()
                            .Name("uploadfiles")
                            .Multiple(false)
                            .Async(a => a
                            //.Save("", "")
                            //.Remove("", "")
                            .AutoUpload(false)
                            )
                            //.Events(events => events
                            //.Select("")
                            //.Upload("")
                            //.Remove("")

                            //)
                            .HtmlAttributes(new { aria_label = "files" })
                            )
                        </div>
                        <hr />
                        <div class="form-group row" id="documentName">
                            <label class="col-md-4 col-form-label mandatory">Document Name</label>
                            <div class="col-md-8">
                                @(Html.Kendo().TextBox()
                                .Name("ui_txt_documentName")
                                .HtmlAttributes(new { @class = "wid_100" })
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="documentStatus">
                            <label class="col-md-4 col-form-label mandatory">Document Status</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_documentStatus")
                                .HtmlAttributes(new { @class = "wid_60" })
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTSTATUS });
                                })
                                .ServerFiltering(true);
                                })
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="documentType">
                            <label class="col-md-4 col-form-label mandatory">Document Type</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_documentType")
                                .HtmlAttributes(new { @class = "wid_60" }).DataTextField("Code")
                                .DataValueField("CodeId")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTTYPE });
                                })
                                .ServerFiltering(true);
                                })
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="documentSubType">
                            <label class="col-md-4 col-form-label mandatory">Document Sub-Type</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_documentSubType")
                                .HtmlAttributes(new { @class = "wid_60" }).DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                //  read.Action("GetDocumentSubTypeByDocumentTypeID", "TaskWorkFlow").Data("filterDocumentSubType");
                                })
                                .ServerFiltering(true);
                                })
                                .CascadeFrom("ui_ddl_documentType")
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="version">
                            <label class="col-md-4 col-form-label mandatory">Original / Amendment Version</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_version")
                                .HtmlAttributes(new { @class = "wid_60" })
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTVERSION });
                                })
                                .ServerFiltering(true);
                                })
                                )
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-4 col-form-label">Original Date</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DatePicker()
                                .Name("ui_dt_originalDate")
                                .HtmlAttributes(new { })
                                .Format("MMM dd, yyyy")
                                )
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-4 col-form-label">Expiration Date</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DatePicker()
                                .Name("ui_dt_expiryDate")
                                .HtmlAttributes(new { })
                                .Format("MMM dd, yyyy")
                                )
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer p-1">
                        <button type="button" id="ui_btn_documentSubmit" value="Submit" class="btn btn-primary">Submit</button>
                        <input type="button" id="ui_btn_documentCancel" value="Cancel" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade pt-md-5 mt-md-5" id="submitModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header modal_header height_40px backgnd_color">
                    <h4 class="modal-title ui_modal_header pt-md-1">Warning</h4>
                    <a href="javascript:void[0]" class="close pt-md-4" data-dismiss="modal"><img class="window_close" src="~/Images/WindowClose.jpg"></a>
                </div>
                <div class="modal-body ui_modal">
                    <div class="row">
                        <div class="col-md-1"><img src="/Images/AlertOutlineIcon.jpg "></div>
                        <div class="col-md-11">
                            You are about to initiate closeout of a study that may have active tasks and/or workflows. Are you sure you want to initiate closeout of this study and cancel all active tasks and workflow?
                        </div>
                    </div>
                </div>
                <div class="modal-footer p-1">
                    <button type="button" class="btn btn-primary" id="ui_btn_yes">Yes</button>
                    <button type="button" class="btn btn-primary" id="ui_btn_no" data-dismiss="modal">No</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="addCloseStudyModal">
        <div class="modal-dialog" id="modal_dialog">
            <div class="modal-content">
                <form method="post" id="frm_closeStudy">
                    <div class="modal-header modal_header"></div>
                    <div class="modal-body">
                        <div class="row ml-md-2 mr-0" id="closeStudyFiles">
                            @(Html.Kendo().Upload()
                            .Name("uploadCloseStudyFiles")
                            .Multiple(false)
                            .Async(a => a
                            .Save("SavecloseStudyDocuments", "StudyCloseout")
                            .Remove("RemovecloseStudyDocuments", "StudyCloseout")
                            .AutoUpload(false)
                            )
                            .Events(events => events
                            .Select("onSelect")
                            .Upload("onUpload")
                            .Remove("onremove")

                            )
                            .HtmlAttributes(new { aria_label = "files" })
                            )
                        </div>
                        <hr />
                        <div class="form-group row" id="documentNameCloseStudy">
                            <label class="col-md-4 col-form-label mandatory">Document Name</label>
                            <div class="col-md-8">
                                @(Html.Kendo().TextBox()
                                .Name("ui_txt_documentNameCloseStudy")
                                .HtmlAttributes(new { @class = "wid_100" })
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="documentStatusCloseStudy">
                            <label class="col-md-4 col-form-label mandatory">Document Status</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_documentStatusCloseStudy")
                                .HtmlAttributes(new { @class = "wid_60" })
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTSTATUS });
                                })
                                .ServerFiltering(true);
                                })
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="documentTypeCloseStudy">
                            <label class="col-md-4 col-form-label mandatory">Document Type</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_documentTypeCloseStudy")
                                .HtmlAttributes(new { @class = "wid_60" }).DataTextField("Code")
                                .DataValueField("CodeId")
                                .OptionLabel("Select")  
                                .Events(events => events.Change("onDocumentTypeCloseStudyChange"))
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTTYPE });
                                })
                                .ServerFiltering(true);
                                })
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="documentSubTypeCloseStudy">
                            <label class="col-md-4 col-form-label" id="documentSubTypeCloseStudyLabel">Document Sub-Type</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_documentSubTypeCloseStudy")
                                .HtmlAttributes(new { @class = "wid_60" }).DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .Events(events => events.DataBound("onSubTypeDataBound"))
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetDocumentSubTypeByDocumentTypeID", "TaskWorkFlow").Data("filterCloseStudyDocumentSubType");
                                })
                                .ServerFiltering(true);
                                })
                                .CascadeFrom("ui_ddl_documentTypeCloseStudy")
                                )
                            </div>
                        </div>
                        <div class="form-group row" id="versionCloseStudy">
                            <label class="col-md-4 col-form-label mandatory">Original / Amendment Version</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DropDownList()
                                .Name("ui_ddl_versionCloseStudy")
                                .HtmlAttributes(new { @class = "wid_60" })
                                .DataTextField("Code")
                                .DataValueField("Code")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                source.Read(read =>
                                {
                                read.Action("GetSysCodeValues", "NewStudy", new { type = @ConstDefaultValue.DOCUMENTVERSION });
                                })
                                .ServerFiltering(true);
                                })
                                )
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-4 col-form-label">Original Date</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DatePicker()
                                .Name("ui_dt_originalDateCloseStudy")
                                .HtmlAttributes(new { })
                                .Format("MMM dd, yyyy")
                                )
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-4 col-form-label">Expiration Date</label>
                            <div class="col-md-8">
                                @(Html.Kendo().DatePicker()
                                .Name("ui_dt_expiryDateCloseStudy")
                                .HtmlAttributes(new { })
                                .Format("MMM dd, yyyy")
                                )
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer p-1">
                        <button type="button" id="ui_btn_documentCloseStudySubmit" value="Submit" class="btn btn-primary">Submit</button>
                        <input type="button" id="ui_btn_documentCloseStudyCancel" value="Cancel" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
