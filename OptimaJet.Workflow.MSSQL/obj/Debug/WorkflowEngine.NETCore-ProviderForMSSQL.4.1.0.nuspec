        <dependency id="WorkflowEngine.NETCore-Core" version="4.1.0" exclude="Build,Analyzers" />
        <dependency id="System.Data.SqlClient" version="4.8.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
